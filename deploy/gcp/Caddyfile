# YOUR_DOMAIN 을 실제 소유 도메인(예: labpet.example.com)으로 교체하세요.
# Caddy가 Let's Encrypt 자동 TLS 인증서 발급 및 WebSocket(WSS) 업그레이드를 처리합니다.
YOUR_DOMAIN {
    encode zstd gzip

    request_body {
        max_size 64KB
    }

    reverse_proxy 127.0.0.1:5000 {
        flush_interval -1
        transport http {
            read_timeout 60s
            write_timeout 60s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }
}
