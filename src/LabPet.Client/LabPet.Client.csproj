<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LabPet.Client</RootNamespace>
    <AssemblyName>LabPet.Client</AssemblyName>
    <Version>0.3.17</Version>
    <Authors>LabPet</Authors>
    <Product>LabPet</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>LabPet.Client.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- VelopackApp.Build().Run()을 WPF 초기화 전 수동 Program.cs에서 호출하기 위해 ApplicationDefinition 대신 Page로 지정 -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\Models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabPet.Shared\LabPet.Shared.csproj" />
    <InternalsVisibleTo Include="LabPet.Tests" />
  </ItemGroup>

  <!-- 릴리스 CI 등에서 -p:LabPetDefaultServerUrl=... 전달 시 별도 설정 파일 없이 기본 서버 URL을 어셈블리에 포함 -->
  <ItemGroup Condition="'$(LabPetDefaultServerUrl)' != ''">
    <AssemblyMetadata Include="LabPetDefaultServerUrl" Value="$(LabPetDefaultServerUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
