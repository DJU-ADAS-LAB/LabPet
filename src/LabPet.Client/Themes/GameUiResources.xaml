    <Geometry x:Key="IconKeyboardGeometry">M3,7 H21 V17 H3 Z M6,10 H8 M10,10 H12 M14,10 H16 M18,10 H18.5 M7,14 H17</Geometry>
    <Geometry x:Key="IconLadderGeometry">M7,4 V20 M17,4 V20 M7,8 H17 M7,13 H17 M7,17 H17</Geometry>
    <Geometry x:Key="IconUserGeometry">M12,4 A3.5,3.5 0 1 1 11.99,4 Z M5.5,20 C5.5,16 8.3,14 12,14 C15.7,14 18.5,16 18.5,20</Geometry>
    <Geometry x:Key="IconUsersGeometry">M9,5 A3,3 0 1 1 8.99,5 Z M3.5,19 C3.5,15.8 6,14 9,14 C12,14 14.5,15.8 14.5,19 M16,6.5 A2.5,2.5 0 1 1 15.99,6.5 Z M15,14 C18,14 20.5,15.7 20.5,18.8</Geometry>
