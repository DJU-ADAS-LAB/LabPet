    <Geometry x:Key="IconCoinGeometry">M12,3 A9,9 0 1 1 11.99,3 Z M12,7 V17 M9.5,9.5 H14.5 M9.5,14.5 H14.5</Geometry>
    <Geometry x:Key="IconCardsGeometry">M5,6 H15 V19 H5 Z M9,4 H19 V17 H16</Geometry>
