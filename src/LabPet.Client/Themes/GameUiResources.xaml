    <Geometry x:Key="IconMinimizeGeometry">M6,12 L18,12</Geometry>
    <Geometry x:Key="IconMaximizeGeometry">M6,6 H18 V18 H6 Z</Geometry>
    <Geometry x:Key="IconCheckGeometry">M5,12.5 L9.5,17 L19,7.5</Geometry>
