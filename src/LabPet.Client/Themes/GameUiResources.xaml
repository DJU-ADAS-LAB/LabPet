<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 게임 UI 공용 디자인 토큰 (Apple/Toss 스타일 정돈된 중성 톤 + 절제된 핑크) -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="GameBgColor">#FFF5F6F8</Color>
    <Color x:Key="GameCardColor">#FFFFFFFF</Color>
    <Color x:Key="GameSubtleFillColor">#FFF2F4F6</Color>
    <Color x:Key="GameHoverFillColor">#FFEBEFF5</Color>
    <Color x:Key="GameDividerColor">#FFE8ECF2</Color>
    <Color x:Key="GameTextPrimaryColor">#FF191F28</Color>
    <Color x:Key="GameTextSecondaryColor">#FF4E5968</Color>
    <Color x:Key="GameTextMutedColor">#FF8B95A1</Color>

    <Color x:Key="GamePinkColor">#FFFF4D82</Color>
    <Color x:Key="GamePinkHoverColor">#FFE83B6F</Color>
    <Color x:Key="GamePinkPressedColor">#FFD62E61</Color>
    <Color x:Key="GamePinkSoftColor">#FFFFF0F4</Color>
    <Color x:Key="GamePinkBorderColor">#FFFFC6D7</Color>

    <Color x:Key="GameWinColor">#FF10B981</Color>
    <Color x:Key="GameWinSoftColor">#FFECFDF5</Color>
    <Color x:Key="GameWinBorderColor">#FFA7F3D0</Color>

    <Color x:Key="GameLossColor">#FFEF4444</Color>
    <Color x:Key="GameLossSoftColor">#FFFEF2F2</Color>
    <Color x:Key="GameLossBorderColor">#FFFECACA</Color>

    <Color x:Key="GameCoinColor">#FFD97706</Color>
    <Color x:Key="GameCoinSoftColor">#FFFFFBEB</Color>
    <Color x:Key="GameCoinBorderColor">#FFFDE68A</Color>

    <Color x:Key="GameFreeColor">#FF2563EB</Color>
    <Color x:Key="GameFreeSoftColor">#FFEFF6FF</Color>
    <Color x:Key="GameFreeBorderColor">#FFBFDBFE</Color>

    <SolidColorBrush x:Key="GameBgBrush" Color="{StaticResource GameBgColor}" />
    <SolidColorBrush x:Key="GameCardBrush" Color="{StaticResource GameCardColor}" />
    <SolidColorBrush x:Key="GameSubtleFillBrush" Color="{StaticResource GameSubtleFillColor}" />
    <SolidColorBrush x:Key="GameHoverFillBrush" Color="{StaticResource GameHoverFillColor}" />
    <SolidColorBrush x:Key="GameDividerBrush" Color="{StaticResource GameDividerColor}" />
    <SolidColorBrush x:Key="GameTextPrimaryBrush" Color="{StaticResource GameTextPrimaryColor}" />
    <SolidColorBrush x:Key="GameTextSecondaryBrush" Color="{StaticResource GameTextSecondaryColor}" />
    <SolidColorBrush x:Key="GameTextMutedBrush" Color="{StaticResource GameTextMutedColor}" />

    <SolidColorBrush x:Key="GamePinkBrush" Color="{StaticResource GamePinkColor}" />
    <SolidColorBrush x:Key="GamePinkHoverBrush" Color="{StaticResource GamePinkHoverColor}" />
    <SolidColorBrush x:Key="GamePinkPressedBrush" Color="{StaticResource GamePinkPressedColor}" />
    <SolidColorBrush x:Key="GamePinkSoftBrush" Color="{StaticResource GamePinkSoftColor}" />
    <SolidColorBrush x:Key="GamePinkBorderBrush" Color="{StaticResource GamePinkBorderColor}" />

    <SolidColorBrush x:Key="GameWinBrush" Color="{StaticResource GameWinColor}" />
    <SolidColorBrush x:Key="GameWinSoftBrush" Color="{StaticResource GameWinSoftColor}" />
    <SolidColorBrush x:Key="GameWinBorderBrush" Color="{StaticResource GameWinBorderColor}" />

    <SolidColorBrush x:Key="GameLossBrush" Color="{StaticResource GameLossColor}" />
    <SolidColorBrush x:Key="GameLossSoftBrush" Color="{StaticResource GameLossSoftColor}" />
    <SolidColorBrush x:Key="GameLossBorderBrush" Color="{StaticResource GameLossBorderColor}" />

    <SolidColorBrush x:Key="GameCoinBrush" Color="{StaticResource GameCoinColor}" />
    <SolidColorBrush x:Key="GameCoinSoftBrush" Color="{StaticResource GameCoinSoftColor}" />
    <SolidColorBrush x:Key="GameCoinBorderBrush" Color="{StaticResource GameCoinBorderColor}" />

    <SolidColorBrush x:Key="GameFreeBrush" Color="{StaticResource GameFreeColor}" />
    <SolidColorBrush x:Key="GameFreeSoftBrush" Color="{StaticResource GameFreeSoftColor}" />
    <SolidColorBrush x:Key="GameFreeBorderBrush" Color="{StaticResource GameFreeBorderColor}" />

    <DropShadowEffect x:Key="GameCardShadow"
                      BlurRadius="16"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.06"
                      Color="#FF111827" />

    <DropShadowEffect x:Key="GameElevatedShadow"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.14"
                      Color="#FF111827" />

    <!-- ══════════════════════════════════════════════════════════════════════ -->
