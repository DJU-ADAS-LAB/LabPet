<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:games="clr-namespace:LabPet.Client.Views.Games">

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- LabPet 통합 관리 창(HubWindow) 디자인 토큰 (Win11 클린 · 파스텔 로즈)   -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="HubShellBgColor">#FFF5F6FA</Color>
    <Color x:Key="HubSidebarBgColor">#FFFDFDFE</Color>
    <Color x:Key="HubContentBgColor">#FFF6F7FB</Color>
    <Color x:Key="HubCardBgColor">#FFFFFFFF</Color>
    <Color x:Key="HubSubtleFillColor">#FFF1F3F8</Color>
    <Color x:Key="HubHoverFillColor">#FFEBEFF6</Color>
    <Color x:Key="HubDividerColor">#FFE6EAF2</Color>
    <Color x:Key="HubHairlineColor">#FFEEF1F7</Color>

    <Color x:Key="HubTextPrimaryColor">#FF191F28</Color>
    <Color x:Key="HubTextSecondaryColor">#FF525D6D</Color>
    <Color x:Key="HubTextMutedColor">#FF8B95A1</Color>

    <Color x:Key="HubAccentColor">#FFFF4D82</Color>
    <Color x:Key="HubAccentHoverColor">#FFE83B6F</Color>
    <Color x:Key="HubAccentSoftColor">#FFFFEEF4</Color>
    <Color x:Key="HubAccentBorderColor">#FFFFC6D7</Color>
    <Color x:Key="HubAccentTextColor">#FFD92662</Color>

    <SolidColorBrush x:Key="HubShellBgBrush" Color="{StaticResource HubShellBgColor}" />
    <SolidColorBrush x:Key="HubSidebarBgBrush" Color="{StaticResource HubSidebarBgColor}" />
    <SolidColorBrush x:Key="HubContentBgBrush" Color="{StaticResource HubContentBgColor}" />
    <SolidColorBrush x:Key="HubCardBgBrush" Color="{StaticResource HubCardBgColor}" />
    <SolidColorBrush x:Key="HubSubtleFillBrush" Color="{StaticResource HubSubtleFillColor}" />
    <SolidColorBrush x:Key="HubHoverFillBrush" Color="{StaticResource HubHoverFillColor}" />
    <SolidColorBrush x:Key="HubDividerBrush" Color="{StaticResource HubDividerColor}" />
    <SolidColorBrush x:Key="HubHairlineBrush" Color="{StaticResource HubHairlineColor}" />

    <SolidColorBrush x:Key="HubTextPrimaryBrush" Color="{StaticResource HubTextPrimaryColor}" />
    <SolidColorBrush x:Key="HubTextSecondaryBrush" Color="{StaticResource HubTextSecondaryColor}" />
    <SolidColorBrush x:Key="HubTextMutedBrush" Color="{StaticResource HubTextMutedColor}" />

    <SolidColorBrush x:Key="HubAccentBrush" Color="{StaticResource HubAccentColor}" />
    <SolidColorBrush x:Key="HubAccentHoverBrush" Color="{StaticResource HubAccentHoverColor}" />
    <SolidColorBrush x:Key="HubAccentSoftBrush" Color="{StaticResource HubAccentSoftColor}" />
    <SolidColorBrush x:Key="HubAccentBorderBrush" Color="{StaticResource HubAccentBorderColor}" />
    <SolidColorBrush x:Key="HubAccentTextBrush" Color="{StaticResource HubAccentTextColor}" />

    <!-- 공용 컨버터 -->
    <BooleanToVisibilityConverter x:Key="HubBoolToVis" />
    <games:EnumEqualsConverter x:Key="HubEnumEquals" />
    <games:EnumToVisibilityConverter x:Key="HubEnumToVis" />
    <games:InverseBoolToVisibilityConverter x:Key="HubInverseBoolToVis" />
    <games:NullToVisibilityConverter x:Key="HubNullToVis" />

    <!-- 일관된 선형 벡터 아이콘 Geometry (24x24 기준 좌표) -->
    <Geometry x:Key="IconHomeGeometry">M3.5,10.5 L12,3.5 L20.5,10.5 M5.5,9.5 V19.5 H10 V14 H14 V19.5 H18.5 V9.5</Geometry>
    <Geometry x:Key="IconPaletteGeometry">M12,3.5 A8.5,8.5 0 1 0 20.5,12 C20.5,10.2 19,9.2 17.5,9.5 C16.3,9.7 15.8,8.7 16.5,7.8 C17.5,6.5 16.3,3.5 12,3.5 Z M8.5,9.5 A1,1 0 1 1 8.49,9.5 M12,7.5 A1,1 0 1 1 11.99,7.5 M7.5,13.5 A1,1 0 1 1 7.49,13.5</Geometry>
    <Geometry x:Key="IconTrendUpGeometry">M3.5,17 L9.5,11 L13.5,15 L20.5,7 M15.5,7 H20.5 V12</Geometry>
    <Geometry x:Key="IconGamepadGeometry">M6.5,8 H17.5 A3.5,3.5 0 0 1 21,11.5 V15.5 A2.5,2.5 0 0 1 18.5,18 C17.3,18 16.4,17.2 15.8,16.2 L14.8,14.5 H9.2 L8.2,16.2 C7.6,17.2 6.7,18 5.5,18 A2.5,2.5 0 0 1 3,15.5 V11.5 A3.5,3.5 0 0 1 6.5,8 Z M8,10.5 V13.5 M6.5,12 H9.5 M15.5,11 H15.6 M17.5,13 H17.6</Geometry>
    <Geometry x:Key="IconTreeGeometry">M12,3 L7,10 H10 L6,16 H18 L14,10 H17 L12,3 Z M12,16 V21 M9,21 H15</Geometry>
    <Geometry x:Key="IconSettingsGeometry">M12,8.5 A3.5,3.5 0 1 1 11.99,8.5 Z M12,3 V5.2 M12,18.8 V21 M3,12 H5.2 M18.8,12 H21 M5.6,5.6 L7.2,7.2 M16.8,16.8 L18.4,18.4 M18.4,5.6 L16.8,7.2 M7.2,16.8 L5.6,18.4</Geometry>
    <Geometry x:Key="IconInfoGeometry">M12,3 A9,9 0 1 1 11.99,3 Z M12,11 V16.5 M12,7.5 V8</Geometry>
    <Geometry x:Key="IconSidebarToggleGeometry">M4,5 H20 V19 H4 Z M9.5,5 V19</Geometry>
    <Geometry x:Key="IconFolderGeometry">M3.5,6.5 H9.5 L11.5,8.5 H20.5 V18.5 H3.5 Z</Geometry>
    <Geometry x:Key="IconExternalLinkGeometry">M14,4 H20 V10 M11,13 L20,4 M19,13.5 V19 H5 V5 H10.5</Geometry>

    <!-- 키보드 포커스 시각 표시 -->
    <Style x:Key="HubFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2"
                            CornerRadius="10"
                            BorderBrush="{StaticResource HubAccentBrush}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 카드 · 패널 · 타이포그래피 스타일 -->
    <Style x:Key="HubCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HubCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource GameCardShadow}" />
    </Style>

    <Style x:Key="HubSubtlePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HubSubtleFillBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="HubPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource HubTextPrimaryBrush}" />
    </Style>

    <Style x:Key="HubSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource HubTextPrimaryBrush}" />
    </Style>

    <Style x:Key="HubCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HubTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 상태 배지 -->
    <Style x:Key="HubBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HubSubtleFillBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 세그먼트 전환 (게임 공용 스타일과 일관 유지) -->
    <Style x:Key="HubSegmentRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource GameSegmentRadioStyle}" />

    <!-- Windows 11 토글 스위치 (CheckBox 기반) -->
    <Style x:Key="HubToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource HubTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                        <Border x:Name="Track"
                                Grid.Column="1"
                                Width="42"
                                Height="24"
                                CornerRadius="12"
                                Background="#FFD5DBE6"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob"
                                     Width="18"
                                     Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource HubAccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#FFC4CCD9" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource HubAccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
