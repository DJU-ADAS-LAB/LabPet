<UserControl x:Class="LabPet.Client.Views.Controls.FriendInvitePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <StackPanel>
        <!-- 상단 검색(전체 폭) + 선택 요약/전체 선택·해제 2단 도구 막대 -->
        <StackPanel Margin="0,0,0,8">
            <Border Background="#FFFFFFFF"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="34"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="M11,11 L15.5,15.5 M6.8,12 A5.2,5.2 0 1,1 6.81,12 Z"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          Stroke="{StaticResource GameTextMutedBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Center"
                          Margin="0,0,7,0" />

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="사용자 이름 또는 펫 이름으로 검색"
                                   FontSize="12"
                                   Foreground="{StaticResource GameTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasSearchQuery, Converter={StaticResource HubInverseBoolToVis}}" />
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12.5"
                                 Foreground="{StaticResource GameTextPrimaryBrush}"
                                 VerticalContentAlignment="Center"
                                 Padding="0" />
                    </Grid>

                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource HubBoolToVis}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource GameTextMutedBrush}"
                            FontSize="11"
                            FontWeight="Bold"
                            Padding="4,2"
                            Cursor="Hand"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource GameSubtleFillBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummaryText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GameTextSecondaryBrush}" />
                </Border>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding IsMultiSelect, Converter={StaticResource HubBoolToVis}}">
                    <Button Content="전체 선택"
                            Command="{Binding SelectAllCommand}"
                            IsEnabled="{Binding CanInteract}"
                            Style="{StaticResource GameSecondaryButtonStyle}"
                            Height="28"
                            Padding="9,3"
                            FontSize="11"
                            Margin="0,0,5,0" />
                    <Button Content="전체 해제"
                            Command="{Binding ClearSelectionCommand}"
                            IsEnabled="{Binding CanInteract}"
                            Style="{StaticResource GameSecondaryButtonStyle}"
                            Height="28"
                            Padding="9,3"
                            FontSize="11" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- 온라인/검색 결과 없을 때 안내 -->
        <Border Visibility="{Binding HasFilteredCandidates, Converter={StaticResource HubInverseBoolToVis}}"
                Background="{StaticResource GameSubtleFillBrush}"
                BorderBrush="{StaticResource GameDividerBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,16">
            <TextBlock Text="{Binding EmptyStateText}"
                       FontSize="12"
                       Foreground="{StaticResource GameTextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- 반응형 프로필 카드 그리드 -->
        <ScrollViewer MaxHeight="208"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Visibility="{Binding HasFilteredCandidates, Converter={StaticResource HubBoolToVis}}">
            <ItemsControl ItemsSource="{Binding FilteredCandidates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.ToggleCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Cursor="Hand"
                                Margin="0,0,8,8"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Width="142"
                                            Padding="10,10,10,11"
                                            CornerRadius="14"
                                            Background="#FFFFFFFF"
                                            BorderBrush="{StaticResource GameDividerBrush}"
                                            BorderThickness="1.3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 우측 상단 체크 아이콘 -->
                                            <Border x:Name="CheckCircle"
                                                    Grid.Row="0"
                                                    Width="20" Height="20"
                                                    CornerRadius="10"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="#FFF4F6FA"
                                                    BorderBrush="{StaticResource GameDividerBrush}"
                                                    BorderThickness="1.2">
                                                <Path x:Name="CheckGlyph"
                                                      Data="{StaticResource IconCheckGeometry}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      Stroke="#FFFFFFFF"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Visibility="Collapsed"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>

                                            <!-- 중앙 실제 펫 프로필 이미지 -->
                                            <Border Grid.Row="1"
                                                    Width="56" Height="56"
                                                    CornerRadius="28"
                                                    Background="{StaticResource GameSubtleFillBrush}"
                                                    BorderBrush="{StaticResource GameDividerBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,2,0,8"
                                                    HorizontalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding PetInitial}"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource GameTextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Portrait, Converter={StaticResource HubNullToVis}, ConverterParameter=Invert, FallbackValue=Visible}" />
                                                    <Image Source="{Binding Portrait}"
                                                           Margin="3"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>

                                            <!-- 하단 사용자 이름 · 펫 이름 · 온라인 상태 -->
                                            <StackPanel Grid.Row="2" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding PetName}"
                                                           FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource GameTextPrimaryBrush}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OwnerName}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource GameTextSecondaryBrush}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,5" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="#FF16A34A" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF15803D"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource GamePinkSoftBrush}" />
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource GamePinkBrush}" />
                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="CheckCircle" Property="Background" Value="{StaticResource GamePinkBrush}" />
                                            <Setter TargetName="CheckCircle" Property="BorderBrush" Value="{StaticResource GamePinkBrush}" />
                                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FFF8FAFD" />
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFB8C2D6" />
                                        </MultiDataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.65" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
