<Window x:Class="LabPet.Client.Views.EnvironmentGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabPet · 방화벽 · SmartScreen · 환경 안내"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="680"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Margin="14"
            Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource SoftCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Padding="22,0,14,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrandPinkBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="방화벽 · 네트워크 · 환경 안내" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Margin="20,4,14,0" Padding="0,0,8,0">
                <StackPanel>
                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. LAN P2P 소셜용 Windows 방화벽 허용 (로컬 서브넷 · LabPet 전용)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrandPinkBrush}" />
                            <TextBlock Text="같은 Wi-Fi/LAN의 친구가 보이지 않거나 친구 신청이 실패할 경우, 아래 인바운드 포트가 허용되어 있는지 확인해 주세요. 보안 강화를 위해 같은 로컬 서브넷(LocalSubnet)에서 LabPet 실행 파일로 들어오는 통신만 허용합니다."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,8" />
                            <TextBlock Text="• UDP 45678: 주변 펫 자동 탐색 (HELLO 브로드캐스트)&#x0a;• UDP 45679: 노래 따라하기 30Hz 오디오 프레임&#x0a;• TCP 45680: 친구 신청/수락, 말풍선 메시지, 구독 제어, 친구 코인 게임"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10" />
                            <TextBox x:Name="FirewallCommandBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="10" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="🛡️ 원클릭 방화벽 자동 허용 (권장)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AutoRegisterFirewall_Click"
                                        Margin="0,0,8,0" />
                                <Button Content="명령어 복사"
                                        Click="CopyFirewallCommand_Click" />
                            </StackPanel>
                            <TextBlock x:Name="FirewallStatusText"
                                       TextWrapping="Wrap"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandPinkBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2. Windows SmartScreen ('PC 보호') 경고가 표시될 때" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="초기 오픈소스/미서명 배포판 설치 시 Windows Defender SmartScreen 파란 화면이 나타날 수 있습니다. 경고 창에서 [추가 정보] → [실행]을 선택하면 정상 설치됩니다."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="3. 자동 업데이트 시 데이터 안전 보존" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="DataPathText"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="닫기"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Width="92"
                    Height="36"
                    Margin="20,12,20,18" />
        </Grid>
    </Border>
</Window>
