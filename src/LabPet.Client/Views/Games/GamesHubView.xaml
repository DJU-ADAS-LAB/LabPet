<UserControl x:Class="LabPet.Client.Views.Games.GamesHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:games="clr-namespace:LabPet.Client.Views.Games"
             xmlns:vm="clr-namespace:LabPet.Client.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- 1. 게임 선택 대시보드 -->
        <Grid Visibility="{Binding IsOnGameDashboard, Converter={StaticResource BoolToVis}}"
              Margin="4,2,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="미니게임"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}" />
                    <TextBlock Text="혼자 가볍게 즐기거나 온라인 친구와 코인을 걸고 겨뤄 보세요."
                               FontSize="12.5"
                               Foreground="{StaticResource GameTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{StaticResource GameCardBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource GameWinBrush}" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOnlineFriends}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource GameTextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}">
                            <Run Text="온라인 친구 " />
                            <Run Text="{Binding OnlineFriends.Count, Mode=OneWay}" Foreground="{StaticResource GameTextPrimaryBrush}" FontWeight="Bold" />
                            <Run Text="명" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2x2 카드형 게임 대시보드 -->
            <ScrollViewer x:Name="DashboardCardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <UniformGrid Columns="2" Rows="2" MinHeight="{Binding ViewportHeight, ElementName=DashboardCardsScroll}">
                <!-- 카드 1: 하이로우 -->
                <Button Style="{StaticResource GameCardButtonStyle}"
                        Command="{Binding OpenGameScreenCommand}"
                        CommandParameter="{x:Static vm:GameScreen.HiLow}"
                        Margin="0,0,7,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <Border DockPanel.Dock="Left"
                                    Width="42" Height="42"
                                    CornerRadius="12"
                                    Background="{StaticResource GamePinkSoftBrush}">
                                <Path Data="{StaticResource IconCardsGeometry}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource GamePinkBrush}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Visibility="{Binding IsHiLowInProgress, Converter={StaticResource BoolToVis}}"
                                        Background="{StaticResource GamePinkBrush}"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="진행 중" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,5,0">
                                    <TextBlock Text="혼자" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                </Border>
                                <Border Background="{StaticResource GameCoinSoftBrush}" BorderBrush="{StaticResource GameCoinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                    <TextBlock Text="코인" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,10">
                            <TextBlock Text="하이로우"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}" />
                            <TextBlock Text="다음 카드가 높을지 낮을지 맞혀 연속 배수를 노립니다."
                                       FontSize="12.5"
                                       Foreground="{StaticResource GameTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="최대 8배 보상 · 중간 정산 가능"
                                       FontSize="11.5"
                                       Foreground="{StaticResource GameTextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="12,5">
                                <TextBlock Text="플레이" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </Button>

                <!-- 카드 2: 가위바위보 -->
                <Button Style="{StaticResource GameCardButtonStyle}"
                        Command="{Binding OpenGameScreenCommand}"
                        CommandParameter="{x:Static vm:GameScreen.Rps}"
                        Margin="7,0,0,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <Border DockPanel.Dock="Left"
                                    Width="42" Height="42"
                                    CornerRadius="12"
                                    Background="#FFEEF2FF">
                                <Path Data="{StaticResource IconHandScissorsGeometry}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      Stroke="#FF4F46E5"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Visibility="{Binding IsRpsInProgress, Converter={StaticResource BoolToVis}}"
                                        Background="{StaticResource GamePinkBrush}"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="진행 중" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,5,0">
                                    <TextBlock Text="친구 대전" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                </Border>
                                <Border Background="{StaticResource GameCoinSoftBrush}" BorderBrush="{StaticResource GameCoinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                    <TextBlock Text="코인" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,10">
                            <TextBlock x:Name="RpsDashboardTitle" Text="친구 가위바위보"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}" />
                            <TextBlock Text="온라인 친구와 동시 선택 후 암호화 검증으로 승부를 겨룹니다."
                                       FontSize="12.5"
                                       Foreground="{StaticResource GameTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="1:1 비공개 선택 · 승리 시 2배"
                                       FontSize="11.5"
                                       Foreground="{StaticResource GameTextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="12,5">
                                <TextBlock Text="플레이" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </Button>

                <!-- 카드 3: 타이핑 대결 -->
                <Button Style="{StaticResource GameCardButtonStyle}"
                        Command="{Binding OpenGameScreenCommand}"
                        CommandParameter="{x:Static vm:GameScreen.Typing}"
                        Margin="0,7,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <Border DockPanel.Dock="Left"
                                    Width="42" Height="42"
                                    CornerRadius="12"
                                    Background="{StaticResource GameWinSoftBrush}">
                                <Path Data="{StaticResource IconKeyboardGeometry}"
                                      Width="22" Height="20"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource GameWinBrush}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Visibility="{Binding IsTypingInProgress, Converter={StaticResource BoolToVis}}"
                                        Background="{StaticResource GamePinkBrush}"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="진행 중" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,5,0">
                                    <TextBlock Text="혼자 / 대전" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                </Border>
                                <Border Background="{StaticResource GameFreeSoftBrush}" BorderBrush="{StaticResource GameFreeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                    <TextBlock Text="코인 / 연습" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GameFreeBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,10">
                            <TextBlock Text="타이핑 대결"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}" />
                            <TextBlock Text="10초 동안 제시된 문장을 정확하고 빠르게 입력해 대결합니다."
                                       FontSize="12.5"
                                       Foreground="{StaticResource GameTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="3초 준비 · 실시간 점수 비교"
                                       FontSize="11.5"
                                       Foreground="{StaticResource GameTextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="12,5">
                                <TextBlock Text="플레이" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </Button>

                <!-- 카드 4: 연구실 사다리 -->
                <Button Style="{StaticResource GameCardButtonStyle}"
                        Command="{Binding OpenGameScreenCommand}"
                        CommandParameter="{x:Static vm:GameScreen.Ladder}"
                        Margin="7,7,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <Border DockPanel.Dock="Left"
                                    Width="42" Height="42"
                                    CornerRadius="12"
                                    Background="{StaticResource GameCoinSoftBrush}">
                                <Path Data="{StaticResource IconLadderGeometry}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource GameCoinBrush}"
                                      StrokeThickness="2.0"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Visibility="{Binding IsLadderInProgress, Converter={StaticResource BoolToVis}}"
                                        Background="{StaticResource GamePinkBrush}"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="진행 중" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,5,0">
                                    <TextBlock Text="혼자 / 단체" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                </Border>
                                <Border Background="{StaticResource GameFreeSoftBrush}" BorderBrush="{StaticResource GameFreeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                    <TextBlock Text="무료 / 코인" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GameFreeBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,10">
                            <TextBlock x:Name="LadderDashboardTitle" Text="연구실 사다리"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}" />
                            <TextBlock Text="참가자 확정과 위치 선택 후 공정하게 사다리 추첨을 진행합니다."
                                       FontSize="12.5"
                                       Foreground="{StaticResource GameTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="최대 8명 · 도착 시 결과 공개"
                                       FontSize="11.5"
                                       Foreground="{StaticResource GameTextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="12,5">
                                <TextBlock Text="플레이" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </Button>
            </UniformGrid>
            </ScrollViewer>
        </Grid>

        <!-- 2. 개별 게임 전용 셸 -->
        <Grid Visibility="{Binding IsInActiveGameScreen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 공통 상단 바: 뒤로 가기 / 게임 이름 / 보유 코인 -->
            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,9"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource GameGhostButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}"
                            IsEnabled="{Binding CanNavigateBackFromGame}"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBackGeometry}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="게임 목록" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border DockPanel.Dock="Left" Width="1" Height="18" Background="{StaticResource GameDividerBrush}" Margin="8,0,12,0" VerticalAlignment="Center" />

                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding CurrentGameTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Border DockPanel.Dock="Right"
                            Background="{StaticResource GameCoinSoftBrush}"
                            BorderBrush="{StaticResource GameCoinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="11,5"
                            ToolTip="{Binding CurrentCoinsExactTooltip}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCoinGeometry}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource GameCoinBrush}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding CurrentCoinsCompactText, Mode=OneWay}" />
                                <Run Text=" 코인" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 현재 선택된 단일 게임 뷰 호스트 (전환 시 이전 화면 해제) -->
            <ContentControl x:Name="ActiveGameHost"
                            Grid.Row="1"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="HostSlideTransform" Y="0" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
