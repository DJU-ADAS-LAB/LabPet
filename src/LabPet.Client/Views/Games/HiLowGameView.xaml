<UserControl x:Class="LabPet.Client.Views.Games.HiLowGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:games="clr-namespace:LabPet.Client.Views.Games"
             xmlns:vm="clr-namespace:LabPet.Client.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
        <games:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="HiLowSuitPathStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconSuitSpadeGeometry}" />
            <Setter Property="Fill" Value="#FF191F28" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HiLowCardSuitIndex}" Value="1">
                    <Setter Property="Data" Value="{StaticResource IconSuitHeartGeometry}" />
                    <Setter Property="Fill" Value="#FFEF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HiLowCardSuitIndex}" Value="2">
                    <Setter Property="Data" Value="{StaticResource IconSuitDiamondGeometry}" />
                    <Setter Property="Fill" Value="#FFEF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HiLowCardSuitIndex}" Value="3">
                    <Setter Property="Data" Value="{StaticResource IconSuitClubGeometry}" />
                    <Setter Property="Fill" Value="#FF191F28" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HiLowRankTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF191F28" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HiLowIsRedSuit}" Value="True">
                    <Setter Property="Foreground" Value="#FFEF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 연승 / 배율 / 예상 수령액 + 펫 반응 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="3" Margin="0,0,10,0">
                <Border Background="{StaticResource GameCardBrush}" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="현재 연승" FontSize="11" Foreground="{StaticResource GameTextMutedBrush}" />
                        <TextBlock Text="{Binding HiLowStreakText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource GameCardBrush}" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="적용 배율" FontSize="11" Foreground="{StaticResource GameTextMutedBrush}" />
                        <TextBlock Text="{Binding HiLowMultiplierText}" FontSize="17" FontWeight="Bold" Foreground="#FF4F46E5" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource GameCardBrush}" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="예상 수령" FontSize="11" Foreground="{StaticResource GameTextMutedBrush}" />
                        <TextBlock Text="{Binding HiLowPotentialPayoutText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 내 펫 반응 카드 -->
            <Border Grid.Column="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,8"
                    MinWidth="136">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PetReactionAvatar"
                            Width="38" Height="38"
                            CornerRadius="11"
                            Background="{StaticResource GamePinkSoftBrush}"
                            RenderTransformOrigin="0.5,0.5"
                            Margin="0,0,9,0">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PetReactionScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Image Source="{Binding MyPetPortrait}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding MyDisplayName}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" MaxWidth="86" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HiLowLastFeedbackTag}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GamePinkBrush}"
                                   Visibility="{Binding HiLowLastFeedbackTag, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 중앙 트럼프 카드 스테이지 -->
        <Border Grid.Row="1"
                Background="{StaticResource GameCardBrush}"
                BorderBrush="{StaticResource GameDividerBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource GameSubtleFillBrush}"
                        CornerRadius="9"
                        Padding="12,5">
                    <TextBlock Text="카드 범위: A (1) ~ K (13) · 같은 숫자가 나오면 무승부"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GameTextSecondaryBrush}" />
                </Border>

                <!-- 실제 트럼프 카드 UI -->
                <Border x:Name="PlayingCardBorder"
                        Grid.Row="1"
                        Width="166"
                        Height="226"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderThickness="2"
                        CornerRadius="18"
                        Padding="14,12"
                        Effect="{StaticResource GameCardShadow}"
                        RenderTransformOrigin="0.5,0.5"
                        Margin="0,12">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CardFlipScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource GameDividerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HiLowPhase}" Value="{x:Static vm:HiLowPhase.Playing}">
                                    <Setter Property="BorderBrush" Value="{StaticResource GamePinkBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HiLowResultKind}" Value="{x:Static vm:HiLowResultKind.CashedOut}">
                                    <Setter Property="BorderBrush" Value="{StaticResource GameWinBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HiLowResultKind}" Value="{x:Static vm:HiLowResultKind.Lost}">
                                    <Setter Property="BorderBrush" Value="{StaticResource GameLossBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <!-- 시작 전 대기 뒷면 카드 -->
                        <Border Visibility="{Binding HiLowPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Idle}"
                                Background="{StaticResource GamePinkSoftBrush}"
                                CornerRadius="12"
                                Margin="2">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconCardsGeometry}"
                                      Width="40" Height="40"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource GamePinkBrush}"
                                      StrokeThickness="1.8"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="준비 완료"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GamePinkBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 공개된 카드 면 (Playing / Result) -->
                        <Grid Visibility="{Binding HiLowPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Playing|Result}">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{Binding HiLowCardRankText}"
                                           Style="{StaticResource HiLowRankTextStyle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <Path Style="{StaticResource HiLowSuitPathStyle}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Style="{StaticResource HiLowSuitPathStyle}"
                                      Width="50" Height="50"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding HiLowCardDisplay}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GameTextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </StackPanel.RenderTransform>
                                <TextBlock Text="{Binding HiLowCardRankText}"
                                           Style="{StaticResource HiLowRankTextStyle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <Path Style="{StaticResource HiLowSuitPathStyle}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{Binding HiLowStatusMessage}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 하단 상태별 전용 조작 영역 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <!-- Idle: 배팅 선택 + 시작 버튼 -->
            <Border Visibility="{Binding HiLowPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Idle}"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="배팅 코인" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="12" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="10" Style="{StaticResource GameSegmentRadioStyle}" GroupName="HiLowWagerGroup" Padding="12,6"
                                             IsChecked="{Binding HiLowWager, Converter={StaticResource EnumEquals}, ConverterParameter=10}" />
                                <RadioButton Content="30" Style="{StaticResource GameSegmentRadioStyle}" GroupName="HiLowWagerGroup" Padding="12,6"
                                             IsChecked="{Binding HiLowWager, Converter={StaticResource EnumEquals}, ConverterParameter=30}" />
                                <RadioButton Content="50" Style="{StaticResource GameSegmentRadioStyle}" GroupName="HiLowWagerGroup" Padding="12,6"
                                             IsChecked="{Binding HiLowWager, Converter={StaticResource EnumEquals}, ConverterParameter=50}" />
                                <RadioButton Content="100" Style="{StaticResource GameSegmentRadioStyle}" GroupName="HiLowWagerGroup" Padding="12,6"
                                             IsChecked="{Binding HiLowWager, Converter={StaticResource EnumEquals}, ConverterParameter=100}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding StartHiLowCommand}"
                            Content="게임 시작"
                            MinWidth="156"
                            Height="42" />
                </DockPanel>
            </Border>

            <!-- Playing: 높다 / 낮다 / 지금 정산 -->
            <Grid Visibility="{Binding HiLowPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Playing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource GamePrimaryButtonStyle}"
                        Command="{Binding GuessHigherCommand}"
                        Height="52">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconArrowUpGeometry}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="높다 (UP)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource GameSecondaryButtonStyle}"
                        Command="{Binding GuessLowerCommand}"
                        Height="52">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconArrowDownGeometry}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource GameTextPrimaryBrush}"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="낮다 (DOWN)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource GameOutlineButtonStyle}"
                        Command="{Binding CashOutHiLowCommand}"
                        IsEnabled="{Binding CanCashOutHiLow}"
                        MinWidth="148"
                        Height="52">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCoinGeometry}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Stroke="{StaticResource GameCoinBrush}"
                              StrokeThickness="2"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                        <TextBlock Text="지금 정산" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Result: 결과 요약 & 다시 하기 -->
            <Border Visibility="{Binding HiLowPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Result}"
                    CornerRadius="16"
                    Padding="16,12"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource GameCardBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource GameDividerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HiLowResultKind}" Value="{x:Static vm:HiLowResultKind.CashedOut}">
                                <Setter Property="Background" Value="{StaticResource GameWinSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GameWinBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HiLowResultKind}" Value="{x:Static vm:HiLowResultKind.Lost}">
                                <Setter Property="Background" Value="{StaticResource GameLossSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GameLossBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock FontSize="14.5" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="라운드 종료" />
                                    <Setter Property="Foreground" Value="{StaticResource GameTextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HiLowResultKind}" Value="{x:Static vm:HiLowResultKind.CashedOut}">
                                            <Setter Property="Text" Value="정산 완료" />
                                            <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HiLowResultKind}" Value="{x:Static vm:HiLowResultKind.Lost}">
                                            <Setter Property="Text" Value="아쉬운 실패" />
                                            <Setter Property="Foreground" Value="{StaticResource GameLossBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding HiLowStatusMessage}" FontSize="12" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding NavigateToDashboardCommand}"
                                Content="다른 게임"
                                Height="40"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource GamePrimaryButtonStyle}"
                                Command="{Binding ResetHiLowToSetupCommand}"
                                Content="다시 하기"
                                MinWidth="128"
                                Height="40" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
