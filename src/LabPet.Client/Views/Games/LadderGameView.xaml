<UserControl x:Class="LabPet.Client.Views.Games.LadderGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:games="clr-namespace:LabPet.Client.Views.Games"
             xmlns:vm="clr-namespace:LabPet.Client.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
        <games:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <games:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- 1단계: 게임 설정 -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Setup}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 상단 모드 전환 (친구들과 하기 / 혼자 돌리기) + 규칙 요약 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <Border DockPanel.Dock="Left" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="12" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="친구들과 하기"
                                     Style="{StaticResource GameSegmentRadioStyle}"
                                     GroupName="LadderModeGroup"
                                     IsChecked="{Binding IsLadderMultiplayerMode, Mode=TwoWay}"
                                     Padding="14,7" />
                        <RadioButton Content="혼자 돌리기"
                                     Style="{StaticResource GameSegmentRadioStyle}"
                                     GroupName="LadderModeGroup"
                                     IsChecked="{Binding IsLadderMultiplayerMode, Converter={StaticResource EnumEquals}, ConverterParameter=False}"
                                     Padding="14,7" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Right"
                           Text="참가자 확정 → 위치 선택 → 무작위 사다리 → 도착 시 결과 공개"
                           FontSize="11.5"
                           Foreground="{StaticResource GameTextMutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- 중앙 설정 2단 카드 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 참여 친구 직접 선택 (멀티) OR 참여자 이름 (솔로) -->
                <Border Grid.Column="0"
                        Background="{StaticResource GameCardBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18,16">
                    <Grid>
                        <!-- 멀티: 초대할 온라인 친구 직접 선택 -->
                        <Grid Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="초대할 친구 선택" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                    <TextBlock Text="체크한 친구에게만 초대가 전송됩니다." FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource GamePinkSoftBrush}" CornerRadius="8" Padding="9,4" VerticalAlignment="Top">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}">
                                        <Run Text="선택 " /><Run Text="{Binding SelectedLadderInviteeCount, Mode=OneWay}" /><Run Text="명" />
                                    </TextBlock>
                                </Border>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding LadderInviteCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource GameSubtleFillBrush}"
                                                        CornerRadius="12"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              HorizontalContentAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="White" Margin="0,0,9,0">
                                                                <Image Source="{Binding Portrait}" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource GameTextPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Visibility="{Binding HasOnlineFriends, Converter={StaticResource InvBoolToVis}}"
                                            Background="{StaticResource GameSubtleFillBrush}"
                                            CornerRadius="12"
                                            Padding="14,18"
                                            Margin="0,4,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconUsersGeometry}" Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource GameTextMutedBrush}" StrokeThickness="1.8" HorizontalAlignment="Center" />
                                            <TextBlock Text="현재 온라인 친구가 없습니다." FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,3" />
                                            <TextBlock Text="상단에서 '혼자 돌리기'로 바로 테스트할 수 있습니다." FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 솔로: 참여자 이름 직접 입력 -->
                        <StackPanel Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource InvBoolToVis}}">
                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="참여자 (2~8명)" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                    <TextBlock Text="쉼표(,)로 구분해 입력해 주세요." FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource GameSecondaryButtonStyle}"
                                        Content="친구 불러오기"
                                        Command="{Binding LoadOnlineFriendsToLadderCommand}"
                                        Padding="10,5"
                                        FontSize="11.5"
                                        VerticalAlignment="Top" />
                            </DockPanel>

                            <TextBox Text="{Binding LadderParticipantsText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditLadderSetup}"
                                     Height="42"
                                     FontSize="13.5"
                                     Margin="0,4,0,12" />

                            <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="12" Padding="12,10">
                                <TextBlock Text="혼자 돌리기에서도 상품 배치는 무작위로 섞이며, 각 줄이 바닥에 닿는 순간 결과가 공개됩니다."
                                           FontSize="11.5"
                                           Foreground="{StaticResource GameTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 오른쪽: 상품 종류·수량 + 프리셋 + 참가비 -->
                <Border Grid.Column="2"
                        Background="{StaticResource GameCardBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="상품 종류 · 수량" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                <TextBlock Text="상품 종류와 수량은 처음부터 모두에게 공개됩니다." FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="커피 쏘기" Command="{Binding ApplyCoffeePresetCommand}" Padding="9,5" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="코인 잭팟" Command="{Binding ApplyCoinJackpotPresetCommand}" Padding="9,5" FontSize="11" />
                            </StackPanel>
                        </DockPanel>

                        <TextBox Text="{Binding LadderPrizesText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditLadderSetup}"
                                 Height="42"
                                 FontSize="13.5"
                                 Margin="0,2,0,16" />

                        <TextBlock Text="참가비" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="무료 (0코인)" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="11,7"
                                             IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=0}" />
                                <RadioButton Content="10 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="11,7"
                                             IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=10}" />
                                <RadioButton Content="30 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="11,7"
                                             IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=30}" />
                                <RadioButton Content="50 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="11,7"
                                             IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=50}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="무료 모드에서는 코인이 차감·환불·지급되지 않으며, 유료 모드에서는 잭팟 당첨자가 전체 참가비를 획득합니다."
                                   FontSize="11.5"
                                   Foreground="{StaticResource GameTextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 하단 실행 버튼 -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding LadderStatusText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="470"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding OpenLadderRoomCommand}"
                            IsEnabled="{Binding CanOpenLadderRoom}"
                            Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource BoolToVis}}"
                            Content="친구 초대 방 열기"
                            MinWidth="168"
                            Height="42" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding RunLadderCommand}"
                            IsEnabled="{Binding CanEditLadderSetup}"
                            Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource InvBoolToVis}}"
                            Content="사다리 시작"
                            MinWidth="156"
                            Height="42" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 2단계: 참가자 대기실 -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Lobby}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,13"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding LadderLobbySummaryText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                        <TextBlock Text="{Binding LadderRoomPrizesText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="방장 참가자 확정 대기 중" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LadderParticipantCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource GameSubtleFillBrush}"
                                            BorderBrush="{StaticResource GameDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14,12"
                                            Width="188"
                                            Margin="0,0,10,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="White">
                                                    <Image Source="{Binding Portrait}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Border Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" Background="{StaticResource GamePinkSoftBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                                        <TextBlock Text="방장" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                                                    </Border>
                                                    <Border Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" Background="White" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="나" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GameTextMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="11" Padding="12,9" Margin="0,8,0,0">
                        <TextBlock Text="모든 초대에 대한 응답이 끝난 뒤 방장이 '참가자 확정'을 누르면 시작 위치를 선택할 수 있습니다."
                                   FontSize="12"
                                   Foreground="{StaticResource GameTextSecondaryBrush}"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding LadderStatusText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="430"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GameDangerButtonStyle}"
                            Command="{Binding CancelLadderRoomCommand}"
                            Content="방 나가기 / 취소"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding ConfirmLadderParticipantsCommand}"
                            IsEnabled="{Binding CanConfirmLadderParticipants}"
                            Visibility="{Binding ShowConfirmLadderButton, Converter={StaticResource BoolToVis}}"
                            Content="참가자 확정"
                            MinWidth="148"
                            Height="40" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 3단계: 시작 위치 선택 -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Picking}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,13"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding LadderLobbySummaryText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                        <TextBlock Text="{Binding LadderRoomPrizesText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource GameFreeSoftBrush}" BorderBrush="{StaticResource GameFreeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="중복 선택 불가 · 전원 선택 시 시작" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameFreeBrush}" />
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 시작 슬롯 버튼 그리드 -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding LadderSlots}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PickLadderSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ColumnIndex}"
                                        IsEnabled="{Binding CanPick}"
                                        Margin="4"
                                        Padding="8,14"
                                        MinHeight="146">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GameOutlineButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource GameSubtleFillBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GamePinkSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GamePinkBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanPick}" Value="True">
                                                    <Setter Property="Background" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeaderText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <Border Width="42" Height="42" CornerRadius="12" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" Margin="0,0,0,8" HorizontalAlignment="Center"
                                                Visibility="{Binding OccupantPortrait, Converter={StaticResource NullToVis}}">
                                            <Image Source="{Binding OccupantPortrait}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding OccupantText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="92" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 참가자별 선택 진행 배지 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LadderParticipantCards}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="10,5" Margin="4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GamePinkBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding LadderStatusText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="430"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GameDangerButtonStyle}"
                            Command="{Binding CancelLadderRoomCommand}"
                            Content="취소"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding StartLadderRoomCommand}"
                            IsEnabled="{Binding CanStartLadderGame}"
                            Visibility="{Binding ShowStartLadderButton, Converter={StaticResource BoolToVis}}"
                            Content="게임 시작"
                            MinWidth="148"
                            Height="40" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 4단계: 사다리 진행 (사다리판 최대화, 설정/대기실 숨김, 하단 도착 시 개별 공개) -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Running}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,9"
                    Margin="0,0,0,10">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding LadderBoardPrizesSummaryText}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding LadderStatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GamePinkBrush}"
                               VerticalAlignment="Center"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 확대된 사다리판 캔버스 -->
            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14,12">
                <Canvas x:Name="LadderCanvas"
                        ClipToBounds="True"
                        SizeChanged="LadderCanvas_SizeChanged" />
            </Border>

            <!-- 하단 도착 시 공개되는 실시간 현황 칩 -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding LadderResultLines}"
                          Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource GameCardBrush}"
                                BorderBrush="{StaticResource GameDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,5"
                                Margin="3">
                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 5단계: 최종 결과 화면 -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Result}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 내 결과 강조 배너 -->
            <Border Grid.Row="0"
                    Background="{StaticResource GamePinkSoftBrush}"
                    BorderBrush="{StaticResource GamePinkBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="18"
                    Padding="20,14"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LadderResultHeadline}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LadderResultSettlementText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right"
                            Background="White"
                            BorderBrush="{StaticResource GamePinkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Visibility="{Binding LadderMyResultPrizeText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding LadderMyResultPrizeText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- 전체 참가자 결과 카드 리스트 -->
            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LadderResultCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="13" Padding="12,10" Margin="0,0,0,7" BorderThickness="1.2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource GameSubtleFillBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource GameDividerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GamePinkSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GamePinkBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="White" Margin="0,0,10,0">
                                                <Image Source="{Binding Portrait}" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                                    <Border Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" Background="{StaticResource GamePinkBrush}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="나" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="11" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" CornerRadius="10" Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrizeText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 하단 결과 조작 -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding LadderStatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GameSecondaryButtonStyle}"
                            Command="{Binding ShareLadderResultToFriendsCommand}"
                            IsEnabled="{Binding CanShareLadderResult}"
                            Margin="0,0,8,0"
                            Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShareGeometry}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource GameTextPrimaryBrush}" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="결과 공유" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GameSecondaryButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}"
                            Content="게임 목록"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding ResetLadderToSetupCommand}"
                            Content="다시 하기"
                            MinWidth="124"
                            Height="40" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
