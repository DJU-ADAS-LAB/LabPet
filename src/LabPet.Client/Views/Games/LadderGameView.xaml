<UserControl x:Class="LabPet.Client.Views.Games.LadderGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LabPet.Client.Views.Controls"
             xmlns:games="clr-namespace:LabPet.Client.Views.Games"
             xmlns:vm="clr-namespace:LabPet.Client.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
        <games:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <games:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- 1단계: 게임 설정 (단체 사다리 / 솔로 사다리) -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Setup}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 상단 모드 전환 (단체 사다리 / 솔로 사다리) + 규칙 요약 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource GameSubtleFillBrush}"
                        CornerRadius="12"
                        Padding="4"
                        IsEnabled="{Binding CanSwitchLadderMode}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="단체 사다리"
                                     Style="{StaticResource GameSegmentRadioStyle}"
                                     GroupName="LadderModeGroup"
                                     IsChecked="{Binding IsLadderMultiplayerMode, Mode=TwoWay}"
                                     Padding="14,7" />
                        <RadioButton Content="솔로 사다리"
                                     Style="{StaticResource GameSegmentRadioStyle}"
                                     GroupName="LadderModeGroup"
                                     IsChecked="{Binding IsLadderMultiplayerMode, Converter={StaticResource EnumEquals}, ConverterParameter=False}"
                                     Padding="14,7" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Right"
                           Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource BoolToVis}}"
                           Text="친구 초대 → 참가자 확정(60초) → 위치 선택(30초) → 도착 시 공개"
                           FontSize="11.5"
                           Foreground="{StaticResource GameTextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right"
                           Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource InvBoolToVis}}"
                           Text="4칸 공정 사다리 · 꽝(50%) / 본전(25%) / 당첨 2.5배(25%)"
                           FontSize="11.5"
                           Foreground="{StaticResource GameTextMutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- 단체 사다리 Setup 2단 카드 -->
            <Grid Grid.Row="1" Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 공용 FriendInvitePicker (다중 선택 + 전체 선택/해제 + 검색) -->
                <Border Grid.Column="0"
                        Background="{StaticResource GameCardBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="초대할 친구 선택" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                <TextBlock Text="선택한 친구에게만 20초 초대가 전송됩니다." FontSize="11" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource GamePinkSoftBrush}" CornerRadius="8" Padding="9,4" VerticalAlignment="Top">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}">
                                    <Run Text="선택 " /><Run Text="{Binding SelectedLadderInviteeCount, Mode=OneWay}" /><Run Text="명" />
                                </TextBlock>
                            </Border>
                        </DockPanel>

                        <controls:FriendInvitePicker Grid.Row="1"
                                                     DataContext="{Binding LadderFriendPicker}" />
                    </Grid>
                </Border>

                <!-- 오른쪽: 구조화 상품 편집 + 프리셋 3종 + 배정 진행률 바 + 참가비 -->
                <Border Grid.Column="2"
                        Background="{StaticResource GameCardBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 제목 및 3종 프리셋 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="상품 설정" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                <TextBlock Text="종류와 수량은 처음부터 모두에게 공개됩니다." FontSize="11" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="커피 쏘기" Command="{Binding ApplyCoffeePresetCommand}" Padding="8,5" FontSize="11" Margin="0,0,4,0" />
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="당첨 추첨" Command="{Binding ApplyLuckyDrawPresetCommand}" Padding="8,5" FontSize="11" Margin="0,0,4,0" />
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="코인 잭팟" Command="{Binding ApplyCoinJackpotPresetCommand}" Padding="8,5" FontSize="11" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 상품 편집 행 리스트 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="205">
                            <ItemsControl ItemsSource="{Binding LadderPrizeRows}" IsEnabled="{Binding CanEditLadderSetup}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GameSubtleFillBrush}"
                                                BorderBrush="{StaticResource GameDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="8,6"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="24"
                                                         FontSize="12.5"
                                                         Padding="8,5"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,8,0" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Button Style="{StaticResource GameOutlineButtonStyle}"
                                                            Content="-"
                                                            Command="{Binding DataContext.DecrementPrizeRowQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Padding="0" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Quantity}"
                                                               Width="28"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource GameTextPrimaryBrush}"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource GameOutlineButtonStyle}"
                                                            Content="+"
                                                            Command="{Binding DataContext.IncrementPrizeRowQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Padding="0" FontWeight="Bold" />
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource GameGhostButtonStyle}"
                                                        Command="{Binding DataContext.RemoveLadderPrizeRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Padding="0"
                                                        ToolTip="상품 행 삭제">
                                                    <Path Data="{StaticResource IconCloseGeometry}" Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource GameTextMutedBrush}" StrokeThickness="2" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 상품 추가 + 인원/수량 배정 진행률 바 -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,10">
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Left"
                                        Style="{StaticResource GameOutlineButtonStyle}"
                                        Command="{Binding AddLadderPrizeRowCommand}"
                                        Content="+ 상품 추가"
                                        Padding="10,4"
                                        FontSize="11.5" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,0,8,0">
                                        <Run Text="참가 예정 " /><Run Text="{Binding LadderTargetSlotCount, Mode=OneWay}" FontWeight="Bold" /><Run Text="명" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding LadderPrizeAllocationText}" FontSize="11.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLadderPrizeAllocationMatched}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource GameLossBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar Minimum="0"
                                         Maximum="1"
                                         Height="6"
                                         Value="{Binding LadderPrizeAllocationRatio, Mode=OneWay}"
                                         Background="{StaticResource GameSubtleFillBrush}"
                                         BorderThickness="0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLadderPrizeAllocationMatched}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource GameLossBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>

                        <!-- 참가비 선택 세그먼트 -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="참가비" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,0,0,6" />
                            <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="무료 (0코인)" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="10,6"
                                                 IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=0}" />
                                    <RadioButton Content="10 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="10,6"
                                                 IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=10}" />
                                    <RadioButton Content="30 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="10,6"
                                                 IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=30}" />
                                    <RadioButton Content="50 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="LadderFeeGroup" Padding="10,6"
                                                 IsChecked="{Binding LadderEntryFee, Converter={StaticResource EnumEquals}, ConverterParameter=50}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="무료 모드에서는 코인이 차감·지급·환불되지 않으며, 유료 모드에서는 잭팟 당첨 시 참가비를 획득합니다."
                                       FontSize="11"
                                       Foreground="{StaticResource GameTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 솔로 사다리 4칸 미니게임 뷰 -->
            <games:SoloLadderView Grid.Row="1"
                                  Grid.RowSpan="2"
                                  Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource InvBoolToVis}}" />

            <!-- 단체 사다리 하단 실행 버튼 -->
            <DockPanel Grid.Row="2"
                       Margin="0,12,0,0"
                       LastChildFill="False"
                       Visibility="{Binding IsLadderMultiplayerMode, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding LadderStatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="470"
                           TextTrimming="CharacterEllipsis" />

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GamePrimaryButtonStyle}"
                        Command="{Binding OpenLadderRoomCommand}"
                        IsEnabled="{Binding CanOpenLadderRoom}"
                        Content="친구 초대 방 열기"
                        MinWidth="168"
                        Height="40" />
            </DockPanel>
        </Grid>

        <!-- 2단계: 참가자 대기실 (9상태 카드 + 개별 취소 + 인원 변동 상품 재조정/동의) -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Lobby}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding LadderLobbySummaryText}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                        <TextBlock x:Name="LobbyPrizeText" Text="{Binding LadderRoomPrizesText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding LadderInvitedTotalText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                        </Border>
                        <Border Background="{StaticResource GameWinSoftBrush}" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding LadderJoinedCountText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameWinBrush}" />
                        </Border>
                        <Border Background="{StaticResource GameCoinSoftBrush}" BorderBrush="{StaticResource GameCoinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,4"
                                Visibility="{Binding LadderLobbyRemainingText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding LadderLobbyRemainingText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 9종 상태 참가자 카드 그리드 -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LadderParticipantCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource GameSubtleFillBrush}"
                                            BorderBrush="{StaticResource GameDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,10"
                                            Width="196"
                                            Margin="0,0,10,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="White">
                                                    <Image Source="{Binding Portrait}" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Border Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" Background="{StaticResource GamePinkSoftBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                                        <TextBlock Text="방장" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                                                    </Border>
                                                    <Border Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" Background="White" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="나" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                                            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{Binding StatusBgBrush}"
                                                        CornerRadius="7"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadge}"
                                                               Foreground="{Binding StatusTextBrush}"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </Border>

                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource GameOutlineButtonStyle}"
                                                        Visibility="{Binding CanCancelInvite, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.CancelSingleLadderInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding PetId}"
                                                        Content="취소"
                                                        Padding="8,3"
                                                        FontSize="10.5" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 인원 변동 시 방장 상품 재조정 패널 -->
                    <Border Grid.Row="1"
                            Visibility="{Binding RequiresHostLobbyPrizeAdjustment, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource GameCoinSoftBrush}"
                            BorderBrush="{StaticResource GameCoinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="인원 변동으로 상품 수량을 현재 인원에 맞게 재조정해 주세요."
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GameCoinBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="커피 쏘기" Command="{Binding ApplyCoffeePresetCommand}" Padding="7,3" FontSize="10.5" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="당첨 추첨" Command="{Binding ApplyLuckyDrawPresetCommand}" Padding="7,3" FontSize="10.5" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="코인 잭팟" Command="{Binding ApplyCoinJackpotPresetCommand}" Padding="7,3" FontSize="10.5" />
                                </StackPanel>
                            </DockPanel>

                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LadderPrizeRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" FontSize="12" Padding="6,4" Margin="0,0,6,0" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <Button Style="{StaticResource GameOutlineButtonStyle}" Content="-" Command="{Binding DataContext.DecrementPrizeRowQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Padding="0" />
                                                    <TextBlock Text="{Binding Quantity}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" />
                                                    <Button Style="{StaticResource GameOutlineButtonStyle}" Content="+" Command="{Binding DataContext.IncrementPrizeRowQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Padding="0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource GameGhostButtonStyle}" Command="{Binding DataContext.RemoveLadderPrizeRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Padding="0">
                                                    <Path Data="{StaticResource IconCloseGeometry}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource GameTextMutedBrush}" StrokeThickness="2" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GameOutlineButtonStyle}" Content="+ 상품 추가" Command="{Binding AddLadderPrizeRowCommand}" Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding LadderPrizeAllocationText}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource GamePrimaryButtonStyle}"
                                        Command="{Binding ApplyLobbyPrizeAdjustmentCommand}"
                                        IsEnabled="{Binding IsLadderPrizeAllocationMatched}"
                                        Content="재조정 적용 · 동의 요청"
                                        Padding="12,5"
                                        FontSize="11.5" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 참가자용 변경 상품 동의 배너 -->
                    <Border Grid.Row="2"
                            Visibility="{Binding RequiresGuestPrizeAgreement, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource GamePinkSoftBrush}"
                            BorderBrush="{StaticResource GamePinkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,9"
                            Margin="0,8,0,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding LadderPrizeAgreementBannerText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GamePinkBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="450"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource GamePrimaryButtonStyle}"
                                    Command="{Binding AgreeAdjustedPrizesCommand}"
                                    Content="변경된 상품 동의"
                                    Padding="12,6"
                                    FontSize="11.5" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="10" Padding="10,7" Margin="0,8,0,0">
                        <TextBlock Text="응답 완료 후 60초 내 방장이 '참가자 확정'을 누르면 30초 동안 시작 위치를 선택할 수 있습니다. (단절 유예 10초)"
                                   FontSize="11"
                                   Foreground="{StaticResource GameTextSecondaryBrush}"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LadderStatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GameDangerButtonStyle}"
                            Command="{Binding CancelLadderRoomCommand}"
                            IsEnabled="{Binding CanCancelLadderRoom}"
                            Content="방 나가기 / 취소"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button x:Name="LobbyConfirmButton" Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding ConfirmLadderParticipantsCommand}"
                            IsEnabled="{Binding CanConfirmLadderParticipants}"
                            Visibility="{Binding ShowConfirmLadderButton, Converter={StaticResource BoolToVis}}"
                            Content="참가자 확정"
                            MinWidth="148"
                            Height="40" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 3단계: 시작 위치 선택 -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Picking}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,13"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding LadderLobbySummaryText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                        <TextBlock Text="{Binding LadderRoomPrizesText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource GameCoinSoftBrush}" BorderBrush="{StaticResource GameCoinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,6,0"
                                Visibility="{Binding LadderLobbyRemainingText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding LadderLobbyRemainingText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" />
                        </Border>
                        <Border Background="{StaticResource GameFreeSoftBrush}" BorderBrush="{StaticResource GameFreeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5">
                            <TextBlock Text="중복 선택 불가 · 전원 선택 시 시작" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameFreeBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 시작 슬롯 버튼 그리드 -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding LadderSlots}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PickLadderSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ColumnIndex}"
                                        IsEnabled="{Binding CanPick}"
                                        Margin="4"
                                        Padding="8,14"
                                        MinHeight="146">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GameOutlineButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource GameSubtleFillBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GamePinkSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GamePinkBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanPick}" Value="True">
                                                    <Setter Property="Background" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeaderText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <Border Width="42" Height="42" CornerRadius="12" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" Margin="0,0,0,8" HorizontalAlignment="Center"
                                                Visibility="{Binding OccupantPortrait, Converter={StaticResource NullToVis}}">
                                            <Image Source="{Binding OccupantPortrait}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding OccupantText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="92" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 참가자별 선택 진행 배지 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LadderParticipantCards}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="10,5" Margin="4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LadderStatusText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GameDangerButtonStyle}"
                            Command="{Binding CancelLadderRoomCommand}"
                            IsEnabled="{Binding CanCancelLadderRoom}"
                            Content="취소"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding StartLadderRoomCommand}"
                            IsEnabled="{Binding CanStartLadderGame}"
                            Visibility="{Binding ShowStartLadderButton, Converter={StaticResource BoolToVis}}"
                            Content="게임 시작"
                            MinWidth="148"
                            Height="40" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 4단계: 사다리 진행 (사다리판 최대화, 설정/대기실 숨김, 하단 도착 시 개별 공개) -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Running}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,9"
                    Margin="0,0,0,10">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding LadderBoardPrizesSummaryText}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding LadderStatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GamePinkBrush}"
                               VerticalAlignment="Center"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 확대된 사다리판 캔버스 -->
            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14,12">
                <Canvas x:Name="LadderCanvas"
                        ClipToBounds="True"
                        SizeChanged="LadderCanvas_SizeChanged" />
            </Border>

            <!-- 하단 도착 시 공개되는 실시간 현황 칩 -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding LadderResultLines}"
                          Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource GameCardBrush}"
                                BorderBrush="{StaticResource GameDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,5"
                                Margin="3">
                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 5단계: 최종 결과 화면 -->
        <Grid Visibility="{Binding LadderStage, Converter={StaticResource EnumToVis}, ConverterParameter=Result}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 내 결과 강조 배너 -->
            <Border Grid.Row="0"
                    Background="{StaticResource GamePinkSoftBrush}"
                    BorderBrush="{StaticResource GamePinkBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="18"
                    Padding="20,14"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LadderResultHeadline}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LadderResultSettlementText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right"
                            Background="White"
                            BorderBrush="{StaticResource GamePinkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Visibility="{Binding LadderMyResultPrizeText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding LadderMyResultPrizeText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- 전체 참가자 결과 카드 리스트 -->
            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LadderResultCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="13" Padding="12,10" Margin="0,0,0,7" BorderThickness="1.2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource GameSubtleFillBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource GameDividerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GamePinkSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GamePinkBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="White" Margin="0,0,10,0">
                                                <Image Source="{Binding Portrait}" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                                    <Border Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" Background="{StaticResource GamePinkBrush}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="나" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="11" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" CornerRadius="10" Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrizeText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 하단 결과 조작 -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding LadderStatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GameSecondaryButtonStyle}"
                            Command="{Binding ShareLadderResultToFriendsCommand}"
                            IsEnabled="{Binding CanShareLadderResult}"
                            Margin="0,0,8,0"
                            Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShareGeometry}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource GameTextPrimaryBrush}" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="결과 공유" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GameSecondaryButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}"
                            Content="게임 목록"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding ResetLadderToSetupCommand}"
                            Content="다시 하기"
                            MinWidth="124"
                            Height="40" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
