<UserControl x:Class="LabPet.Client.Views.Games.OneToOneInviteWaitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <ScrollViewer x:Name="InviteWaitScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <Border Style="{StaticResource HubCardStyle}"
            Padding="22"
            MaxWidth="640"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
        <StackPanel>
            <!-- 상단: 게임 종류 및 참가 코인 -->
            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource GamePinkSoftBrush}"
                            BorderBrush="{StaticResource GamePinkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,8,0">
                        <TextBlock Text="1:1 초대 대기" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HubAccentTextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding GameTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="{StaticResource GameCoinSoftBrush}"
                        BorderBrush="{StaticResource GameCoinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCoinGeometry}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Stroke="{StaticResource GameCoinBrush}"
                              StrokeThickness="2"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WagerBadgeText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GameCoinBrush}" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- 중앙 3열: 좌측 내 펫 / 중앙 VS · 대기 애니메이션 / 우측 상대방 펫 -->
            <Border Background="{StaticResource GameSubtleFillBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,20"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 내 펫 프로필 및 준비 상태 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="76" Height="76"
                                CornerRadius="38"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource GamePinkBrush}"
                                BorderThickness="2"
                                Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding MyPetInitial}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HubAccentTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding MyPetPortrait, Converter={StaticResource HubNullToVis}, ConverterParameter=Invert, FallbackValue=Visible}" />
                                <Image Source="{Binding MyPetPortrait}"
                                       Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding MyPetName}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GameTextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="165" />
                        <Border Background="{StaticResource GameWinSoftBrush}"
                                BorderBrush="#FFBBF7D0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,3"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MyReadyStatusText}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameWinBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- 중앙: VS + 대기 맥동 애니메이션 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse x:Name="PulseRing"
                                     Width="62" Height="62"
                                     Stroke="{StaticResource GamePinkBorderBrush}"
                                     StrokeThickness="2"
                                     Fill="{StaticResource GamePinkSoftBrush}"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="0.94" To="1.08" Duration="0:0:0.9" />
                                                <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="0.94" To="1.08" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="VS"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource HubAccentTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource GamePinkBrush}" Margin="0,0,5,0" Opacity="0.35">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource GamePinkBrush}" Margin="0,0,5,0" Opacity="0.35">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource GamePinkBrush}" Opacity="0.35">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </StackPanel>
                    </StackPanel>

                    <!-- 우측: 상대방 펫 프로필 및 응답 상태 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="76" Height="76"
                                CornerRadius="38"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource GameDividerBrush}"
                                BorderThickness="1.5"
                                Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding OpponentInitial}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GameTextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding OpponentPortrait, Converter={StaticResource HubNullToVis}, ConverterParameter=Invert, FallbackValue=Visible}" />
                                <Image Source="{Binding OpponentPortrait}"
                                       Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding OpponentDisplayName}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GameTextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="165" />
                        <Border Background="#FFFFFFFF"
                                BorderBrush="{StaticResource GameDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,3"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OpponentResponseStatusText}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusDetailText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource GameTextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- 하단: 남은 시간 · 진행률 바 · 초대 취소 버튼 -->
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding RemainingTimeText}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubAccentTextBrush}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="양쪽 준비 확인 후 시작"
                           FontSize="11"
                           Foreground="{StaticResource GameTextMutedBrush}" />
            </DockPanel>

            <ProgressBar Maximum="1"
                         Value="{Binding ProgressRatio, Mode=OneWay}"
                         Height="7"
                         Foreground="{StaticResource GamePinkBrush}"
                         Background="{StaticResource GameSubtleFillBrush}"
                         Margin="0,0,0,14" />

            <Button x:Name="CancelInviteWait" Content="초대 취소"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CanCancel}"
                    Style="{StaticResource GameSecondaryButtonStyle}"
                    Height="38"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
    </ScrollViewer>
</UserControl>
