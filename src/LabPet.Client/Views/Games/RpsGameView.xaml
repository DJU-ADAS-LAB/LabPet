<UserControl x:Class="LabPet.Client.Views.Games.RpsGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LabPet.Client.Views.Controls"
             xmlns:g="clr-namespace:LabPet.Client.Games"
             xmlns:games="clr-namespace:LabPet.Client.Views.Games"
             xmlns:vm="clr-namespace:LabPet.Client.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
        <games:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="RpsMoveChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource GameOutlineButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="14,14" />
            <Setter Property="Height" Value="108" />
        </Style>

        <!-- 내 선택 벡터 아이콘 -->
        <Style x:Key="MyRpsHandPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource GamePinkBrush}" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RpsMySelectedMove}" Value="{x:Static g:RpsMove.Rock}">
                    <Setter Property="Data" Value="{StaticResource IconHandRockGeometry}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RpsMySelectedMove}" Value="{x:Static g:RpsMove.Scissors}">
                    <Setter Property="Data" Value="{StaticResource IconHandScissorsGeometry}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RpsMySelectedMove}" Value="{x:Static g:RpsMove.Paper}">
                    <Setter Property="Data" Value="{StaticResource IconHandPaperGeometry}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 상대 공개 벡터 아이콘 (Result 상태 전까지는 null이므로 항상 숨김) -->
        <Style x:Key="OppRpsHandPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#FF4F46E5" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RpsRevealedOpponentMove}" Value="{x:Static g:RpsMove.Rock}">
                    <Setter Property="Data" Value="{StaticResource IconHandRockGeometry}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RpsRevealedOpponentMove}" Value="{x:Static g:RpsMove.Scissors}">
                    <Setter Property="Data" Value="{StaticResource IconHandScissorsGeometry}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RpsRevealedOpponentMove}" Value="{x:Static g:RpsMove.Paper}">
                    <Setter Property="Data" Value="{StaticResource IconHandPaperGeometry}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1. 대결 설정 화면 (공용 친구 선택 카드 그리드) -->
        <Border Visibility="{Binding IsRpsSetupVisible, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource GameCardBrush}"
                BorderBrush="{StaticResource GameDividerBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="친구와 1:1 가위바위보"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}" />
                    <TextBlock Text="서로 패를 고른 뒤 암호화 검증을 거쳐 동시에 공개합니다. 승리 시 배팅 코인의 2배를 획득합니다."
                               FontSize="12"
                               Foreground="{StaticResource GameTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <StackPanel>
                        <TextBlock Text="상대 친구 선택" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,0,0,6" />
                        <controls:FriendInvitePicker DataContext="{Binding RpsFriendPicker}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="배팅 코인" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,0,0,5" />
                            <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="10 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="RpsWagerGroup" Padding="12,6"
                                                 IsChecked="{Binding RpsWager, Converter={StaticResource EnumEquals}, ConverterParameter=10}" />
                                    <RadioButton Content="30 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="RpsWagerGroup" Padding="12,6"
                                                 IsChecked="{Binding RpsWager, Converter={StaticResource EnumEquals}, ConverterParameter=30}" />
                                    <RadioButton Content="50 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="RpsWagerGroup" Padding="12,6"
                                                 IsChecked="{Binding RpsWager, Converter={StaticResource EnumEquals}, ConverterParameter=50}" />
                                    <RadioButton Content="100 코인" Style="{StaticResource GameSegmentRadioStyle}" GroupName="RpsWagerGroup" Padding="12,6"
                                                 IsChecked="{Binding RpsWager, Converter={StaticResource EnumEquals}, ConverterParameter=100}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Command="{Binding SendRpsInviteCommand}"
                                Content="{Binding RpsInviteButtonText}"
                                MinWidth="176"
                                Height="42"
                                VerticalAlignment="Bottom">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GamePrimaryButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasOnlineFriends}" Value="False" />
                                                <Condition Binding="{Binding IsRpsWaitingResponse}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>

                    <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="10" Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconClockGeometry}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource GamePinkBrush}"
                                  StrokeThickness="2"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RpsStatusText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1-2. 1:1 초대 대기 전용 화면 -->
        <Grid Visibility="{Binding IsRpsWaitViewVisible, Converter={StaticResource BoolToVis}}">
            <games:OneToOneInviteWaitView DataContext="{Binding RpsWaitState}" />
        </Grid>

        <!-- 2. 대결 진행 및 결과 화면 (내 캐릭터 vs 상대 캐릭터) -->
        <Grid Visibility="{Binding IsRpsArenaVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 중앙 대결 카드 -->
            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 배팅 정보 & 비공개 검증 안내 -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Border DockPanel.Dock="Left" Background="{StaticResource GameCoinSoftBrush}" BorderBrush="{StaticResource GameCoinBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,4">
                            <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}">
                                <Run Text="배팅 " />
                                <Run Text="{Binding RpsCurrentMatchWager, Mode=OneWay}" />
                                <Run Text=" 코인 · 승리 시 2배" />
                            </TextBlock>
                        </Border>
                        <Border DockPanel.Dock="Right" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="10,4">
                            <TextBlock Text="양쪽 선택 완료 시 동시 공개" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" />
                        </Border>
                    </DockPanel>

                    <!-- 플레이어 1 vs 플레이어 2 -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 내 펫 & 선택 -->
                        <Border Grid.Column="0"
                                Background="{StaticResource GameSubtleFillBrush}"
                                BorderBrush="{StaticResource GamePinkBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="18"
                                Padding="16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="62" Height="62" CornerRadius="16" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <Image Source="{Binding MyPetPortrait}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding MyDisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,2" />
                                <TextBlock Text="나" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GamePinkBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <Border Width="88" Height="74" CornerRadius="14" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="?" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GameTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RpsMySelectedMove}" Value="{x:Static g:RpsMove.Rock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RpsMySelectedMove}" Value="{x:Static g:RpsMove.Scissors}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RpsMySelectedMove}" Value="{x:Static g:RpsMove.Paper}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Path Style="{StaticResource MyRpsHandPathStyle}" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding RpsMyMoveText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 중앙 VS 배지 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource GamePinkSoftBrush}" BorderBrush="{StaticResource GamePinkBorderBrush}" BorderThickness="1.2">
                                <TextBlock Text="VS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- 상대 펫 & 비공개/공개 상태 -->
                        <Border Grid.Column="2"
                                Background="{StaticResource GameSubtleFillBrush}"
                                BorderBrush="{StaticResource GameDividerBrush}"
                                BorderThickness="1.5"
                                CornerRadius="18"
                                Padding="16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="62" Height="62" CornerRadius="16" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <Image Source="{Binding RpsOpponentPortrait}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding RpsOpponentDisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,2" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="상대 친구" FontSize="11" FontWeight="SemiBold" Foreground="#FF4F46E5" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <Border Width="88" Height="74" CornerRadius="14" Background="White" BorderBrush="{StaticResource GameDividerBrush}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding RpsPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Choosing|WaitingOpponent}">
                                            <TextBlock Text="?" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GameTextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="고르는 중" />
                                                        <Setter Property="Foreground" Value="{StaticResource GameTextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RpsOpponentCommitted}" Value="True">
                                                                <Setter Property="Text" Value="선택 완료" />
                                                                <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Path Style="{StaticResource OppRpsHandPathStyle}" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding RpsOpponentMoveText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding RpsStatusText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GameTextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 하단 상태별 액션 영역 -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <!-- Choosing: 가위 · 바위 · 보 3개 카드 -->
                <UniformGrid Visibility="{Binding RpsPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Choosing}"
                             Columns="3">
                    <Button Style="{StaticResource RpsMoveChoiceButtonStyle}"
                            Command="{Binding ChooseRpsMoveCommand}"
                            CommandParameter="scissors"
                            IsEnabled="{Binding CanChooseRpsMove}"
                            Margin="0,0,7,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconHandScissorsGeometry}" Width="30" Height="30" Stretch="Uniform" Stroke="{StaticResource GameTextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                            <TextBlock Text="가위" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RpsMoveChoiceButtonStyle}"
                            Command="{Binding ChooseRpsMoveCommand}"
                            CommandParameter="rock"
                            IsEnabled="{Binding CanChooseRpsMove}"
                            Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconHandRockGeometry}" Width="30" Height="30" Stretch="Uniform" Stroke="{StaticResource GameTextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                            <TextBlock Text="바위" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RpsMoveChoiceButtonStyle}"
                            Command="{Binding ChooseRpsMoveCommand}"
                            CommandParameter="paper"
                            IsEnabled="{Binding CanChooseRpsMove}"
                            Margin="7,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconHandPaperGeometry}" Width="30" Height="30" Stretch="Uniform" Stroke="{StaticResource GameTextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                            <TextBlock Text="보" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- WaitingOpponent -->
                <Border Visibility="{Binding RpsPhase, Converter={StaticResource EnumToVis}, ConverterParameter=WaitingOpponent}"
                        Background="{StaticResource GameSubtleFillBrush}"
                        CornerRadius="16"
                        Padding="18,16">
                    <TextBlock Text="내 선택이 잠금되었습니다. 상대가 선택을 마치면 암호화 검증 후 동시에 공개됩니다."
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GameTextSecondaryBrush}"
                               TextAlignment="Center" />
                </Border>

                <!-- Result: 승/무/패 정산 강조 & 다시 하기 -->
                <Border Visibility="{Binding RpsPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Result}"
                        CornerRadius="16"
                        BorderThickness="1"
                        Padding="16,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource GameCardBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource GameDividerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RpsLastOutcome}" Value="{x:Static g:RpsOutcome.Win}">
                                    <Setter Property="Background" Value="{StaticResource GameWinSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GameWinBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RpsLastOutcome}" Value="{x:Static g:RpsOutcome.Lose}">
                                    <Setter Property="Background" Value="{StaticResource GameLossSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GameLossBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="무승부" />
                                        <Setter Property="Foreground" Value="{StaticResource GameTextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RpsLastOutcome}" Value="{x:Static g:RpsOutcome.Win}">
                                                <Setter Property="Text" Value="승리!" />
                                                <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RpsLastOutcome}" Value="{x:Static g:RpsOutcome.Lose}">
                                                <Setter Property="Text" Value="패배" />
                                                <Setter Property="Foreground" Value="{StaticResource GameLossBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RpsSettlementText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GameSecondaryButtonStyle}"
                                    Command="{Binding NavigateToDashboardCommand}"
                                    Content="게임 목록"
                                    Height="40"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource GamePrimaryButtonStyle}"
                                    Command="{Binding ResetRpsToSetupCommand}"
                                    Content="새 대결"
                                    MinWidth="124"
                                    Height="40" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
