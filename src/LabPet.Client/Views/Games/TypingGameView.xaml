<UserControl x:Class="LabPet.Client.Views.Games.TypingGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LabPet.Client.Views.Controls"
             xmlns:games="clr-namespace:LabPet.Client.Views.Games"
             xmlns:vm="clr-namespace:LabPet.Client.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
        <games:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- 1. 설정 화면 -->
        <Border Visibility="{Binding IsTypingSetupVisible, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource GameCardBrush}"
                BorderBrush="{StaticResource GameDividerBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="10초 타이핑 대결"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource GameTextPrimaryBrush}" />
                    <TextBlock Text="3초 준비 카운트다운 후 10초 동안 문장을 정확히 입력할 때마다 점수가 오르고 자동으로 다음 문장으로 넘어갑니다."
                               FontSize="12.5"
                               Foreground="{StaticResource GameTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" VerticalAlignment="Stretch" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 친구 1:1 대결 설정 카드 -->
                    <Border Grid.Column="0"
                            Background="{StaticResource GameSubtleFillBrush}"
                            CornerRadius="16"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="친구와 1:1 대결" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                <TextBlock Text="동일한 문장 시드로 10초 동안 겨룹니다." FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,3,0,10" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                <StackPanel>
                                    <TextBlock Text="상대 친구 선택" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,0,0,6" />
                                    <controls:FriendInvitePicker DataContext="{Binding TypingFriendPicker}" />

                                    <TextBlock Text="배팅 코인" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,12,0,6" />
                                    <Border Background="White" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="10" Style="{StaticResource GameSegmentRadioStyle}" GroupName="TypingWagerGroup" Padding="11,5"
                                                         IsChecked="{Binding TypingWager, Converter={StaticResource EnumEquals}, ConverterParameter=10}" />
                                            <RadioButton Content="30" Style="{StaticResource GameSegmentRadioStyle}" GroupName="TypingWagerGroup" Padding="11,5"
                                                         IsChecked="{Binding TypingWager, Converter={StaticResource EnumEquals}, ConverterParameter=30}" />
                                            <RadioButton Content="50" Style="{StaticResource GameSegmentRadioStyle}" GroupName="TypingWagerGroup" Padding="11,5"
                                                         IsChecked="{Binding TypingWager, Converter={StaticResource EnumEquals}, ConverterParameter=50}" />
                                            <RadioButton Content="100" Style="{StaticResource GameSegmentRadioStyle}" GroupName="TypingWagerGroup" Padding="11,5"
                                                         IsChecked="{Binding TypingWager, Converter={StaticResource EnumEquals}, ConverterParameter=100}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="2"
                                    Command="{Binding SendTypingInviteCommand}"
                                    Content="{Binding TypingInviteButtonText}"
                                    Height="42"
                                    Margin="0,12,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GamePrimaryButtonStyle}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasOnlineFriends}" Value="False" />
                                                    <Condition Binding="{Binding IsTypingWaitingResponse}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="False" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 혼자 연습 카드 -->
                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="{StaticResource GameDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource GameWinSoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconKeyboardGeometry}" Width="22" Height="20" Stretch="Uniform" Stroke="{StaticResource GameWinBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="혼자 연습하기" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                <TextBlock Text="코인 소모 없이 3초 준비 후 10초 동안 타자 감각을 익혀 보세요." FontSize="12" Foreground="{StaticResource GameTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>

                            <Button Grid.Row="1"
                                    Style="{StaticResource GameSecondaryButtonStyle}"
                                    Command="{Binding StartSoloTypingPracticeCommand}"
                                    IsEnabled="{Binding TypingPhase, Converter={StaticResource EnumEquals}, ConverterParameter=Setup}"
                                    Content="혼자 연습 시작"
                                    Height="42"
                                    Margin="0,14,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding TypingStatusText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 1-2. 1:1 초대 대기 전용 화면 -->
        <Grid Visibility="{Binding IsTypingWaitViewVisible, Converter={StaticResource BoolToVis}}">
            <games:OneToOneInviteWaitView DataContext="{Binding TypingWaitState}" />
        </Grid>

        <!-- 2. 경기 진행 화면 (카운트다운 / 실시간 대결 / 결과 집계 / 결과) -->
        <Grid Visibility="{Binding IsTypingArenaVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 최상단 10초 대형 타이머 + 실시간 점수 비교 -->
            <Border Grid.Row="0"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 내 펫 & 점수 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource GamePinkSoftBrush}" Margin="0,0,10,0">
                            <Image Source="{Binding MyPetPortrait}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding MyDisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}">
                                <Run Text="{Binding TypingMyScore, Mode=OneWay}" />
                                <Run Text=" 점" FontSize="12.5" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- 중앙 대형 10.0초 타이머 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" MinWidth="180">
                        <TextBlock Text="{Binding TypingTimeLeftText}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GameTextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <ProgressBar Value="{Binding TypingTimeProgress}"
                                     Maximum="1"
                                     Height="7"
                                     Width="168"
                                     Margin="0,4,0,0"
                                     Foreground="{StaticResource GamePinkBrush}"
                                     Background="{StaticResource GameSubtleFillBrush}" />
                    </StackPanel>

                    <!-- 오른쪽: 완료 문장 수 또는 상대 펫 점수 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsTypingSoloMode, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TypingOpponentDisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Right" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FF4F46E5" HorizontalAlignment="Right">
                                    <Run Text="{Binding TypingOpponentScore, Mode=OneWay}" />
                                    <Run Text=" 점" FontSize="12.5" />
                                </TextBlock>
                            </StackPanel>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FFEEF2FF">
                                <Image Source="{Binding TypingOpponentPortrait}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>

                        <Border Visibility="{Binding IsTypingSoloMode, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource GameSubtleFillBrush}"
                                CornerRadius="10"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}">
                                <Run Text="완료 " />
                                <Run Text="{Binding TypingCompletedCount, Mode=OneWay}" Foreground="{StaticResource GamePinkBrush}" />
                                <Run Text=" 문장" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 중앙 핵심 콘텐츠: 3초 카운트다운 OR 글자별 하이라이트 입력 OR 결과 비교 -->
            <Border Grid.Row="1"
                    Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource GameDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="28,22">
                <Grid>
                    <!-- 3초 카운트다운 -->
                    <StackPanel Visibility="{Binding TypingPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Countdown}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Border x:Name="CountdownBadge"
                                Width="96"
                                Height="96"
                                CornerRadius="48"
                                Background="{StaticResource GamePinkSoftBrush}"
                                BorderBrush="{StaticResource GamePinkBorderBrush}"
                                BorderThickness="2"
                                RenderTransformOrigin="0.5,0.5"
                                HorizontalAlignment="Center">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <TextBlock Text="{Binding TypingCountdownValue}"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GamePinkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="키보드 입력을 준비하세요"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GameTextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,4" />
                        <TextBlock Text="카운트다운이 끝나면 첫 문장이 즉시 공개됩니다."
                                   FontSize="12.5"
                                   Foreground="{StaticResource GameTextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 진행 / 상대 결과 집계 중 -->
                    <StackPanel Visibility="{Binding TypingPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Running|WaitingOpponent}"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="9" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}">
                                <Run Text="완료 " />
                                <Run Text="{Binding TypingCompletedCount, Mode=OneWay}" Foreground="{StaticResource GamePinkBrush}" FontWeight="Bold" />
                                <Run Text=" 문장 · 문장을 끝까지 정확히 입력하면 자동으로 넘어갑니다" />
                            </TextBlock>
                        </Border>

                        <!-- 글자별 정답/오답/미입력 하이라이트 문장 카드 -->
                        <Border Background="#FFFAFAFC"
                                BorderBrush="{StaticResource GamePinkBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Padding="22,18"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="PromptHighlightTextBlock"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBox x:Name="TypingInputBox"
                                 Text="{Binding TypingInputText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsTypingRunning}"
                                 Height="48"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Padding="14,8"
                                 TextAlignment="Center"
                                 MaxWidth="520" />
                    </StackPanel>

                    <!-- 최종 점수 비교 및 승패 화면 -->
                    <StackPanel Visibility="{Binding TypingPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Result}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="480">
                        <Border Background="{StaticResource GamePinkSoftBrush}" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="{Binding TypingResultHeadline}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                        </Border>
                        <TextBlock Text="{Binding TypingSettlementText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GameTextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="14" Padding="16,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="내 최종 점수" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TypingMyScore}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource GameTextMutedBrush}" HorizontalAlignment="Center">
                                        <Run Text="완료 " /><Run Text="{Binding TypingCompletedCount, Mode=OneWay}" /><Run Text="문장" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource GameSubtleFillBrush}" CornerRadius="14" Padding="16,14">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding IsTypingSoloMode, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="{Binding TypingOpponentDisplayName}" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TypingOpponentScore}" FontSize="28" FontWeight="Bold" Foreground="#FF4F46E5" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                        <TextBlock Text="상대 최종 점수" FontSize="11" Foreground="{StaticResource GameTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding IsTypingSoloMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="연습 모드" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="무료" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GameWinBrush}" HorizontalAlignment="Center" Margin="0,6,0,2" />
                                        <TextBlock Text="코인 변동 없음" FontSize="11" Foreground="{StaticResource GameTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 하단 상태 / 결과 후 조작 -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding TypingStatusText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GameTextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding TypingPhase, Converter={StaticResource EnumToVis}, ConverterParameter=Result}">
                    <Button Style="{StaticResource GameSecondaryButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}"
                            Content="게임 목록"
                            Height="40"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource GamePrimaryButtonStyle}"
                            Command="{Binding ResetTypingToSetupCommand}"
                            Content="다시 도전"
                            MinWidth="128"
                            Height="40" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
