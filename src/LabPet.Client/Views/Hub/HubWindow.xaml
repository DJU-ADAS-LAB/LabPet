<Window x:Class="LabPet.Client.Views.Hub.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:LabPet.Client.Views.Hub"
        Title="LabPet"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="1080"
        Height="720"
        MinWidth="840"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <hub:ResourceKeyToGeometryConverter x:Key="HubIconConverter" />

        <Style x:Key="HubNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HubTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,0">
                            <Grid>
                                <Border x:Name="ActiveBar"
                                        Width="3"
                                        Height="20"
                                        CornerRadius="1.5"
                                        Background="{StaticResource HubAccentBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="-10,0,0,0"
                                        Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource HubAccentSoftBrush}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource HubAccentTextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource HubSubtleFillBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource HubTextPrimaryBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HubNavItemTemplate">
            <Button Style="{StaticResource HubNavButtonStyle}"
                    Command="{Binding DataContext.NavigateToItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}">
                <Button.ToolTip>
                    <ToolTip Content="{Binding Title}" />
                </Button.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="{Binding IconResourceKey, Converter={StaticResource HubIconConverter}}"
                          Width="17"
                          Height="17"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HubBoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Border x:Name="OuterShellBorder"
                Margin="10"
                Background="{StaticResource HubShellBgBrush}"
                BorderBrush="{StaticResource HubDividerBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Effect="{StaticResource SoftCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 좌측 사이드바 -->
                <Border Grid.Column="0"
                        Background="{StaticResource HubSidebarBgBrush}"
                        BorderBrush="{StaticResource HubDividerBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="18,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 브랜드 + 사이드바 토글 -->
                        <Border Grid.Row="0"
                                Background="Transparent"
                                Padding="10,0"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource HubBoolToVis}}">
                                    <Border Width="8"
                                            Height="8"
                                            CornerRadius="4"
                                            Background="{StaticResource HubAccentBrush}"
                                            Margin="0,0,8,0" />
                                    <TextBlock Text="LabPet"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource HubTextPrimaryBrush}" />
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource GameWindowTitleButtonStyle}"
                                        Command="{Binding ToggleSidebarCommand}"
                                        ToolTip="{Binding SidebarToggleToolTip}"
                                        AutomationProperties.Name="{Binding SidebarToggleToolTip}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSidebarToggleGeometry}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Button>
                            </DockPanel>
                        </Border>

                        <!-- 펫 프로필 카드 -->
                        <Border Grid.Row="1"
                                Margin="8,4,8,8"
                                Padding="8"
                                CornerRadius="12"
                                Background="{StaticResource HubSubtleFillBrush}">
                            <Border.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding PetName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding LevelBadgeText, Mode=OneWay}" />
                                    </TextBlock>
                                </ToolTip>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="9"
                                        Background="White"
                                        BorderBrush="{StaticResource HubDividerBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Image Source="{Binding PetPortrait}"
                                           Margin="2"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource HubBoolToVis}}">
                                    <TextBlock Text="{Binding PetName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource HubTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LevelBadgeText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HubAccentTextBrush}"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 주 메뉴 (7개) -->
                        <ItemsControl x:Name="PrimaryNavList"
                                      Grid.Row="2"
                                      ItemsSource="{Binding PrimaryNavItems}"
                                      ItemTemplate="{StaticResource HubNavItemTemplate}"
                                      Focusable="False" />

                        <!-- 하단 고정 메뉴 (설정 · 정보) -->
                        <StackPanel Grid.Row="4" Margin="0,4,0,8">
                            <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="12,4,12,6" />
                            <ItemsControl x:Name="FooterNavList"
                                          ItemsSource="{Binding FooterNavItems}"
                                          ItemTemplate="{StaticResource HubNavItemTemplate}"
                                          Focusable="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 우측 본문 영역 -->
                <Grid Grid.Column="1" Background="{StaticResource HubContentBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 상단 공용 타이틀바 (48 DIP) -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HubCardBgBrush}"
                            BorderBrush="{StaticResource HubDividerBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0,18,0,0"
                            Padding="24,0,12,0"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 현재 페이지 제목 및 부제목 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderPageTitle"
                                           Text="{Binding CurrentPageTitle}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HubTextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="·"
                                           FontSize="13"
                                           Foreground="{StaticResource HubTextMutedBrush}"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentPageSubtitle}"
                                           FontSize="12"
                                           Foreground="{StaticResource HubTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 우측: 레벨 · 코인 배지 + 창 제어 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource HubAccentSoftBrush}"
                                        BorderBrush="{StaticResource HubAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9,4"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="{Binding LevelBadgeText}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource HubAccentTextBrush}" />
                                </Border>

                                <Border Background="{StaticResource GameCoinSoftBrush}"
                                        BorderBrush="{StaticResource GameCoinBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9,4"
                                        Margin="0,0,12,0"
                                        ToolTip="{Binding CoinsBadgeTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCoinGeometry}"
                                              Width="12.5"
                                              Height="12.5"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource GameCoinBrush}"
                                              StrokeThickness="2"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CoinsBadgeText}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource GameCoinBrush}" />
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource GameWindowTitleButtonStyle}"
                                        Click="MinimizeButton_Click"
                                        ToolTip="최소화"
                                        Margin="0,0,2,0">
                                    <Path Data="{StaticResource IconMinimizeGeometry}"
                                          Width="11"
                                          Height="11"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" />
                                </Button>
                                <Button Style="{StaticResource GameWindowTitleButtonStyle}"
                                        Click="MaximizeRestoreButton_Click"
                                        ToolTip="최대화 / 복원"
                                        Margin="0,0,2,0">
                                    <Path Data="{StaticResource IconMaximizeGeometry}"
                                          Width="11"
                                          Height="11"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" />
                                </Button>
                                <Button Style="{StaticResource GameWindowTitleButtonStyle}"
                                        Click="CloseButton_Click"
                                        ToolTip="닫기">
                                    <Path Data="{StaticResource IconCloseGeometry}"
                                          Width="11"
                                          Height="11"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 상단 슬림 게임 초대 배너 (현재 페이지 작업을 방해하지 않고 표시) -->
                    <StackPanel Grid.Row="1">
                        <Border x:Name="GameInviteBanner" Visibility="{Binding Games.HasIncomingInvite, Converter={StaticResource HubBoolToVis}}"
                                Background="{StaticResource GamePinkSoftBrush}"
                                BorderBrush="{StaticResource GamePinkBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="24,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="White" Margin="0,0,10,0">
                                        <Image Source="{Binding Games.IncomingInvitePortrait}"
                                               Margin="2"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="GameInviteBannerSummary" Text="{Binding Games.IncomingInviteText}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource HubTextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HubAccentTextBrush}" Margin="0,0,8,0">
                                                <Run Text="{Binding Games.IncomingInvite.CostBadgeText, Mode=OneWay, FallbackValue=''}" />
                                                <Run Text=" · 남은 시간 " />
                                                <Run Text="{Binding Games.IncomingInviteRemainingTimeText, Mode=OneWay, FallbackValue='0초'}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource GameWinBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Games.HasIncomingInviteInsufficientCoins}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GameLossBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Games.IncomingInviteEligibilityText, Mode=OneWay, FallbackValue=''}" />
                                            </TextBlock>
                                        </WrapPanel>
                                        <TextBlock Visibility="{Binding Games.ShowIncomingInviteCoinDetails, Converter={StaticResource HubBoolToVis}}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource HubTextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0">
                                            <Run Text="필요 " /><Run Text="{Binding Games.IncomingInviteRequiredCoinsText, Mode=OneWay}" FontWeight="Bold" />
                                            <Run Text=" · 보유 " /><Run Text="{Binding Games.IncomingInviteCurrentCoinsText, Mode=OneWay}" FontWeight="Bold" />
                                            <Run Text=" · 부족 " /><Run Text="{Binding Games.IncomingInviteShortfallText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource GameLossBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GameSecondaryButtonStyle}"
                                            Command="{Binding Games.DeclineIncomingInviteCommand}"
                                            IsEnabled="{Binding Games.CanRespondToIncomingInvite}"
                                            Content="거절"
                                            Padding="12,6"
                                            Margin="0,0,6,0" />
                                    <Button x:Name="GameInviteBannerAccept" Command="{Binding Games.AcceptIncomingInviteCommand}"
                                            IsEnabled="{Binding Games.CanAcceptIncomingInvite}"
                                            Padding="14,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GamePrimaryButtonStyle}">
                                                <Setter Property="Content" Value="수락하고 입장" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Games.HasIncomingInviteInsufficientCoins}" Value="True">
                                                        <Setter Property="Content" Value="코인 부족" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Games.IsAcceptingIncomingInvite}" Value="True">
                                                        <Setter Property="Content" Value="수락 중..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Visibility="{Binding Games.IncomingInviteFeedbackMessage, Converter={StaticResource HubNullToVis}}"
                                Background="{StaticResource HubSubtleFillBrush}"
                                BorderBrush="{StaticResource HubDividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="24,6">
                            <TextBlock Text="{Binding Games.IncomingInviteFeedbackMessage}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HubTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 페이지 본문 (Lazy Loaded ContentControl, 여백 24 DIP) -->
                    <ContentControl x:Name="PageHost"
                                    Grid.Row="2"
                                    Margin="24"
                                    Focusable="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- 8방향 창 크기 조절 Thumb -->
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="7" Cursor="SizeWE" Opacity="0" Tag="Left" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="7" Cursor="SizeWE" Opacity="0" Tag="Right" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="7" Cursor="SizeNS" Opacity="0" Tag="Top" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="7" Cursor="SizeNS" Opacity="0" Tag="Bottom" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" Cursor="SizeNWSE" Opacity="0" Tag="TopLeft" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" Cursor="SizeNESW" Opacity="0" Tag="TopRight" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="SizeNESW" Opacity="0" Tag="BottomLeft" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="SizeNWSE" Opacity="0" Tag="BottomRight" DragDelta="ResizeThumb_DragDelta" />
    </Grid>
</Window>
