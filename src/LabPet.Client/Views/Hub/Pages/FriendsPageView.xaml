<UserControl x:Class="LabPet.Client.Views.Hub.Pages.FriendsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LabPet.Client.Views">

    <UserControl.Resources>
        <!-- 노래 따라하기 상태별 버튼 (비활성 / 따라하기 가능 / 따라하기 중) -->
        <Style x:Key="MusicFollowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource BrandGlowShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFE5E7EB" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="#FF9CA3AF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="True">
                                <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource BrandGradientHoverBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="True">
                    <Setter Property="Background" Value="#FFFFF1F2" />
                    <Setter Property="BorderBrush" Value="#FFFF5D8F" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Foreground" Value="#FFE11D48" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFFE4E6" />
                    <Setter Property="BorderBrush" Value="#FFE11D48" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 세그먼트 전환 + 연결 상태 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <Border DockPanel.Dock="Left"
                    Background="{StaticResource HubSubtleFillBrush}"
                    CornerRadius="12"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FriendsTabRadio"
                                 Content="내 친구 · 노래 따라하기"
                                 Style="{StaticResource HubSegmentRadioStyle}"
                                 GroupName="FriendsSubTabGroup"
                                 IsChecked="True"
                                 Checked="SubTabRadio_Changed"
                                 Padding="14,7" />
                    <RadioButton x:Name="NearbyTabRadio"
                                 Content="주변 · 온라인 펫 탐색"
                                 Style="{StaticResource HubSegmentRadioStyle}"
                                 GroupName="FriendsSubTabGroup"
                                 Checked="SubTabRadio_Changed"
                                 Padding="14,7" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Right"
                    Background="{StaticResource HubCardBgBrush}"
                    BorderBrush="{StaticResource HubDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding RemoteConnectionStatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubTextSecondaryBrush}" />
            </Border>
        </DockPanel>

        <!-- 상태 배너 -->
        <Border Grid.Row="1"
                Background="{StaticResource HubCardBgBrush}"
                BorderBrush="{StaticResource HubDividerBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusBanner}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource HubTextSecondaryBrush}" />
        </Border>

        <!-- 1) 내 친구 · 노래 따라하기 -->
        <Grid x:Name="FriendsSectionPanel" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측 친구 목록 -->
            <Border Grid.Column="0" Style="{StaticResource HubCardStyle}" Padding="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Friends}"
                             SelectedItem="{Binding SelectedFriend}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FriendBg" Background="Transparent" CornerRadius="10" Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="FriendBg" Property="Background" Value="{StaticResource HubAccentSoftBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FriendBg" Property="Background" Value="{StaticResource HubSubtleFillBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding IntimacyText}"
                                                   DockPanel.Dock="Right"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HubAccentTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       Foreground="{StaticResource HubTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Background="#FFEEF2FF"
                                                    BorderBrush="#FFC7D2FE"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="5,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ShowsSleepPose, Converter={StaticResource HubBoolToVis}}">
                                                <views:MiniSleepZzzIndicator />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 친구 0명 Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="아직 추가된 친구가 없어요" FontSize="13" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="'주변 · 온라인 펫 탐색'에서 친구 신청을 보내 보세요." FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 우측 친구 상세 · 3D 프리뷰 · 상호작용 -->
            <Border Grid.Column="2" Style="{StaticResource HubCardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <StackPanel>
                        <Border CornerRadius="14"
                                Height="170"
                                Margin="0,0,0,12"
                                BorderBrush="#FF363E59"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="FriendPreview_MouseLeftButtonDown"
                                MouseMove="FriendPreview_MouseMove"
                                MouseLeftButtonUp="FriendPreview_MouseLeftButtonUp">
                            <Border.Background>
                                <RadialGradientBrush GradientOrigin="0.5,0.38" Center="0.5,0.48" RadiusX="0.72" RadiusY="0.72">
                                    <GradientStop Color="#FF343D5A" Offset="0.0" />
                                    <GradientStop Color="#FF22283C" Offset="0.65" />
                                    <GradientStop Color="#FF171B2A" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Viewport3D x:Name="FriendPreviewViewport"
                                            Width="220"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding HasSelectedFriend, Converter={StaticResource HubBoolToVis}}">
                                    <Viewport3D.Camera>
                                        <PerspectiveCamera Position="0,0.34,8.6"
                                                           LookDirection="0,-0.04,-1"
                                                           UpDirection="0,1,0"
                                                           FieldOfView="36" />
                                    </Viewport3D.Camera>
                                    <ModelVisual3D x:Name="FriendPreviewLights" />
                                    <ModelVisual3D x:Name="FriendPreviewPet" />
                                </Viewport3D>

                                <Grid Width="{Binding Width, ElementName=FriendPreviewViewport}"
                                      HorizontalAlignment="Center" IsHitTestVisible="False"
                                      Visibility="{Binding SelectedFriend.ShowsSleepPose, FallbackValue=Collapsed, Converter={StaticResource HubBoolToVis}}">
                                    <views:SleepZzzOverlay Style="{StaticResource PetSleepBadgeStyle}" />
                                </Grid>

                                <TextBlock Text="왼쪽 목록에서 친구를 선택하면 3D 외형을 미리 볼 수 있습니다"
                                           Foreground="#FFCBD5E1"
                                           FontSize="12.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedFriend}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Content="{Binding SelectedFriend.VisitButtonText, FallbackValue='내 바탕화면에 데려오기'}"
                                        Command="{Binding ToggleVisitDesktopCommand}"
                                        CommandParameter="{Binding SelectedFriend}"
                                        Visibility="{Binding HasSelectedFriend, Converter={StaticResource HubBoolToVis}}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,12,12"
                                        Padding="12,6"
                                        FontSize="12" />
                            </Grid>
                        </Border>

                        <TextBlock Text="말풍선 메시지 (최대 100자)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource HubTextPrimaryBrush}" />
                        <DockPanel Margin="0,6,0,12">
                            <Button DockPanel.Dock="Right"
                                    Content="전송"
                                    Style="{StaticResource GamePrimaryButtonStyle}"
                                    Command="{Binding SendBubbleMessageCommand}"
                                    Width="80"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Height="36" />
                        </DockPanel>

                        <TextBlock Text="퀵 이모지 · 쓰다듬기" FontWeight="Bold" FontSize="13" Foreground="{StaticResource HubTextPrimaryBrush}" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="♥" Command="{Binding SendQuickReactionCommand}" CommandParameter="♥" Width="46" Height="34" Margin="0,0,6,4" />
                            <Button Content="👏" Command="{Binding SendQuickReactionCommand}" CommandParameter="👏" Width="46" Height="34" Margin="0,0,6,4" />
                            <Button Content="🎵" Command="{Binding SendQuickReactionCommand}" CommandParameter="🎵" Width="46" Height="34" Margin="0,0,6,4" />
                            <Button Content="🔥" Command="{Binding SendQuickReactionCommand}" CommandParameter="🔥" Width="46" Height="34" Margin="0,0,10,4" />
                            <Button Content="쓰다듬기 보내기" Command="{Binding SendPetInteractionCommand}" Height="34" />
                        </WrapPanel>

                        <Separator Margin="0,2,0,10" />

                        <TextBlock Text="노래 따라하기" FontWeight="Bold" FontSize="13" Foreground="{StaticResource HubTextPrimaryBrush}" Margin="0,0,0,6" />
                        <Button Content="{Binding SelectedFriend.MusicFollowButtonText, FallbackValue='🎵  음악 재생 중이 아님'}"
                                Style="{StaticResource MusicFollowActionButtonStyle}"
                                Command="{Binding ToggleMusicFollowCommand}"
                                CommandParameter="{Binding SelectedFriend}"
                                IsEnabled="{Binding SelectedFriend.CanFollowMusic, FallbackValue=False}"
                                Height="38"
                                Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource HubToggleSwitchStyle}"
                                  Content="내 PC에서 음악이 재생 중이면 로컬 음악 우선 반응"
                                  IsChecked="{Binding PreferLocalMusicWhenActive}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 2) 주변 · 온라인 펫 탐색 -->
        <Border x:Name="NearbySectionPanel"
                Grid.Row="2"
                Style="{StaticResource HubCardStyle}"
                Visibility="Collapsed">
            <Grid>
                <ListBox x:Name="NearbyPeersList"
                         ItemsSource="{Binding NearbyPeers}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.CanContentScroll="False"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource HubSubtleFillBrush}"
                                    BorderBrush="{StaticResource HubDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,11">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                                            <Border Background="#FFFFF3CD"
                                                    BorderBrush="#FFF59E0B"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,2"
                                                    Margin="8,0,0,0"
                                                    ToolTip="{Binding UpdateTooltip}"
                                                    Visibility="{Binding RequiresUpdate, Converter={StaticResource HubBoolToVis}}">
                                                <TextBlock Text="{Binding UpdateBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFB45309" />
                                            </Border>
                                            <Border Background="#FFE0F2FE"
                                                    CornerRadius="7"
                                                    Padding="7,2"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsMusicActive, Converter={StaticResource HubBoolToVis}}">
                                                <TextBlock Text="🎵 음악 반응 중" FontSize="11" FontWeight="SemiBold" Foreground="#FF0369A1" />
                                            </Border>
                                            <Border Background="#FFEEF2FF"
                                                    BorderBrush="#FFC7D2FE"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,2"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsSleeping, Converter={StaticResource HubBoolToVis}}">
                                                <TextBlock Text="zzz 자는 중" FontSize="11" FontWeight="Bold" Foreground="#FF4F46E5" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SubInfo}" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right"
                                            Content="{Binding FriendRequestButtonText}"
                                            Style="{StaticResource GamePrimaryButtonStyle}"
                                            Command="{Binding DataContext.SendFriendRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanSendFriendRequest}"
                                            Padding="14,7"
                                            VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NearbyPeers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="새로운 주변 · 온라인 LabPet을 찾고 있어요" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="이미 등록된 친구는 '내 친구 · 노래 따라하기' 탭에 표시됩니다." FontSize="12" Foreground="{StaticResource HubTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
