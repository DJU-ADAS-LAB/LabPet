<UserControl x:Class="LabPet.Client.Views.Hub.Pages.GrowthPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel>
            <!-- 레벨 · 경험치 · 활동량 카드 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="레벨 · 경험치 (XP)" Style="{StaticResource HubSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextSecondaryBrush}">
                            <Run Text="Lv." /><Run Text="{Binding Level, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource HubAccentTextBrush}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding Xp, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding RequiredXp, Mode=OneWay}" /><Run Text=" XP" />
                        </TextBlock>
                    </DockPanel>
                    <ProgressBar Height="10"
                                 Maximum="100"
                                 Value="{Binding XpPercent}"
                                 Foreground="{StaticResource HubAccentBrush}"
                                 Background="{StaticResource HubSubtleFillBrush}" />

                    <UniformGrid Columns="4" Margin="0,16,0,0">
                        <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="키보드 입력" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalKeystrokes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="마우스 클릭" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalMouseClicks}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="함께한 시간(분)" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalUptimeMinutes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="완료 뽀모도로" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                                <TextBlock Text="{Binding CompletedPomodoros}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 코인 얻는 방법 안내 카드 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource GameCoinSoftBrush}" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconCoinGeometry}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource GameCoinBrush}"
                                      StrokeThickness="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="코인 획득 방법" Style="{StaticResource HubSectionTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="활동·집중·친구 교류로 자동 적립됩니다" FontSize="11.5" Foreground="{StaticResource HubTextMutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding CoinEarningGuides}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HubSubtleFillBrush}"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Margin="4">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ConditionText}" FontSize="11" Foreground="{StaticResource HubTextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource GameCoinSoftBrush}"
                                                BorderBrush="{StaticResource GameCoinBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="9,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RewardBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 실시간 시스템 오디오 반응 -->
            <Border Style="{StaticResource HubCardStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="시스템 오디오 반응 (WASAPI 루프백)" Style="{StaticResource HubSectionTitleStyle}" />
                        <TextBlock Text="{Binding AudioStatusText}" DockPanel.Dock="Right" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource HubAccentTextBrush}" />
                    </DockPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource HubTextSecondaryBrush}" Margin="0,0,0,14">
                        <Run Text="활성 재생 장치: " /><Run Text="{Binding AudioDeviceName, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="저음 (Bass)" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                    <ProgressBar Height="8" Margin="0,4,0,10" Maximum="100" Value="{Binding BassPercent}" Foreground="{StaticResource HubAccentBrush}" Background="{StaticResource HubSubtleFillBrush}" />

                    <TextBlock Text="중음 (Mid)" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                    <ProgressBar Height="8" Margin="0,4,0,10" Maximum="100" Value="{Binding MidPercent}" Foreground="#FF60A5FA" Background="{StaticResource HubSubtleFillBrush}" />

                    <TextBlock Text="고음 (Treble)" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                    <ProgressBar Height="8" Margin="0,4,0,0" Maximum="100" Value="{Binding TreblePercent}" Foreground="#FFA78BFA" Background="{StaticResource HubSubtleFillBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
