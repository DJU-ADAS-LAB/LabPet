<UserControl x:Class="LabPet.Client.Views.Hub.Pages.PomodoroPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Style="{StaticResource HubCardStyle}" Padding="28">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="460">
                <Grid Width="216" Height="216" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse Stroke="{StaticResource HubSubtleFillBrush}" StrokeThickness="10" />
                    <Ellipse Stroke="{StaticResource HubAccentBrush}"
                             StrokeThickness="10"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             StrokeDashArray="56.55 56.55"
                             StrokeDashOffset="{Binding PomodoroRingDashOffset}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{StaticResource HubAccentSoftBrush}" CornerRadius="9" Padding="11,4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PomodoroPhaseText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource HubAccentTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding PomodoroTimeText}"
                                   HorizontalAlignment="Center"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubTextPrimaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="15분" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="15" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="25분 (기본)" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="25" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="50분" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="50" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button Content="{Binding PomodoroToggleText}"
                            Command="{Binding TogglePomodoroCommand}"
                            Style="{StaticResource GamePrimaryButtonStyle}"
                            Width="156"
                            Height="44"
                            Margin="0,0,10,0" />
                    <Button Content="초기화"
                            Style="{StaticResource GameSecondaryButtonStyle}"
                            Command="{Binding ResetPomodoroCommand}"
                            Width="108"
                            Height="44" />
                </StackPanel>

                <TextBlock Text="{Binding PomodoroRewardPreviewText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource HubTextSecondaryBrush}" />
                <TextBlock Text="다른 페이지로 이동하거나 통합 창을 닫아도 타이머는 백그라운드에서 계속 동작합니다."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           Foreground="{StaticResource HubTextMutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
