<UserControl x:Class="LabPet.Client.Views.Hub.Pages.SeasonalPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel>
            <!-- 안내 배너 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="12"
                            Background="{StaticResource HubAccentSoftBrush}"
                            BorderBrush="{StaticResource HubAccentBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTreeGeometry}"
                              Width="20"
                              Height="20"
                              Stretch="Uniform"
                              Stroke="{StaticResource HubAccentTextBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="시즌 이벤트 · 특별 콘텐츠" Style="{StaticResource HubSectionTitleStyle}" />
                        <TextBlock Text="계절 및 이벤트에 맞춰 실제로 제공되는 전용 콘텐츠를 이곳에서 바로 실행할 수 있습니다."
                                   Style="{StaticResource HubCaptionTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 실행 결과 피드백 -->
            <Border CornerRadius="12"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource HubNullToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFECFDF5" />
                        <Setter Property="BorderBrush" Value="#FFA7F3D0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="#FFFFF1F2" />
                                <Setter Property="BorderBrush" Value="#FFFECDD3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF047857" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#FFBE123C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 등록된 시즌 콘텐츠 카드 목록 -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="52"
                                        Height="52"
                                        CornerRadius="14"
                                        Background="#FFEFFAF3"
                                        BorderBrush="#FFB7E4C7"
                                        BorderThickness="1"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTreeGeometry}"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          Stroke="#FF15803D"
                                          StrokeThickness="1.9"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource HubTextPrimaryBrush}" />
                                        <Border Style="{StaticResource HubBadgeStyle}"
                                                Background="{StaticResource HubAccentSoftBrush}"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding SeasonBadge}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource HubAccentTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource HubCaptionTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="{Binding ActionLabel}"
                                        Style="{StaticResource GamePrimaryButtonStyle}"
                                        Command="{Binding DataContext.LaunchItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="18,10"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
