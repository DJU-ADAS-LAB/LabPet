<UserControl x:Class="LabPet.Client.Views.Hub.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LabPet.Shared.Models;assembly=LabPet.Shared">

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel>
            <!-- 1. 일반 설정 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="일반" Style="{StaticResource HubSectionTitleStyle}" Margin="0,0,0,14" />

                    <CheckBox Style="{StaticResource HubToggleSwitchStyle}"
                              IsChecked="{Binding IsStartupAutoRunEnabled}">
                        <StackPanel>
                            <TextBlock Text="Windows 로그인 시 자동 실행" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="PC를 켜고 로그인하면 바탕화면 펫과 소셜 수신 기능을 자동으로 시작합니다."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="0,14" />

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="바탕화면 펫 위치 초기화" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="펫 창이 화면 구석이나 다른 모니터 밖으로 벗어났을 때 기본 위치로 되돌립니다."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="기본 위치로 복귀"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ResetPetPositionCommand}"
                                Padding="14,8"
                                VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Background="#FFF1F5F9"
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,12,0,0"
                            Visibility="{Binding GeneralStatusMessage, Converter={StaticResource HubNullToVis}}">
                        <TextBlock Text="{Binding GeneralStatusMessage}" FontSize="12" Foreground="{StaticResource HubTextPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. 표시 및 상호작용 설정 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="표시 · 상호작용" Style="{StaticResource HubSectionTitleStyle}" Margin="0,0,0,14" />

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="바탕화면 펫 크기" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PetScalePercentText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubAccentTextBrush}" />
                    </DockPanel>
                    <Slider Minimum="{x:Static models:PetProfile.MinimumPetScale}"
                            Maximum="{x:Static models:PetProfile.MaximumPetScale}"
                            Value="{Binding PetScale}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Margin="0,2,0,10" />

                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="작게 (75%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="0.75"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button Content="기본 (100%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="1.0"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button Content="크게 (125%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="1.25"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button Content="매우 크게 (150%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="1.5"
                                Padding="12,6"
                                FontSize="12" />
                    </WrapPanel>

                    <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="0,2,0,14" />

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="바탕화면 펫 투명도" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PetOpacityPercentText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubAccentTextBrush}" />
                    </DockPanel>
                    <Slider Minimum="0.25"
                            Maximum="1.0"
                            Value="{Binding PetOpacity}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Margin="0,2,0,14" />

                    <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="0,0,0,14" />

                    <CheckBox Style="{StaticResource HubToggleSwitchStyle}"
                              IsChecked="{Binding IsClickThroughEnabled}">
                        <StackPanel>
                            <TextBlock Text="클릭 투과 집중 모드" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="켜면 펫 위를 클릭해도 아래 창으로 통과합니다. 해제하려면 트레이 메뉴나 이 스위치를 사용하세요."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- 3. 데이터 및 저장소 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource HubSubtleFillBrush}" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconFolderGeometry}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource HubTextSecondaryBrush}"
                                  StrokeThickness="1.8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="데이터 · 저장소" Style="{StaticResource HubSectionTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="프로필, 성장 기록, 친구 목록, 창 배치 등 모든 사용자 데이터는 실행 폴더가 아닌 아래 AppData 경로에 원자적으로 저장됩니다."
                               Style="{StaticResource HubCaptionTextStyle}"
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DataDirectoryPath}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HubTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="경로 복사"
                                        Style="{StaticResource GameSecondaryButtonStyle}"
                                        Command="{Binding CopyDataPathCommand}"
                                        Padding="12,7"
                                        Margin="0,0,8,0" />
                                <Button Content="데이터 폴더 열기"
                                        Style="{StaticResource GamePrimaryButtonStyle}"
                                        Command="{Binding OpenDataFolderCommand}"
                                        Padding="14,7" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding DataStatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource HubTextSecondaryBrush}"
                               Visibility="{Binding DataStatusMessage, Converter={StaticResource HubNullToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
