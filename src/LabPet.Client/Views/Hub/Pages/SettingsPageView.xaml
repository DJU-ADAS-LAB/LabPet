<UserControl x:Class="LabPet.Client.Views.Hub.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LabPet.Shared.Models;assembly=LabPet.Shared">

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel>
            <!-- 1. 일반 설정 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="일반" Style="{StaticResource HubSectionTitleStyle}" Margin="0,0,0,14" />

                    <CheckBox Style="{StaticResource HubToggleSwitchStyle}"
                              IsChecked="{Binding IsStartupAutoRunEnabled}">
                        <StackPanel>
                            <TextBlock Text="Windows 로그인 시 자동 실행" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="PC를 켜고 로그인하면 바탕화면 펫과 소셜 수신 기능을 자동으로 시작합니다."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="0,14" />

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="바탕화면 펫 위치 초기화" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="펫 창이 화면 구석이나 다른 모니터 밖으로 벗어났을 때 기본 위치로 되돌립니다."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="기본 위치로 복귀"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ResetPetPositionCommand}"
                                Padding="14,8"
                                VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Background="#FFF1F5F9"
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,12,0,0"
                            Visibility="{Binding GeneralStatusMessage, Converter={StaticResource HubNullToVis}}">
                        <TextBlock Text="{Binding GeneralStatusMessage}" FontSize="12" Foreground="{StaticResource HubTextPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. 표시 및 상호작용 설정 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="표시 · 상호작용" Style="{StaticResource HubSectionTitleStyle}" Margin="0,0,0,14" />

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="바탕화면 펫 크기" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PetScalePercentText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubAccentTextBrush}" />
                    </DockPanel>
                    <Slider Minimum="{x:Static models:PetProfile.MinimumPetScale}"
                            Maximum="{x:Static models:PetProfile.MaximumPetScale}"
                            Value="{Binding PetScale}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Margin="0,2,0,10" />

                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="작게 (75%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="0.75"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button Content="기본 (100%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="1.0"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button Content="크게 (125%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="1.25"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button Content="매우 크게 (150%)"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding ApplyScalePresetCommand}"
                                CommandParameter="1.5"
                                Padding="12,6"
                                FontSize="12" />
                    </WrapPanel>

                    <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="0,2,0,14" />

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="바탕화면 펫 투명도" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PetOpacityPercentText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubAccentTextBrush}" />
                    </DockPanel>
                    <Slider Minimum="0.25"
                            Maximum="1.0"
                            Value="{Binding PetOpacity}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Margin="0,2,0,14" />

                    <Border Height="1" Background="{StaticResource HubHairlineBrush}" Margin="0,0,0,14" />

                    <CheckBox Style="{StaticResource HubToggleSwitchStyle}"
                              IsChecked="{Binding IsClickThroughEnabled}">
                        <StackPanel>
                            <TextBlock Text="클릭 투과 집중 모드" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="켜면 펫 위를 클릭해도 아래 창으로 통과합니다. 해제하려면 트레이 메뉴나 이 스위치를 사용하세요."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- 3. 네트워크 · Windows 방화벽 -->
            <Border x:Name="NetworkCard" Style="{StaticResource HubCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource HubAccentSoftBrush}" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconShieldGeometry}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource HubAccentTextBrush}"
                                      StrokeThickness="1.9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="네트워크 · 방화벽" Style="{StaticResource HubSectionTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFEF3C7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirewallHardened}" Value="True">
                                            <Setter Property="Background" Value="#FFECFDF5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FirewallStatusBadgeText}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFB45309" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirewallHardened}" Value="True">
                                                <Setter Property="Foreground" Value="#FF047857" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="현재 연결 상태" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                                <TextBlock Text="{Binding ConnectionSummary}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource HubTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="내 친구 코드" FontSize="11.5" Foreground="{StaticResource HubTextSecondaryBrush}" />
                                <TextBlock Text="{Binding FriendCodeText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource HubAccentTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="{Binding FirewallStatusDescription}"
                               Style="{StaticResource HubCaptionTextStyle}"
                               Margin="0,0,0,12" />

                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Windows 방화벽 규칙 등록 (관리자 권한)"
                                Style="{StaticResource GamePrimaryButtonStyle}"
                                Command="{Binding RegisterFirewallRulesCommand}"
                                Padding="16,9"
                                Margin="0,0,8,6" />
                        <Button Content="상태 새로고침"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding RefreshFirewallStatusCommand}"
                                Padding="14,9"
                                Margin="0,0,8,6" />
                        <Button Content="PowerShell 명령 복사"
                                Style="{StaticResource GameSecondaryButtonStyle}"
                                Command="{Binding CopyFirewallCommand}"
                                Padding="14,9"
                                Margin="0,0,0,6" />
                    </WrapPanel>

                    <Border CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,12"
                            Visibility="{Binding NetworkStatusMessage, Converter={StaticResource HubNullToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFECFDF5" />
                                <Setter Property="BorderBrush" Value="#FFA7F3D0" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NetworkStatusIsError}" Value="True">
                                        <Setter Property="Background" Value="#FFFFF1F2" />
                                        <Setter Property="BorderBrush" Value="#FFFECDD3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding NetworkStatusMessage}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF047857" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NetworkStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#FFBE123C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- SmartScreen 안내 -->
                    <Border Background="#FFF8FAFC" BorderBrush="{StaticResource HubDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Windows SmartScreen 안내" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource HubTextPrimaryBrush}" />
                            <TextBlock Text="코드 서명 인증서 없이 배포된 초기 설치 파일에서는 'Windows의 PC 보호' 창이 표시될 수 있습니다. 경고 화면에서 [추가 정보] → [실행]을 선택하면 정상 실행됩니다."
                                       Style="{StaticResource HubCaptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. 데이터 및 저장소 -->
            <Border Style="{StaticResource HubCardStyle}" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource HubSubtleFillBrush}" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconFolderGeometry}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource HubTextSecondaryBrush}"
                                  StrokeThickness="1.8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="데이터 · 저장소" Style="{StaticResource HubSectionTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="프로필, 성장 기록, 친구 목록, 창 배치 등 모든 사용자 데이터는 실행 폴더가 아닌 아래 AppData 경로에 원자적으로 저장됩니다."
                               Style="{StaticResource HubCaptionTextStyle}"
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource HubSubtlePanelStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DataDirectoryPath}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HubTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="경로 복사"
                                        Style="{StaticResource GameSecondaryButtonStyle}"
                                        Command="{Binding CopyDataPathCommand}"
                                        Padding="12,7"
                                        Margin="0,0,8,0" />
                                <Button Content="데이터 폴더 열기"
                                        Style="{StaticResource GamePrimaryButtonStyle}"
                                        Command="{Binding OpenDataFolderCommand}"
                                        Padding="14,7" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding DataStatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource HubTextSecondaryBrush}"
                               Visibility="{Binding DataStatusMessage, Converter={StaticResource HubNullToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
