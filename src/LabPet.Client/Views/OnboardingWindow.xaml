<Window x:Class="LabPet.Client.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="900"
        Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF374151" />
            <Setter Property="Margin" Value="0,14,0,7" />
        </Style>

        <!-- 내부 ScrollViewer를 제거한 ListBox 템플릿: 마우스 휠 스크롤을 바깥 ScrollViewer로 100% 전달 -->
        <Style x:Key="PillListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="PillBorder"
                                            Background="#FFFAFBFD"
                                            BorderBrush="#FFE5EAF2"
                                            BorderThickness="1.5"
                                            CornerRadius="12"
                                            Padding="11,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="PillBorder" Property="Background" Value="#FFFFEEF4" />
                                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="#FFFF5D8F" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="#FFFF9EB5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 바깥 여백(그림자 공간) + 라운드 카드 프레임 -->
    <Border Margin="14"
            Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource SoftCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 (드래그 이동 + 닫기) -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Padding="22,0,14,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrandPinkBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding WindowTitle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"
                            VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- 본문 2컬럼 -->
            <Grid Grid.Row="1" Margin="20,4,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="346" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 좌측: 실시간 360도 3D 턴테이블 미리보기 -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="LabPet"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandPinkBrush}" />
                                <TextBlock Text="마우스로 드래그해 360도 돌려보세요"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="LightStageToggle"
                                          DockPanel.Dock="Right"
                                          Content="☀️ 밝은 무대"
                                          Checked="StageThemeToggle_Changed"
                                          Unchecked="StageThemeToggle_Changed"
                                          Padding="9,5"
                                          FontSize="11"
                                          VerticalAlignment="Center" />
                        </DockPanel>

                        <Border x:Name="PreviewStageBorder"
                                Grid.Row="1"
                                Margin="0,12,0,12"
                                CornerRadius="16"
                                BorderBrush="#FF363E59"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                                MouseMove="PreviewSurface_MouseMove"
                                MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp">
                            <Border.Background>
                                <!-- 기본 다크 스튜디오 무대: 밝은 파스텔 3D 캐릭터와 오라 발광이 또렷하게 대비됨 -->
                                <RadialGradientBrush GradientOrigin="0.5,0.38" Center="0.5,0.48" RadiusX="0.72" RadiusY="0.72">
                                    <GradientStop Color="#FF343D5A" Offset="0.0" />
                                    <GradientStop Color="#FF22283C" Offset="0.62" />
                                    <GradientStop Color="#FF171B2A" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>

                            <Viewport3D x:Name="PreviewViewport">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera Position="0,0.42,5.65"
                                                       LookDirection="0,-0.07,-1"
                                                       UpDirection="0,1,0"
                                                       FieldOfView="36" />
                                </Viewport3D.Camera>
                                <ModelVisual3D x:Name="PreviewLightsVisual" />
                                <ModelVisual3D x:Name="PreviewPetVisual" />
                            </Viewport3D>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="모션 미리보기"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,7" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="쓰다듬기" Click="PreviewPetMotion_Click" Margin="0,0,6,6" Padding="10,5" FontSize="11.5" />
                                <Button Content="어지러움" Click="PreviewDizzyMotion_Click" Margin="0,0,6,6" Padding="10,5" FontSize="11.5" />
                                <Button Content="앞발 톡톡" Click="PreviewPawTapMotion_Click" Margin="0,0,6,6" Padding="10,5" FontSize="11.5" />
                                <ToggleButton Content="리듬 댄스" IsChecked="{Binding IsRhythmPreviewEnabled}" Margin="0,0,0,6" Padding="10,5" FontSize="11.5" />
                            </WrapPanel>

                            <CheckBox Content="자동 회전" IsChecked="{Binding AutoRotatePreview}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 우측: 펫 이름 및 5개 3D 커스텀 레이어 (부드러운 마우스 휠 스크롤 보장) -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="OptionsScrollViewer"
                                      Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      Padding="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="내 이름 (주인 닉네임)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                                        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" Height="40" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="펫 이름" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                                        <TextBox Text="{Binding PetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" Height="40" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="1. 캐릭터 종" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource PillListBoxStyle}"
                                         ItemsSource="{Binding SpeciesOptions}"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedSpeciesId}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="126">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="#FF1F2430" />
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="2. 바디 컬러" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource PillListBoxStyle}"
                                         ItemsSource="{Binding BodyColorOptions}"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedBodyColorHex}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="16" Height="16" CornerRadius="8"
                                                        Background="{Binding PreviewHex}"
                                                        BorderBrush="#FFD1D5DB" BorderThickness="1"
                                                        Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1F2430" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="포인트 컬러 (볼터치 · 귀 · 악세서리)" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource PillListBoxStyle}"
                                         ItemsSource="{Binding AccentColorOptions}"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedAccentColorHex}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="16" Height="16" CornerRadius="8"
                                                        Background="{Binding PreviewHex}"
                                                        BorderBrush="#FFD1D5DB" BorderThickness="1"
                                                        Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1F2430" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="3. 표정 파츠" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource PillListBoxStyle}"
                                         ItemsSource="{Binding ExpressionOptions}"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedExpressionId}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1F2430" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="4. 머리 소켓 3D 악세서리" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource PillListBoxStyle}"
                                         ItemsSource="{Binding HeadAccessoryOptions}"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedHeadAccessoryId}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1F2430" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="5. 3D 오라 이펙트" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource PillListBoxStyle}"
                                         ItemsSource="{Binding AuraEffectOptions}"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedAuraEffectId}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1F2430" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <DockPanel Margin="0,12,0,4">
                                    <TextBlock Text="6. 바탕화면 펫 크기" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                    <TextBlock Text="{Binding PetScalePercentText}"
                                               DockPanel.Dock="Right"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandPinkBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="0.65"
                                        Maximum="1.45"
                                        Value="{Binding PetScale}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,2,0,8" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="#FFE11D48"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <Button Content="{Binding SubmitButtonText}"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="44" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
