<Window x:Class="LabPet.Client.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LabPet.Client.Views.Controls"
        Title="{Binding WindowTitle}"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="920"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Margin="14"
            Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource SoftCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 (드래그 이동 + 닫기) -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Padding="22,0,14,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrandPinkBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding WindowTitle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"
                            VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- 공용 외형 편집 컨트롤 -->
            <controls:PetAppearanceEditorControl x:Name="EditorControl"
                                                 Grid.Row="1"
                                                 Margin="20,4,20,20" />
        </Grid>
    </Border>
</Window>
