<Window x:Class="LabPet.Client.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="LabPet"
        Width="214"
        Height="274"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- 시스템 트레이 아이콘 (H.NotifyIcon.Wpf) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{Binding TrayTooltip}"
                        NoLeftClickDelay="True"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding UpdateReadyMenuHeader}"
                              Command="{Binding ApplyUpdateAndRestartCommand}"
                              FontWeight="Bold"
                              Foreground="#FFFF5D8F"
                              Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                    <MenuItem Header="💬  소셜 · LAN 친구" Command="{Binding OpenSocialCommand}" />
                    <MenuItem Header="✨  성장 · 뽀모도로 · 3D 상점" Command="{Binding OpenSoloHubCommand}" />
                    <MenuItem Header="🎨  외형 · 이름 변경" Command="{Binding OpenCustomizationCommand}" />
                    <Separator />
                    <MenuItem Header="클릭 투과 집중 모드"
                              IsCheckable="True"
                              IsChecked="{Binding IsClickThroughEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Windows 시작 시 자동 실행"
                              IsCheckable="True"
                              IsChecked="{Binding IsStartupAutoRunEnabled, Mode=TwoWay}" />
                    <MenuItem Header="📍  기본 위치로 복귀" Command="{Binding ResetPositionCommand}" />
                    <Separator />
                    <MenuItem Header="🔄  업데이트 확인" Command="{Binding CheckUpdatesCommand}" />
                    <MenuItem Header="🛡️  방화벽 · 네트워크 안내" Command="{Binding OpenEnvironmentGuideCommand}" />
                    <Separator />
                    <MenuItem Header="⏻  LabPet 종료" Command="{Binding ExitApplicationCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 펫 상단 꼬리 말풍선 (친구 신청 + 일반 알림) -->
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="6,0,6,2">
            <!-- 친구 신청 수락/거절 말풍선 -->
            <StackPanel Visibility="{Binding HasPendingFriendRequest, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <Border Padding="12,8"
                        CornerRadius="14"
                        Background="#FCFFFFFF"
                        BorderBrush="#FFFF6B95"
                        BorderThickness="1.5"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingFriendRequestText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FF1F2430"
                                   TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="수락"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AcceptFriendRequestCommand}"
                                    Padding="12,4"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="거절"
                                    Command="{Binding RejectFriendRequestCommand}"
                                    Padding="12,4"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 12,0 6,7"
                         Fill="#FCFFFFFF"
                         Stroke="#FFFF6B95"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </StackPanel>

            <!-- 일반 꼬리 말풍선 -->
            <StackPanel Visibility="{Binding IsBubbleVisible, Converter={StaticResource BoolToVis}}"
                        IsHitTestVisible="False">
                <Border Padding="12,7"
                        CornerRadius="14"
                        Background="#FAFFFFFF"
                        BorderBrush="#FFFFC2D4"
                        BorderThickness="1.5"
                        Effect="{StaticResource SoftCardShadow}">
                    <TextBlock Text="{Binding BubbleText}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#FF2E3440"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="212" />
                </Border>
                <Polygon Points="0,0 10,0 5,6"
                         Fill="#FAFFFFFF"
                         Stroke="#FFFFC2D4"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 순수 WPF Viewport3D (AllowsTransparency 호환, 에어스페이스 충돌 없음) -->
        <Viewport3D x:Name="PetViewport"
                    Grid.Row="1"
                    ClipToBounds="False"
                    MouseLeftButtonDown="PetViewport_MouseLeftButtonDown"
                    MouseMove="PetViewport_MouseMove"
                    MouseLeftButtonUp="PetViewport_MouseLeftButtonUp">
            <Viewport3D.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding UpdateReadyMenuHeader}"
                              Command="{Binding ApplyUpdateAndRestartCommand}"
                              FontWeight="Bold"
                              Foreground="#FFFF5D8F"
                              Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                    <MenuItem Header="💬  소셜 · LAN 친구" Command="{Binding OpenSocialCommand}" />
                    <MenuItem Header="✨  성장 · 뽀모도로 · 3D 상점" Command="{Binding OpenSoloHubCommand}" />
                    <MenuItem Header="🎨  외형 · 이름 변경" Command="{Binding OpenCustomizationCommand}" />
                    <Separator />
                    <MenuItem Header="클릭 투과 집중 모드"
                              IsCheckable="True"
                              IsChecked="{Binding IsClickThroughEnabled, Mode=TwoWay}" />
                    <MenuItem Header="📍  기본 위치로 복귀" Command="{Binding ResetPositionCommand}" />
                    <Separator />
                    <MenuItem Header="🔄  업데이트 확인" Command="{Binding CheckUpdatesCommand}" />
                    <MenuItem Header="🛡️  방화벽 · 네트워크 안내" Command="{Binding OpenEnvironmentGuideCommand}" />
                    <Separator />
                    <MenuItem Header="⏻  LabPet 종료" Command="{Binding ExitApplicationCommand}" />
                </ContextMenu>
            </Viewport3D.ContextMenu>

            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0.34,5.95"
                                   LookDirection="0,-0.06,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="36" />
            </Viewport3D.Camera>

            <ModelVisual3D x:Name="LightsVisual" />
            <ModelVisual3D x:Name="PetVisual" />
        </Viewport3D>

        <!-- 펫 호버 시 부드럽게 나타나는 미니 글래스 이름표 -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="10,3"
                CornerRadius="10"
                Background="#DCFFFFFF"
                BorderBrush="#FFE8ECF4"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=PetViewport}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TrayTooltip}"
                       FontSize="10.5"
                       FontWeight="Bold"
                       Foreground="#FF4B5563" />
        </Border>
    </Grid>
</Window>
