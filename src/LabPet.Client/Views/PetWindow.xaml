<Window x:Class="LabPet.Client.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LabPet.Shared.Models;assembly=LabPet.Shared"
        xmlns:vm="clr-namespace:LabPet.Client.ViewModels"
        xmlns:views="clr-namespace:LabPet.Client.Views"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="LabPet"
        Width="214"
        Height="252"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MiniActionIconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#FFF3F5FA" />
            <Setter Property="BorderBrush" Value="#FFE5EAF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFEEF4" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFFF9EB5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 노래 따라하기 상태별 미니 아이콘 버튼 (미재생 / 재생 중 / 따라하기 중) -->
        <Style x:Key="MusicFollowMiniButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#FFF3F5FA" />
            <Setter Property="BorderBrush" Value="#FFE5EAF2" />
            <Setter Property="Foreground" Value="#FF4B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 음악 재생 중 (따라하기 가능): 산뜻한 민트 포인트 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMusicActive}" Value="True" />
                        <Condition Binding="{Binding IsFollowingMusic}" Value="False" />
                        <Condition Binding="{Binding CanFollowMusic}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFECFDF5" />
                    <Setter Property="BorderBrush" Value="#FF6EE7B7" />
                    <Setter Property="Foreground" Value="#FF059669" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMusicActive}" Value="True" />
                        <Condition Binding="{Binding IsFollowingMusic}" Value="False" />
                        <Condition Binding="{Binding CanFollowMusic}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFD1FAE5" />
                    <Setter Property="BorderBrush" Value="#FF34D399" />
                </MultiDataTrigger>
                <!-- 노래 따라하기 중: 선명한 브랜드 핑크 솔리드 -->
                <DataTrigger Binding="{Binding IsFollowingMusic}" Value="True">
                    <Setter Property="Background" Value="#FFFF5D8F" />
                    <Setter Property="BorderBrush" Value="#FFF43F78" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="10.5" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFollowingMusic}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF43F78" />
                    <Setter Property="BorderBrush" Value="#FFE11D48" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactAppearanceSlider" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="Rail" Height="2" Margin="7,0" CornerRadius="1"
                                    Background="#FFC9CFDC" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandPinkBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{StaticResource BrandPinkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="PetLayout" Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PetNameplateRow" Height="28" />
        </Grid.RowDefinitions>

        <!-- 시스템 트레이 아이콘 (H.NotifyIcon.Wpf) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{Binding TrayTooltip}"
                        NoLeftClickDelay="True"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown" />

        <!-- 펫 상단 꼬리 말풍선 전용 Popup (창 크기를 바꾸지 않아 메시지 생성/소멸 시 캐릭터가 튕기지 않음) -->
        <Popup x:Name="SpeechBubblePopup"
               PlacementTarget="{Binding ElementName=PetViewport}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None"
               IsOpen="{Binding HasAnyBubble, Mode=OneWay}">
            <StackPanel x:Name="SpeechBubbleContent"
                        Margin="10,10,10,4"
                        HorizontalAlignment="Center"
                        Opacity="{Binding PetOpacity}"
                        SizeChanged="SpeechBubbleContent_SizeChanged">
            <!-- 새 버전 업데이트 확인 말풍선 -->
            <StackPanel Visibility="{Binding IsUpdateBubbleVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <Border Padding="12,8"
                        CornerRadius="14"
                        Background="#FCFFFFFF"
                        BorderBrush="#FFFF6B95"
                        BorderThickness="1.5"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateBubbleText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FF1F2430"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="188" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="업데이트"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallUpdateCommand}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="나중에"
                                    Command="{Binding DismissUpdateBubbleCommand}"
                                    Padding="10,4"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 12,0 6,7"
                         Fill="#FCFFFFFF"
                         Stroke="#FFFF6B95"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </StackPanel>

            <!-- 친구 신청 수락/거절 말풍선 -->
            <StackPanel Visibility="{Binding HasPendingFriendRequest, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <Border Padding="12,8"
                        CornerRadius="14"
                        Background="#FCFFFFFF"
                        BorderBrush="#FFFF6B95"
                        BorderThickness="1.5"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingFriendRequestText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FF1F2430"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="188" />
                        <TextBlock Text="{Binding PendingFriendRequestStatusText}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFDC2626"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="188"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasPendingFriendRequestStatus, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="{Binding AcceptButtonText}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AcceptFriendRequestCommand}"
                                    IsEnabled="{Binding CanClickFriendRequestAction}"
                                    Padding="12,4"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="거절"
                                    Command="{Binding RejectFriendRequestCommand}"
                                    IsEnabled="{Binding CanClickFriendRequestAction}"
                                    Padding="12,4"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 12,0 6,7"
                         Fill="#FCFFFFFF"
                         Stroke="#FFFF6B95"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </StackPanel>

            <!-- 최근 말풍선 최대 5개. 친구 메시지는 보낸 펫의 프로필과 함께 개별 표시한다. -->
            <ItemsControl ItemsSource="{Binding BubbleLines}"
                          Visibility="{Binding IsBubbleVisible, Converter={StaticResource BoolToVis}}"
                          IsHitTestVisible="False">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:BubbleLine}">
                        <StackPanel Margin="0,0,0,3">
                            <Border Padding="11,6"
                                    CornerRadius="14"
                                    Background="#FAFFFFFF"
                                    BorderBrush="#FFFFC2D4"
                                    BorderThickness="1.5"
                                    Effect="{StaticResource SoftCardShadow}">
                                <TextBlock Text="{Binding Text}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FF2E3440"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="188" />
                            </Border>
                            <Polygon Points="0,0 10,0 5,6"
                                     Fill="#FAFFFFFF"
                                     Stroke="#FFFFC2D4"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     Margin="0,-1,0,0" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FriendMessageBubble}">
                        <Grid HorizontalAlignment="Left" MaxWidth="236" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" VerticalAlignment="Top"
                                    CornerRadius="10" Background="#FFFFEEF5"
                                    BorderBrush="#FFF4CFDF" BorderThickness="1">
                                <Image Source="{Binding Portrait}" Margin="2"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border HorizontalAlignment="Left" Background="#FCF9EDF4"
                                        CornerRadius="4" Padding="4,0" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding SenderName}"
                                               Foreground="#FF5D4050"
                                               FontSize="10" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Grid HorizontalAlignment="Left">
                                    <Border Padding="8,4" CornerRadius="4,11,11,11"
                                            Background="#FFFFFAFC" BorderBrush="#FFF1BCD3" BorderThickness="1">
                                        <TextBlock Text="{Binding Text}" Foreground="#FF2E3440"
                                                   FontSize="11.5" TextWrapping="Wrap" />
                                    </Border>
                                    <Path Data="M 5,0 L 0,3.5 5,7"
                                          Fill="#FFFFFAFC" Stroke="#FFF1BCD3"
                                          Margin="-4,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
            </StackPanel>
        </Popup>

        <!-- 순수 WPF Viewport3D (AllowsTransparency 호환, 에어스페이스 충돌 없음) -->
        <Viewport3D x:Name="PetViewport"
                    Grid.Row="0"
                    Height="224"
                    HorizontalAlignment="Center"
                    Opacity="{Binding PetOpacity}"
                    ClipToBounds="False"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    MouseEnter="PetViewport_MouseEnter"
                    MouseLeave="OverlaySurface_MouseLeave"
                    MouseLeftButtonDown="PetViewport_MouseLeftButtonDown"
                    MouseMove="PetViewport_MouseMove"
                    MouseLeftButtonUp="PetViewport_MouseLeftButtonUp"
                    LostMouseCapture="PetViewport_LostMouseCapture">
            <Viewport3D.CacheMode>
                <BitmapCache RenderAtScale="1.5" />
            </Viewport3D.CacheMode>

            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0.30,6.65"
                                   LookDirection="0,-0.02,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="36" />
            </Viewport3D.Camera>

            <ModelVisual3D x:Name="LightsVisual" />
            <ModelVisual3D x:Name="PetVisual" />
        </Viewport3D>

        <!-- 5분 무입력 수면 상태 플로팅 ZZZ 방울 애니메이션 (Viewport 위에 겹치되 클릭을 방해하지 않음) -->
        <Viewbox Grid.Row="0" Width="{Binding Width, ElementName=PetViewport}"
                 HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                 Opacity="{Binding PetOpacity}"
                 Visibility="{Binding IsSleeping, Converter={StaticResource BoolToVis}}">
            <Grid Width="214" Height="90">
                <views:SleepZzzOverlay Style="{StaticResource PetSleepBadgeStyle}" />
            </Grid>
        </Viewbox>

        <!-- 마우스 오버레이 미니멀 주변 친구 퀵 팝업 -->
        <Popup x:Name="FriendOverlayPopup"
               PlacementTarget="{Binding ElementName=PetLayout}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border x:Name="FriendOverlayCard"
                    Width="262"
                    Opacity="{Binding PetOpacity}"
                    Margin="8"
                    Padding="10,9"
                    CornerRadius="15"
                    Background="#F5FFFFFF"
                    BorderBrush="#FFE6EAF2"
                    BorderThickness="1"
                    Effect="{StaticResource MenuShadow}"
                    SizeChanged="FriendOverlayCard_SizeChanged"
                    MouseEnter="OverlaySurface_MouseEnter"
                    MouseLeave="OverlaySurface_MouseLeave">
                <StackPanel>
                    <!-- 미니멀 헤더 -->
                    <DockPanel Margin="2,0,2,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding QuickOverlayHeaderText}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FF4B5563"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="열기"
                                Command="{Binding OpenSocialCommand}"
                                Padding="7,2"
                                FontSize="10.5"
                                Height="20" />
                        <!-- 열기 버튼 왼쪽 뽀모도로 원형 진행 인디케이터 (클릭 시 뽀모도로 창 열기 + 최초 1회 빨간 점) -->
                        <Button x:Name="PomodoroOverlayIndicatorButton"
                                DockPanel.Dock="Right"
                                Command="{Binding OpenPomodoroCommand}"
                                ToolTip="{Binding PomodoroOverlayTooltip}"
                                AutomationProperties.Name="뽀모도로 타이머"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                Focusable="False"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="Root" Background="Transparent" Width="22" Height="22">
                                        <Border x:Name="HoverBg"
                                                CornerRadius="11"
                                                Background="Transparent" />
                                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Ellipse Width="15.6"
                                                     Height="15.6"
                                                     Canvas.Left="2.2"
                                                     Canvas.Top="2.2"
                                                     Stroke="#FFE5EAF2"
                                                     StrokeThickness="2.6" />
                                            <Path x:Name="PomodoroOverlayArcPath"
                                                  Data="{Binding PomodoroOverlayArcGeometry}"
                                                  Stroke="{Binding PomodoroOverlayArcBrush}"
                                                  StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                        <Ellipse x:Name="PomodoroOverlayRedDot"
                                                 Width="6"
                                                 Height="6"
                                                 Fill="#FFEF4444"
                                                 Stroke="White"
                                                 StrokeThickness="1"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Margin="0,0,0,0"
                                                 IsHitTestVisible="False"
                                                 Visibility="{Binding ShowPomodoroFeatureBadge, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HoverBg" Property="Background" Value="#FFFFEEF4" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>

                    <!-- 온라인 친구 목록은 고정 높이를 넘으면 스크롤한다. -->
                    <ScrollViewer MaxHeight="224" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding QuickOverlayEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFAFBFD"
                                        BorderBrush="#FFEEF1F7"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="8,5"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 표시 우선순위: 1) 집중 중(✏️) > 2) 수면(zzz) > 3) 온라인 상태 점 -->
                                                <Grid Grid.Column="0"
                                                      Width="{x:Static views:MiniSleepZzzIndicator.SlotWidth}"
                                                      Height="{x:Static views:MiniSleepZzzIndicator.SlotHeight}"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Background="Transparent"
                                                      ToolTip="{Binding StatusTooltip}"
                                                      AutomationProperties.Name="{Binding StatusTooltip}">
                                                    <TextBlock Text="✏️"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding ShowsFocusIndicator, Converter={StaticResource BoolToVis}}" />
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{Binding StatusDotBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding ShowsOnlineDot, Converter={StaticResource BoolToVis}}" />
                                                    <views:MiniSleepZzzIndicator Visibility="{Binding ShowsSleepIndicator, Converter={StaticResource BoolToVis}}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center" />
                                                </Grid>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayTitle}"
                                                           ToolTip="{Binding DisplayTitle}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF1F2430"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <!-- 메시지 / 인사하기 / 눈던지기 / 노래 따라하기 / 데려오기 -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="💬"
                                                        ToolTip="{Binding MessageTooltip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        IsEnabled="{Binding CanInteract}"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding DataContext.OpenQuickMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="👋"
                                                        ToolTip="{Binding PetTooltip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        IsEnabled="{Binding CanInteract}"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding DataContext.QuickPetFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="{Binding Snowball.Icon, FallbackValue=❄}"
                                                        ToolTip="{Binding Snowball.Tooltip, FallbackValue=눈던지기}"
                                                        AutomationProperties.Name="눈던지기"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding Snowball.Command}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="{Binding MusicButtonIcon}"
                                                        ToolTip="{Binding MusicTooltip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Style="{StaticResource MusicFollowMiniButton}"
                                                        IsEnabled="{Binding CanFollowMusic}"
                                                        Command="{Binding DataContext.QuickToggleMusicFollowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="🏠"
                                                        ToolTip="{Binding VisitTooltip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        IsEnabled="{Binding CanToggleVisit}"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding DataContext.QuickToggleVisitFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <DockPanel Margin="0,6,0,1"
                                                   Background="Transparent"
                                                   MouseEnter="QuickMessageEditor_MouseEnter"
                                                   MouseLeave="QuickMessageEditor_MouseLeave"
                                                   LostMouseCapture="QuickMessageEditor_MouseLeave"
                                                   Visibility="{Binding IsComposingMessage, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right"
                                                    Content="전송"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.SendQuickMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Focusable="False"
                                                    Padding="9,4"
                                                    FontSize="11"
                                                    Margin="5,0,0,0" />
                                            <TextBox Text="{Binding DataContext.QuickMessageText, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding DisplayTitle, StringFormat={}{0}에게 메시지}"
                                                     MaxLength="100"
                                                     Height="28"
                                                     FontSize="11.5"
                                                     Padding="7,3"
                                                     IsVisibleChanged="QuickMessageInput_IsVisibleChanged"
                                                     PreviewMouseDown="QuickMessageInput_PreviewMouseDown"
                                                     LostKeyboardFocus="QuickMessageInput_LostKeyboardFocus"
                                                     KeyDown="QuickMessageInput_KeyDown" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="온라인 친구가 없어요"
                               FontSize="11"
                               Foreground="#FF9CA3AF"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,2"
                               Visibility="{Binding HasNoQuickOverlayEntries, Converter={StaticResource BoolToVis}}" />

                    <!-- 친구 목록 아래 펼치고 접는 크기·투명도 조절 미니 메뉴 -->
                    <Border Margin="0,5,0,0"
                            BorderBrush="#FFEEF1F7"
                            BorderThickness="0,1,0,0"
                            Padding="0,5,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="AppearanceMenuToggle"
                                          Cursor="Hand"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBg"
                                                Background="#FFFAFBFD"
                                                BorderBrush="#FFEEF1F7"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,4">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="크기 · 투명도"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF4B5563"
                                                           VerticalAlignment="Center" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PetScalePercentText}"
                                                               FontSize="10"
                                                               Foreground="#FF6B7280"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text=" · "
                                                               FontSize="10"
                                                               Foreground="#FF9CA3AF"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PetOpacityPercentText}"
                                                               FontSize="10"
                                                               Foreground="#FF6B7280"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="ArrowText"
                                                               Text=" ▾"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#FF6B7280"
                                                               Margin="3,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBg" Property="Background" Value="#FFFFF5F8" />
                                                <Setter TargetName="ToggleBg" Property="BorderBrush" Value="#FFFFC2D4" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ArrowText" Property="Text" Value=" ▴" />
                                                <Setter TargetName="ToggleBg" Property="Background" Value="#FFFFF5F8" />
                                                <Setter TargetName="ToggleBg" Property="BorderBrush" Value="#FFFFC2D4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="AppearanceMenuPanel"
                                    Margin="0,4,0,0"
                                    Padding="8,5"
                                    CornerRadius="9"
                                    Background="#FFFAFBFD"
                                    BorderBrush="#FFEEF1F7"
                                    BorderThickness="1"
                                    Visibility="{Binding IsChecked, ElementName=AppearanceMenuToggle, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="18" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="크기" FontSize="10.5" Foreground="#FF6B7280" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1"
                                            Style="{StaticResource CompactAppearanceSlider}"
                                            AutomationProperties.Name="펫 크기"
                                            Minimum="{x:Static models:PetProfile.MinimumPetScale}"
                                            Maximum="{x:Static models:PetProfile.MaximumPetScale}"
                                            Value="{Binding PetScale, Mode=TwoWay}"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PetScalePercentText}" FontSize="10" FontWeight="SemiBold" Foreground="#FF4B5563" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="투명" FontSize="10.5" Foreground="#FF6B7280" VerticalAlignment="Center" />
                                    <Slider Grid.Row="1" Grid.Column="1"
                                            Style="{StaticResource CompactAppearanceSlider}"
                                            AutomationProperties.Name="펫 투명도"
                                            Minimum="0.25"
                                            Maximum="1.0"
                                            Value="{Binding PetOpacity, Mode=TwoWay}"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="4,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PetOpacityPercentText}" FontSize="10" FontWeight="SemiBold" Foreground="#FF4B5563" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 이름·레벨 바는 펫과 미니 키보드를 가리지 않도록 하단에 단독 표시된다. -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                Opacity="{Binding PetOpacity}">
            <StackPanel x:Name="PetControls"
                        Background="Transparent"
                        Opacity="0"
                        IsHitTestVisible="False"
                        MouseEnter="OverlaySurface_MouseEnter"
                        MouseLeave="OverlaySurface_MouseLeave"
                        LostMouseCapture="OverlaySurface_MouseLeave">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="PetNameplateOffset" />
                </StackPanel.RenderTransform>
                <Border HorizontalAlignment="Center"
                        Padding="10,2"
                        CornerRadius="10"
                        Background="#DCFFFFFF"
                        BorderBrush="#FFE8ECF4"
                        BorderThickness="1">
                    <TextBlock Text="{Binding TrayTooltip}"
                               FontSize="10.5"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#FF4B5563" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
