<Window x:Class="LabPet.Client.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LabPet.Shared.Models;assembly=LabPet.Shared"
        xmlns:vm="clr-namespace:LabPet.Client.ViewModels"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="LabPet"
        Width="214"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MiniActionIconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#FFF3F5FA" />
            <Setter Property="BorderBrush" Value="#FFE5EAF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFEEF4" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFFF9EB5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactAppearanceSlider" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="Rail" Height="2" Margin="7,0" CornerRadius="1"
                                    Background="#FFC9CFDC" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandPinkBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{StaticResource BrandPinkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="PetLayout" Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PetMessageRow" Height="Auto" MinHeight="78" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PetNameplateRow" Height="62" />
        </Grid.RowDefinitions>

        <!-- 시스템 트레이 아이콘 (H.NotifyIcon.Wpf) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{Binding TrayTooltip}"
                        NoLeftClickDelay="True"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding UpdateReadyMenuHeader}"
                              Command="{Binding ApplyUpdateAndRestartCommand}"
                              FontWeight="Bold"
                              Foreground="#FFFF5D8F"
                              Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                    <MenuItem Header="💬  친구" Command="{Binding OpenSocialCommand}" />
                    <MenuItem Header="✨  성장 · 뽀모도로 · 3D 상점" Command="{Binding OpenSoloHubCommand}" />
                    <MenuItem Header="🎨  외형 · 이름 변경" Command="{Binding OpenCustomizationCommand}" />
                    <MenuItem Header="🔍  크기 조절">
                        <MenuItem Header="아주 작게 (50%)" Command="{Binding SetPetScaleCommand}" CommandParameter="0.5" />
                        <MenuItem Header="작게 (75%)" Command="{Binding SetPetScaleCommand}" CommandParameter="0.75" />
                        <MenuItem Header="보통 (100%)" Command="{Binding SetPetScaleCommand}" CommandParameter="1.0" />
                        <MenuItem Header="크게 (125%)" Command="{Binding SetPetScaleCommand}" CommandParameter="1.25" />
                        <MenuItem Header="아주 크게 (150%)" Command="{Binding SetPetScaleCommand}" CommandParameter="1.5" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="클릭 투과 집중 모드"
                              IsCheckable="True"
                              IsChecked="{Binding IsClickThroughEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Windows 시작 시 자동 실행"
                              IsCheckable="True"
                              IsChecked="{Binding IsStartupAutoRunEnabled, Mode=TwoWay}" />
                    <MenuItem Header="📍  기본 위치로 복귀" Command="{Binding ResetPositionCommand}" />
                    <Separator />
                    <MenuItem Command="{Binding CheckUpdatesCommand}">
                        <MenuItem.Header>
                            <StackPanel>
                                <TextBlock Text="🔄  업데이트 확인" />
                                <TextBlock Text="{Binding CurrentVersionText}"
                                           FontSize="10"
                                           Foreground="#FF9CA3AF"
                                           Margin="20,1,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="🛡️  방화벽 · 네트워크 안내" Command="{Binding OpenEnvironmentGuideCommand}" />
                    <Separator />
                    <MenuItem Header="⏻  LabPet 종료" Command="{Binding ExitApplicationCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 펫 상단 꼬리 말풍선 (업데이트 확인 + 친구 신청 + 일반 알림) -->
        <StackPanel Grid.Row="0" Panel.ZIndex="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="6,5,6,2" Opacity="{Binding PetOpacity}">
            <!-- 새 버전 업데이트 확인 말풍선 -->
            <StackPanel Visibility="{Binding IsUpdateBubbleVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <Border Padding="12,8"
                        CornerRadius="14"
                        Background="#FCFFFFFF"
                        BorderBrush="#FFFF6B95"
                        BorderThickness="1.5"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateBubbleText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FF1F2430"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="188" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="업데이트"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ApplyUpdateAndRestartCommand}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="나중에"
                                    Command="{Binding DismissUpdateBubbleCommand}"
                                    Padding="10,4"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 12,0 6,7"
                         Fill="#FCFFFFFF"
                         Stroke="#FFFF6B95"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </StackPanel>

            <!-- 친구 신청 수락/거절 말풍선 -->
            <StackPanel Visibility="{Binding HasPendingFriendRequest, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <Border Padding="12,8"
                        CornerRadius="14"
                        Background="#FCFFFFFF"
                        BorderBrush="#FFFF6B95"
                        BorderThickness="1.5"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingFriendRequestText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FF1F2430"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="188" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="수락"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AcceptFriendRequestCommand}"
                                    Padding="12,4"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="거절"
                                    Command="{Binding RejectFriendRequestCommand}"
                                    Padding="12,4"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Polygon Points="0,0 12,0 6,7"
                         Fill="#FCFFFFFF"
                         Stroke="#FFFF6B95"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </StackPanel>

            <!-- 최근 말풍선 최대 5개. 친구 메시지는 보낸 펫의 프로필과 함께 개별 표시한다. -->
            <ItemsControl ItemsSource="{Binding BubbleLines}"
                          Visibility="{Binding IsBubbleVisible, Converter={StaticResource BoolToVis}}"
                          IsHitTestVisible="False">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:BubbleLine}">
                        <StackPanel Margin="0,0,0,3">
                            <Border Padding="11,6"
                                    CornerRadius="14"
                                    Background="#FAFFFFFF"
                                    BorderBrush="#FFFFC2D4"
                                    BorderThickness="1.5"
                                    Effect="{StaticResource SoftCardShadow}">
                                <TextBlock Text="{Binding Text}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FF2E3440"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="188" />
                            </Border>
                            <Polygon Points="0,0 10,0 5,6"
                                     Fill="#FAFFFFFF"
                                     Stroke="#FFFFC2D4"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     Margin="0,-1,0,0" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FriendMessageBubble}">
                        <Grid HorizontalAlignment="Left" MaxWidth="236" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" VerticalAlignment="Top"
                                    CornerRadius="10" Background="#FFFFEEF5"
                                    BorderBrush="#FFF4CFDF" BorderThickness="1">
                                <Image Source="{Binding Portrait}" Margin="2"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border HorizontalAlignment="Left" Background="#FCF9EDF4"
                                        CornerRadius="4" Padding="4,0" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding SenderName}"
                                               Foreground="#FF5D4050"
                                               FontSize="10" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Grid HorizontalAlignment="Left">
                                    <Border Padding="8,4" CornerRadius="4,11,11,11"
                                            Background="#FFFFFAFC" BorderBrush="#FFF1BCD3" BorderThickness="1">
                                        <TextBlock Text="{Binding Text}" Foreground="#FF2E3440"
                                                   FontSize="11.5" TextWrapping="Wrap" />
                                    </Border>
                                    <Path Data="M 5,0 L 0,3.5 5,7"
                                          Fill="#FFFFFAFC" Stroke="#FFF1BCD3"
                                          Margin="-4,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </StackPanel>

        <!-- 순수 WPF Viewport3D (AllowsTransparency 호환, 에어스페이스 충돌 없음) -->
        <Viewport3D x:Name="PetViewport"
                    Grid.Row="1"
                    Height="172"
                    HorizontalAlignment="Center"
                    Opacity="{Binding PetOpacity}"
                    ClipToBounds="False"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    MouseEnter="PetViewport_MouseEnter"
                    MouseLeave="OverlaySurface_MouseLeave"
                    MouseLeftButtonDown="PetViewport_MouseLeftButtonDown"
                    MouseMove="PetViewport_MouseMove"
                    MouseLeftButtonUp="PetViewport_MouseLeftButtonUp">
            <Viewport3D.CacheMode>
                <BitmapCache RenderAtScale="1.5" />
            </Viewport3D.CacheMode>
            <Viewport3D.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding UpdateReadyMenuHeader}"
                              Command="{Binding ApplyUpdateAndRestartCommand}"
                              FontWeight="Bold"
                              Foreground="#FFFF5D8F"
                              Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                    <MenuItem Header="💬  친구" Command="{Binding OpenSocialCommand}" />
                    <MenuItem Header="✨  성장 · 뽀모도로 · 3D 상점" Command="{Binding OpenSoloHubCommand}" />
                    <MenuItem Header="🎨  외형 · 이름 변경" Command="{Binding OpenCustomizationCommand}" />
                    <MenuItem Header="🔍  크기 조절">
                        <MenuItem Header="아주 작게 (50%)" Command="{Binding SetPetScaleCommand}" CommandParameter="0.5" />
                        <MenuItem Header="작게 (75%)" Command="{Binding SetPetScaleCommand}" CommandParameter="0.75" />
                        <MenuItem Header="보통 (100%)" Command="{Binding SetPetScaleCommand}" CommandParameter="1.0" />
                        <MenuItem Header="크게 (125%)" Command="{Binding SetPetScaleCommand}" CommandParameter="1.25" />
                        <MenuItem Header="아주 크게 (150%)" Command="{Binding SetPetScaleCommand}" CommandParameter="1.5" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="클릭 투과 집중 모드"
                              IsCheckable="True"
                              IsChecked="{Binding IsClickThroughEnabled, Mode=TwoWay}" />
                    <MenuItem Header="📍  기본 위치로 복귀" Command="{Binding ResetPositionCommand}" />
                    <Separator />
                    <MenuItem Command="{Binding CheckUpdatesCommand}">
                        <MenuItem.Header>
                            <StackPanel>
                                <TextBlock Text="🔄  업데이트 확인" />
                                <TextBlock Text="{Binding CurrentVersionText}"
                                           FontSize="10"
                                           Foreground="#FF9CA3AF"
                                           Margin="20,1,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="🛡️  방화벽 · 네트워크 안내" Command="{Binding OpenEnvironmentGuideCommand}" />
                    <Separator />
                    <MenuItem Header="⏻  LabPet 종료" Command="{Binding ExitApplicationCommand}" />
                </ContextMenu>
            </Viewport3D.ContextMenu>

            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0.34,5.95"
                                   LookDirection="0,-0.06,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="36" />
            </Viewport3D.Camera>

            <ModelVisual3D x:Name="LightsVisual" />
            <ModelVisual3D x:Name="PetVisual" />
        </Viewport3D>

        <!-- 마우스 오버레이 미니멀 주변 친구 퀵 팝업 -->
        <Popup x:Name="FriendOverlayPopup"
               PlacementTarget="{Binding ElementName=PetLayout}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border x:Name="FriendOverlayCard"
                    Width="262"
                    Opacity="{Binding PetOpacity}"
                    Margin="8"
                    Padding="10,9"
                    CornerRadius="15"
                    Background="#F5FFFFFF"
                    BorderBrush="#FFE6EAF2"
                    BorderThickness="1"
                    Effect="{StaticResource MenuShadow}"
                    MouseEnter="OverlaySurface_MouseEnter"
                    MouseLeave="OverlaySurface_MouseLeave">
                <StackPanel>
                    <!-- 미니멀 헤더 -->
                    <DockPanel Margin="2,0,2,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding QuickOverlayHeaderText}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FF4B5563"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="열기"
                                Command="{Binding OpenSocialCommand}"
                                Padding="7,2"
                                FontSize="10.5"
                                Height="20" />
                    </DockPanel>

                    <!-- 온라인 친구 · 주변 피어 초미니 리스트 -->
                    <ItemsControl ItemsSource="{Binding QuickOverlayEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFAFBFD"
                                        BorderBrush="#FFEEF1F7"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="8,5"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="112">
                                                <Ellipse Width="6" Height="6" Fill="#FF34D399" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF1F2430"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- 친구인 경우: 메시지 / 쓰다듬기 / 노래 따라하기 / 데려오기 -->
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding IsFriend, Converter={StaticResource BoolToVis}}">
                                                <Button Content="💬"
                                                        ToolTip="빠른 메시지"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding DataContext.OpenQuickMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="👋"
                                                        ToolTip="쓰다듬기"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding DataContext.QuickPetFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="🎵"
                                                        ToolTip="{Binding MusicTooltip}"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        IsEnabled="{Binding CanFollowMusic}"
                                                        Command="{Binding DataContext.QuickToggleMusicFollowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,3,0" />
                                                <Button Content="🏠"
                                                        ToolTip="내 바탕화면에 데려오기 / 돌려보내기"
                                                        Style="{StaticResource MiniActionIconButton}"
                                                        Command="{Binding DataContext.QuickToggleVisitFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>

                                            <!-- 주변 미등록 LAN 피어인 경우: + 신청 -->
                                            <Button DockPanel.Dock="Right"
                                                    Content="+ 신청"
                                                    Padding="7,2"
                                                    FontSize="10.5"
                                                    Height="22"
                                                    Command="{Binding DataContext.QuickSendFriendRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanSendFriendRequest, Converter={StaticResource BoolToVis}}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,1"
                                                   Background="Transparent"
                                                   MouseEnter="QuickMessageEditor_MouseEnter"
                                                   MouseLeave="QuickMessageEditor_MouseLeave"
                                                   LostMouseCapture="QuickMessageEditor_MouseLeave"
                                                   Visibility="{Binding IsComposingMessage, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right"
                                                    Content="전송"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.SendQuickMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Focusable="False"
                                                    Padding="9,4"
                                                    FontSize="11"
                                                    Margin="5,0,0,0" />
                                            <TextBox Text="{Binding DataContext.QuickMessageText, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding DisplayTitle, StringFormat={}{0}에게 메시지}"
                                                     MaxLength="100"
                                                     Height="28"
                                                     FontSize="11.5"
                                                     Padding="7,3"
                                                     IsVisibleChanged="QuickMessageInput_IsVisibleChanged"
                                                     PreviewMouseDown="QuickMessageInput_PreviewMouseDown"
                                                     KeyDown="QuickMessageInput_KeyDown" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 주변/친구 없을 때 초미니 1줄 안내 -->
                    <TextBlock Text="주변에 온라인 친구가 없어요"
                               FontSize="11"
                               Foreground="#FF9CA3AF"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,2"
                               Visibility="{Binding HasNoQuickOverlayEntries, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 이름·레벨 바와 외형 조절바가 함께 펫 하단에 표시된다. -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                Opacity="{Binding PetOpacity}">
            <StackPanel x:Name="PetControls"
                        Width="166"
                        Background="Transparent"
                        Opacity="0"
                        IsHitTestVisible="False"
                        MouseEnter="OverlaySurface_MouseEnter"
                        MouseLeave="OverlaySurface_MouseLeave"
                        LostMouseCapture="OverlaySurface_MouseLeave">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="PetNameplateOffset" />
                </StackPanel.RenderTransform>
                <Border HorizontalAlignment="Center"
                        Padding="10,2"
                        CornerRadius="10"
                        Background="#DCFFFFFF"
                        BorderBrush="#FFE8ECF4"
                        BorderThickness="1">
                    <TextBlock Text="{Binding TrayTooltip}"
                               FontSize="10.5"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#FF4B5563" />
                </Border>
                <Border Margin="0,3,0,0"
                        Padding="7,2"
                        CornerRadius="9"
                        Background="#F5FFFFFF"
                        BorderBrush="#FFE6EAF2"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16" />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="크기" FontSize="10.5" Foreground="#FF6B7280" VerticalAlignment="Center" />
                        <Slider Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource CompactAppearanceSlider}"
                                AutomationProperties.Name="펫 크기"
                                Minimum="{x:Static models:PetProfile.MinimumPetScale}"
                                Maximum="{x:Static models:PetProfile.MaximumPetScale}"
                                Value="{Binding PetScale, Mode=TwoWay}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="4,0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PetScalePercentText}" FontSize="10" FontWeight="SemiBold" Foreground="#FF4B5563" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="투명" FontSize="10.5" Foreground="#FF6B7280" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1"
                                Style="{StaticResource CompactAppearanceSlider}"
                                AutomationProperties.Name="펫 투명도"
                                Minimum="0.25"
                                Maximum="1.0"
                                Value="{Binding PetOpacity, Mode=TwoWay}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="4,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PetOpacityPercentText}" FontSize="10" FontWeight="SemiBold" Foreground="#FF4B5563" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
