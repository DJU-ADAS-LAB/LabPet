<Window x:Class="LabPet.Client.Views.SocialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabPet · 친구"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="820"
        Height="630"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 노래 따라하기 상태별 버튼 (비활성 / 따라하기 가능 / 따라하기 중) -->
        <Style x:Key="MusicFollowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource BrandGlowShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFE5E7EB" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="#FF9CA3AF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="True">
                                <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 따라하기 가능 상태 호버 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource BrandGradientHoverBrush}" />
                </MultiDataTrigger>
                <!-- 노래 따라하기 중: 로즈 아웃라인 중지 버튼 -->
                <DataTrigger Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="True">
                    <Setter Property="Background" Value="#FFFFF1F2" />
                    <Setter Property="BorderBrush" Value="#FFFF5D8F" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Foreground" Value="#FFE11D48" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedFriend.IsFollowingMusic, FallbackValue=False}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFFE4E6" />
                    <Setter Property="BorderBrush" Value="#FFE11D48" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource SoftCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Padding="22,0,14,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrandPinkBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="친구" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" />
                </DockPanel>
            </Border>

            <!-- 상태 배너 -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,10"
                    Margin="20,2,20,12">
                <TextBlock Text="{Binding StatusBanner}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <!-- 친구 탭 (기본 화면: 이미 추가된 친구) -->
            <TabControl Grid.Row="2" Margin="20,0,20,20">
                <TabItem Header="친구 &amp; 노래 따라하기">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="256" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFFAFBFD"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <Grid>
                                <ListBox ItemsSource="{Binding Friends}"
                                         SelectedItem="{Binding SelectedFriend}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="FriendBg" Background="Transparent" CornerRadius="10" Padding="10,8">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="FriendBg" Property="Background" Value="{StaticResource BrandPinkSoftBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="FriendBg" Property="Background" Value="#FFF3F5FA" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding IntimacyText}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPinkBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 친구 0명일 때 Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="🐾" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="아직 추가된 친구가 없어요" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="'주변 펫 (LAN)' 탭에서 신청해 보세요" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FFFAFBFD"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                <StackPanel>
                                    <!-- 선택한 친구 실시간 3D 외형 미리보기 + 바탕화면 데려오기 -->
                                    <Border CornerRadius="14"
                                            Height="162"
                                            Margin="0,0,0,12"
                                            BorderBrush="#FF363E59"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="FriendPreview_MouseLeftButtonDown"
                                            MouseMove="FriendPreview_MouseMove"
                                            MouseLeftButtonUp="FriendPreview_MouseLeftButtonUp">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0.5,0.38" Center="0.5,0.48" RadiusX="0.72" RadiusY="0.72">
                                                <GradientStop Color="#FF343D5A" Offset="0.0" />
                                                <GradientStop Color="#FF22283C" Offset="0.65" />
                                                <GradientStop Color="#FF171B2A" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>

                                        <Grid>
                                            <Viewport3D x:Name="FriendPreviewViewport"
                                                        Visibility="{Binding HasSelectedFriend, Converter={StaticResource BoolToVis}}">
                                                <Viewport3D.Camera>
                                                    <PerspectiveCamera Position="0,0.38,5.55"
                                                                       LookDirection="0,-0.07,-1"
                                                                       UpDirection="0,1,0"
                                                                       FieldOfView="36" />
                                                </Viewport3D.Camera>
                                                <ModelVisual3D x:Name="FriendPreviewLights" />
                                                <ModelVisual3D x:Name="FriendPreviewPet" />
                                            </Viewport3D>

                                            <!-- 친구 미선택 시 안내 -->
                                            <TextBlock Text="왼쪽에서 친구를 선택하면 3D 외형이 표시됩니다"
                                                       Foreground="#FFCBD5E1"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedFriend}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 우하단 바탕화면 데려오기 버튼 -->
                                            <Button Content="{Binding SelectedFriend.VisitButtonText, FallbackValue='내 바탕화면에 데려오기'}"
                                                    Command="{Binding ToggleVisitDesktopCommand}"
                                                    CommandParameter="{Binding SelectedFriend}"
                                                    Visibility="{Binding HasSelectedFriend, Converter={StaticResource BoolToVis}}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,10,10"
                                                    Padding="11,5"
                                                    FontSize="11.5" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="말풍선 메시지 (최대 100자 · TCP ACK)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <DockPanel Margin="0,8,0,14">
                                        <Button DockPanel.Dock="Right"
                                                Content="전송"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SendBubbleMessageCommand}"
                                                Width="76"
                                                Margin="8,0,0,0" />
                                        <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="100"
                                                 Height="38" />
                                    </DockPanel>

                                    <TextBlock Text="퀵 이모지 &amp; 쓰다듬기" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Content="♥" Command="{Binding SendQuickReactionCommand}" CommandParameter="♥" Width="46" Height="34" Margin="0,0,6,6" />
                                        <Button Content="👏" Command="{Binding SendQuickReactionCommand}" CommandParameter="👏" Width="46" Height="34" Margin="0,0,6,6" />
                                        <Button Content="🎵" Command="{Binding SendQuickReactionCommand}" CommandParameter="🎵" Width="46" Height="34" Margin="0,0,6,6" />
                                        <Button Content="🔥" Command="{Binding SendQuickReactionCommand}" CommandParameter="🔥" Width="46" Height="34" Margin="0,0,10,6" />
                                        <Button Content="쓰다듬기 보내기" Command="{Binding SendPetInteractionCommand}" Height="34" />
                                    </WrapPanel>

                                    <Separator Margin="0,2,0,12" />

                                    <TextBlock Text="노래 따라하기 (30Hz 구독형 유니캐스트)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <Button Content="{Binding SelectedFriend.MusicFollowButtonText, FallbackValue='🎵  음악 재생 중이 아님'}"
                                            Style="{StaticResource MusicFollowActionButtonStyle}"
                                            Command="{Binding ToggleMusicFollowCommand}"
                                            CommandParameter="{Binding SelectedFriend}"
                                            IsEnabled="{Binding SelectedFriend.CanFollowMusic, FallbackValue=False}"
                                            Height="38"
                                            Margin="0,0,0,10" />
                                    <CheckBox Content="내 PC에서 음악이 재생 중이면 로컬 음악 우선 반응"
                                              IsChecked="{Binding PreferLocalMusicWhenActive}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="주변 펫 (LAN)">
                    <Grid>
                        <ListBox x:Name="NearbyPeersList"
                                 ItemsSource="{Binding NearbyPeers}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.CanContentScroll="False"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFAFBFD"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14,11">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Border Background="#FFFFF3CD"
                                                            BorderBrush="#FFF59E0B"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="7,2"
                                                            Margin="8,0,0,0"
                                                            ToolTip="{Binding UpdateTooltip}"
                                                            Visibility="{Binding RequiresUpdate, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFB45309" />
                                                    </Border>
                                                    <Border Background="#FFE0F2FE"
                                                            CornerRadius="7"
                                                            Padding="7,2"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding IsMusicActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="🎵 음악 반응 중" FontSize="11" FontWeight="SemiBold" Foreground="#FF0369A1" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubInfo}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button DockPanel.Dock="Right"
                                                    Content="친구 신청"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.SendFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanSendFriendRequest}"
                                                    Padding="14,7"
                                                    VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 미등록 주변 펫 0명일 때 Empty State -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NearbyPeers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📡" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="새로 추가할 주변 LabPet을 찾고 있어요" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="이미 친구인 펫은 '친구 &amp; 노래 따라하기' 탭에 표시됩니다." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
