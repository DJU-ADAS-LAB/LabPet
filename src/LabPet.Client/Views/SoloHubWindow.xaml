<Window x:Class="LabPet.Client.Views.SoloHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabPet · 성장 · 뽀모도로 · 코인 게임"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource SoftCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Padding="22,0,14,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrandPinkBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="성장 · 뽀모도로 · 코인 게임" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" />
                </DockPanel>
            </Border>

            <!-- 상단 그라데이션 프로필 카드 -->
            <Border Grid.Row="1"
                    Background="{StaticResource SoftHeaderGradientBrush}"
                    BorderBrush="{StaticResource BrandPinkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,13"
                    Margin="20,2,20,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PetName}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="{StaticResource BrandPinkSoftBrush}" CornerRadius="9" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource BrandPinkBrush}" FontWeight="Bold" FontSize="12">
                                <Run Text="Lv." /><Run Text="{Binding Level, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Background="#FFFFF7DB" BorderBrush="#FFFDE68A" BorderThickness="1" CornerRadius="10" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Foreground="#FFB45309" FontWeight="Bold" FontSize="13">
                            <Run Text="코인 " /><Run Text="{Binding Coins, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 3개 탭 영역 -->
            <TabControl Grid.Row="2" Margin="20,0,20,20" SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
                <TabItem Header="성장 &amp; 오디오">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,8,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="경험치 (XP)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding Xp, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding RequiredXp, Mode=OneWay}" /><Run Text=" XP" />
                                </TextBlock>
                            </DockPanel>
                            <ProgressBar Height="12" Margin="0,0,0,16" Maximum="100" Value="{Binding XpPercent}" />

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Background="#FFFAFBFD" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="키보드 입력" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalKeystrokes}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFAFBFD" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="마우스 클릭" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalMouseClicks}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFAFBFD" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="함께한 시간(분)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalUptimeMinutes}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFAFBFD" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="완료 뽀모도로" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding CompletedPomodoros}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="#FFFAFBFD" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="시스템 오디오 반응 (WASAPI 루프백)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding AudioStatusText}" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" />
                                    </DockPanel>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10">
                                        <Run Text="활성 재생 장치: " /><Run Text="{Binding AudioDeviceName, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Text="저음 (Bass)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ProgressBar Height="9" Margin="0,3,0,8" Maximum="100" Value="{Binding BassPercent}" Foreground="#FFFF5D8F" />

                                    <TextBlock Text="중음 (Mid)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ProgressBar Height="9" Margin="0,3,0,8" Maximum="100" Value="{Binding MidPercent}" Foreground="#FF60A5FA" />

                                    <TextBlock Text="고음 (Treble)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ProgressBar Height="9" Margin="0,3,0,0" Maximum="100" Value="{Binding TreblePercent}" Foreground="#FFA78BFA" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="뽀모도로 타이머">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                        <!-- 원형 링 프로그레스 타이머 -->
                        <Grid Width="196" Height="196" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Stroke="#FFEEF1F7" StrokeThickness="10" />
                            <Ellipse Stroke="{StaticResource BrandGradientBrush}"
                                     StrokeThickness="10"
                                     StrokeStartLineCap="Round"
                                     StrokeEndLineCap="Round"
                                     StrokeDashArray="56.55 56.55"
                                     StrokeDashOffset="{Binding PomodoroRingDashOffset}"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Background="{StaticResource BrandPinkSoftBrush}" CornerRadius="9" Padding="10,3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PomodoroPhaseText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" />
                                </Border>
                                <TextBlock Text="{Binding PomodoroTimeText}"
                                           HorizontalAlignment="Center"
                                           FontSize="46"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Button Content="15분" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="15" Margin="0,0,8,0" />
                            <Button Content="25분 (기본)" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="25" Margin="0,0,8,0" />
                            <Button Content="50분" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="50" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Button Content="{Binding PomodoroToggleText}"
                                    Command="{Binding TogglePomodoroCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="136"
                                    Height="42"
                                    Margin="0,0,10,0" />
                            <Button Content="초기화"
                                    Command="{Binding ResetPomodoroCommand}"
                                    Width="96"
                                    Height="42" />
                        </StackPanel>

                        <TextBlock Text="집중 세션 완료 시 보너스 +100 XP · +50 코인이 지급됩니다."
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="🎮 코인 게임">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 친구 게임 초대 수신 배너 -->
                        <Border Grid.Row="0"
                                Visibility="{Binding Games.HasIncomingInvite, Converter={StaticResource BoolToVis}}"
                                Background="#FFFFF1F5"
                                BorderBrush="#FFFF8EB2"
                                BorderThickness="1.2"
                                CornerRadius="12"
                                Padding="12,8"
                                Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding Games.IncomingInviteText}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#FFE11D48"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="수락"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding Games.AcceptIncomingInviteCommand}"
                                            Padding="12,4"
                                            FontSize="11.5"
                                            Margin="0,0,6,0" />
                                    <Button Content="거절"
                                            Command="{Binding Games.DeclineIncomingInviteCommand}"
                                            Padding="10,4"
                                            FontSize="11.5" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 4종 코인 미니게임 서브 탭 -->
                        <TabControl Grid.Row="1" SelectedIndex="{Binding Games.SelectedGameIndex, Mode=TwoWay}">
                            <!-- 1. 코인 하이로우 (솔로) -->
                            <TabItem Header="🃏 하이로우">
                                <Grid Margin="4,6,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="배팅 코인" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding Games.WagerOptions}"
                                                      SelectedItem="{Binding Games.HiLowWager}"
                                                      Width="78"
                                                      Height="30" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#FFFFEEF4" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Games.HiLowStreakText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" />
                                            </Border>
                                            <Border Background="#FFEEF2FF" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Games.HiLowMultiplierText}" FontSize="11.5" FontWeight="Bold" Foreground="#FF4F46E5" />
                                            </Border>
                                            <Border Background="#FFFFF7DB" CornerRadius="8" Padding="9,4">
                                                <TextBlock Text="{Binding Games.HiLowPotentialPayoutText}" FontSize="11.5" FontWeight="Bold" Foreground="#FFB45309" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Grid.Row="1"
                                            Background="#FFFAFBFD"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="14,10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Background="#FFF1F5F9"
                                                    CornerRadius="8"
                                                    Padding="10,3"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8">
                                                <TextBlock Text="카드 숫자 범위: 1 (A) ~ 13 (K) · 같은 숫자는 무승부"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF475569" />
                                            </Border>
                                            <Border MinWidth="156"
                                                    Height="96"
                                                    Padding="16,6"
                                                    CornerRadius="16"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BrandPinkBorderBrush}"
                                                    BorderThickness="2"
                                                    Effect="{StaticResource SoftCardShadow}"
                                                    HorizontalAlignment="Center">
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Games.HiLowCardDisplay}"
                                                               FontSize="30"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Text="{Binding Games.HiLowStatusMessage}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <Button Content="게임 시작"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding Games.StartHiLowCommand}"
                                                Width="112"
                                                Height="38"
                                                Margin="0,0,8,0" />
                                        <Button Content="▲ 높다 (UP)"
                                                Command="{Binding Games.GuessHigherCommand}"
                                                IsEnabled="{Binding Games.IsHiLowActive}"
                                                Width="116"
                                                Height="38"
                                                Margin="0,0,8,0" />
                                        <Button Content="▼ 낮다 (DOWN)"
                                                Command="{Binding Games.GuessLowerCommand}"
                                                IsEnabled="{Binding Games.IsHiLowActive}"
                                                Width="122"
                                                Height="38"
                                                Margin="0,0,8,0" />
                                        <Button Content="💰 지금 정산"
                                                Command="{Binding Games.CashOutHiLowCommand}"
                                                IsEnabled="{Binding Games.CanCashOutHiLow}"
                                                Width="116"
                                                Height="38" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- 2. 친구 LAN 가위바위보 배틀 -->
                            <TabItem Header="✊ 가위바위보">
                                <Grid Margin="4,6,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="상대 친구" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding Games.OnlineFriends}"
                                                      SelectedItem="{Binding Games.SelectedRpsFriend}"
                                                      Width="180"
                                                      Height="30"
                                                      Margin="0,0,12,0" />
                                            <TextBlock Text="배팅" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding Games.WagerOptions}"
                                                      SelectedItem="{Binding Games.RpsWager}"
                                                      Width="76"
                                                      Height="30" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="{Binding Games.RpsInviteButtonText}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding Games.SendRpsInviteCommand}"
                                                IsEnabled="{Binding Games.HasOnlineFriends}"
                                                Padding="14,6"
                                                Height="32" />
                                    </DockPanel>

                                    <Border Grid.Row="1"
                                            Background="#FFFAFBFD"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16">
                                        <StackPanel VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="나" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Games.RpsMyMoveText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="VS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="친구" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Games.RpsOpponentMoveText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Games.RpsStatusText}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <Button Content="✊ 바위"
                                                Command="{Binding Games.ChooseRpsMoveCommand}"
                                                CommandParameter="rock"
                                                IsEnabled="{Binding Games.CanChooseRpsMove}"
                                                Width="120"
                                                Height="40"
                                                FontSize="13.5"
                                                Margin="0,0,10,0" />
                                        <Button Content="✌️ 가위"
                                                Command="{Binding Games.ChooseRpsMoveCommand}"
                                                CommandParameter="scissors"
                                                IsEnabled="{Binding Games.CanChooseRpsMove}"
                                                Width="120"
                                                Height="40"
                                                FontSize="13.5"
                                                Margin="0,0,10,0" />
                                        <Button Content="🖐 보"
                                                Command="{Binding Games.ChooseRpsMoveCommand}"
                                                CommandParameter="paper"
                                                IsEnabled="{Binding Games.CanChooseRpsMove}"
                                                Width="120"
                                                Height="40"
                                                FontSize="13.5" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- 3. 친구 LAN 타이핑 스프린트 (10초) -->
                            <TabItem Header="⌨️ 타이핑 대결">
                                <Grid Margin="4,6,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="상대 친구" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding Games.OnlineFriends}"
                                                      SelectedItem="{Binding Games.SelectedTypingFriend}"
                                                      Width="165"
                                                      Height="30"
                                                      Margin="0,0,10,0" />
                                            <TextBlock Text="배팅" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding Games.WagerOptions}"
                                                      SelectedItem="{Binding Games.TypingWager}"
                                                      Width="72"
                                                      Height="30" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="혼자 연습"
                                                    Command="{Binding Games.StartSoloTypingPracticeCommand}"
                                                    Padding="11,5"
                                                    Height="32"
                                                    Margin="0,0,6,0" />
                                            <Button Content="{Binding Games.TypingInviteButtonText}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Games.SendTypingInviteCommand}"
                                                    IsEnabled="{Binding Games.HasOnlineFriends}"
                                                    Padding="14,5"
                                                    Height="32" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Grid.Row="1"
                                            Background="#FFFAFBFD"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16">
                                        <StackPanel VerticalAlignment="Center">
                                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="내 점수" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Games.TypingMyScore}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FFFFEEF4" BorderBrush="{StaticResource BrandPinkBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="남은 시간" FontSize="11" Foreground="{StaticResource BrandPinkBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Games.TypingTimeLeftText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="상대 점수" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Games.TypingOpponentScore}" FontSize="22" FontWeight="Bold" Foreground="#FF4F46E5" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <Border Background="White" BorderBrush="{StaticResource BrandPinkBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Games.TypingPromptText}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextAlignment="Center" />
                                            </Border>

                                            <TextBox x:Name="TypingInputBox"
                                                     Text="{Binding Games.TypingInputText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding Games.IsTypingRunning}"
                                                     Height="38"
                                                     FontSize="14"
                                                     Padding="10,6" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Games.TypingStatusText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextAlignment="Center"
                                               Margin="0,10,0,0" />
                                </Grid>
                            </TabItem>

                            <!-- 4. 연구실 공동 사다리타기 -->
                            <TabItem Header="🪜 연구실 사다리">
                                <Grid Margin="4,6,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,3" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="참여자 (혼자 돌릴 때, 2~8명)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="친구 불러오기" Command="{Binding Games.LoadOnlineFriendsToLadderCommand}" Padding="7,2" FontSize="10.5" Height="22" />
                                            </DockPanel>
                                            <TextBox Text="{Binding Games.LadderParticipantsText, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,3" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="결과 항목 (자동 셔플)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="☕ 커피" Command="{Binding Games.ApplyCoffeePresetCommand}" Padding="6,2" FontSize="10.5" Height="22" Margin="0,0,4,0" />
                                                    <Button Content="💰 잭팟" Command="{Binding Games.ApplyCoinJackpotPresetCommand}" Padding="6,2" FontSize="10.5" Height="22" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBox Text="{Binding Games.LadderPrizesText, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- LAN 공동 사다리방 대기실: 전원 입장 후 원하는 시작 번호를 고르면 동시 시작 -->
                                    <Border Grid.Row="1"
                                            Visibility="{Binding Games.IsLadderRoomOpen, Converter={StaticResource BoolToVis}}"
                                            Background="#FFFFF5F8"
                                            BorderBrush="#FFFFB3C9"
                                            BorderThickness="1.2"
                                            CornerRadius="12"
                                            Padding="10,7"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding Games.LadderLobbySummaryText}"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FFE11D48"
                                                           VerticalAlignment="Center" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="▶ 지금 인원으로 시작"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding Games.ForceStartLadderRoomCommand}"
                                                            IsEnabled="{Binding Games.CanForceStartLadderRoom}"
                                                            Visibility="{Binding Games.IsLadderHost, Converter={StaticResource BoolToVis}}"
                                                            Padding="9,3"
                                                            FontSize="10.5"
                                                            Height="24"
                                                            Margin="0,0,5,0" />
                                                    <Button Content="취소"
                                                            Command="{Binding Games.CancelLadderRoomCommand}"
                                                            Padding="8,3"
                                                            FontSize="10.5"
                                                            Height="24" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Games.LadderSlots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.Games.PickLadderSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ColumnIndex}"
                                                                IsEnabled="{Binding CanPick}"
                                                                Margin="2,0"
                                                                Padding="4,4"
                                                                Height="40">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding OccupantText}" FontSize="9.5" Foreground="#FF6B7280" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                                            <Canvas x:Name="LadderCanvas" ClipToBounds="True" />
                                        </Border>
                                        <Border Grid.Column="2" Background="#FFFAFBFD" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="10">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="사다리 결과" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Games.LadderResultLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White" BorderBrush="#FFEEF1F7" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="참가 코인" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <ComboBox ItemsSource="{Binding Games.LadderFeeOptions}" SelectedItem="{Binding Games.LadderEntryFee}" Width="60" Height="28" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Games.LadderStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPinkBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="📢 공유" Command="{Binding Games.ShareLadderResultToFriendsCommand}" Padding="8,4" FontSize="11" Height="30" Margin="0,0,5,0" />
                                            <Button Content="혼자 돌리기" Command="{Binding Games.RunLadderCommand}" Padding="9,4" FontSize="11" Height="30" Margin="0,0,5,0" />
                                            <Button Content="🪜 친구 초대 방 열기"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Games.OpenLadderRoomCommand}"
                                                    IsEnabled="{Binding Games.HasOnlineFriends}"
                                                    Padding="12,4"
                                                    FontSize="11.5"
                                                    Height="30" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
