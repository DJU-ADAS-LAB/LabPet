<Window x:Class="LabPet.Client.Views.SoloHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:games="clr-namespace:LabPet.Client.Views.Games"
        xmlns:vm="clr-namespace:LabPet.Client.ViewModels"
        Title="LabPet 허브"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="920"
        Height="660"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <games:EnumEqualsConverter x:Key="EnumEquals" />
        <games:EnumToVisibilityConverter x:Key="EnumToVis" />
        <games:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <Border x:Name="OuterShellBorder"
                Margin="12"
                Background="{StaticResource GameBgBrush}"
                BorderBrush="{StaticResource GameDividerBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Effect="{StaticResource SoftCardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 상단 헤더: 펫 프로필 + 세그먼트 내비게이션(단일 계층) + 코인 + 창 제어 -->
                <Border Grid.Row="0"
                        Background="{StaticResource GameCardBrush}"
                        BorderBrush="{StaticResource GameDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="22,22,0,0"
                        Padding="18,0,14,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 왼쪽: 펫 이름 & 레벨 배지 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GamePinkSoftBrush}" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconSparklesGeometry}"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource GamePinkBrush}"
                                      StrokeThickness="1.8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding PetName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GameTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="8" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}">
                                    <Run Text="Lv." /><Run Text="{Binding Level, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- 중앙: 세그먼트 내비게이션 -->
                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource GameSubtleFillBrush}"
                                CornerRadius="12"
                                Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="성장 &amp; 오디오"
                                             Style="{StaticResource GameSegmentRadioStyle}"
                                             GroupName="HubSectionGroup"
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEquals}, ConverterParameter=GrowthAudio}"
                                             Padding="14,6" />
                                <RadioButton Content="뽀모도로"
                                             Style="{StaticResource GameSegmentRadioStyle}"
                                             GroupName="HubSectionGroup"
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEquals}, ConverterParameter=Pomodoro}"
                                             Padding="14,6" />
                                <RadioButton Content="게임"
                                             Style="{StaticResource GameSegmentRadioStyle}"
                                             GroupName="HubSectionGroup"
                                             IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEquals}, ConverterParameter=Games}"
                                             Padding="16,6" />
                            </StackPanel>
                        </Border>

                        <!-- 오른쪽: 보유 코인 + 최소화 / 최대화 / 닫기 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource GameCoinSoftBrush}"
                                    BorderBrush="{StaticResource GameCoinBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,5"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCoinGeometry}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource GameCoinBrush}"
                                          StrokeThickness="2"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource GameCoinBrush}" VerticalAlignment="Center">
                                        <Run Text="{Binding Coins, Mode=OneWay}" /><Run Text=" 코인" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource GameWindowTitleButtonStyle}" Click="MinimizeButton_Click" ToolTip="최소화" Margin="0,0,2,0">
                                <Path Data="{StaticResource IconMinimizeGeometry}" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                            </Button>
                            <Button Style="{StaticResource GameWindowTitleButtonStyle}" Click="MaximizeRestoreButton_Click" ToolTip="최대화 / 복원" Margin="0,0,2,0">
                                <Path Data="{StaticResource IconMaximizeGeometry}" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                            </Button>
                            <Button Style="{StaticResource GameWindowTitleButtonStyle}" Click="CloseButton_Click" ToolTip="닫기">
                                <Path Data="{StaticResource IconCloseGeometry}" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 상단 슬림 초대 배너 (창이 열린 상태에서 현재 작업/게임 화면을 유지한 채 표시) -->
                <StackPanel Grid.Row="1">
                    <Border Visibility="{Binding Games.HasIncomingInvite, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource GamePinkSoftBrush}"
                            BorderBrush="{StaticResource GamePinkBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,9">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="9" Background="White" Margin="0,0,10,0">
                                    <Image Source="{Binding Games.IncomingInvitePortrait}" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Games.IncomingInviteText}"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GameTextPrimaryBrush}" />
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GamePinkBrush}">
                                        <Run Text="{Binding Games.IncomingInvite.CostBadgeText, Mode=OneWay, FallbackValue=''}" />
                                        <Run Text=" · 남은 시간 " />
                                        <Run Text="{Binding Games.IncomingInviteRemainingSeconds, Mode=OneWay}" />
                                        <Run Text="초" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GameSecondaryButtonStyle}"
                                        Command="{Binding Games.DeclineIncomingInviteCommand}"
                                        IsEnabled="{Binding Games.CanRespondToIncomingInvite}"
                                        Content="거절"
                                        Padding="12,6"
                                        Margin="0,0,6,0" />
                                <Button Command="{Binding Games.AcceptIncomingInviteCommand}"
                                        IsEnabled="{Binding Games.CanRespondToIncomingInvite}"
                                        Padding="14,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GamePrimaryButtonStyle}">
                                            <Setter Property="Content" Value="수락하고 입장" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Games.IsAcceptingIncomingInvite}" Value="True">
                                                    <Setter Property="Content" Value="수락 중..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Visibility="{Binding Games.IncomingInviteFeedbackMessage, Converter={StaticResource NullToVis}}"
                            Background="{StaticResource GameSubtleFillBrush}"
                            Padding="18,6">
                        <TextBlock Text="{Binding Games.IncomingInviteFeedbackMessage}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GameTextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 본문: 선택된 단일 섹션만 표시 -->
                <Grid Grid.Row="2" Margin="18,16,18,18">
                    <!-- 1) 성장 & 오디오 -->
                    <ScrollViewer Visibility="{Binding ActiveSection, Converter={StaticResource EnumToVis}, ConverterParameter=GrowthAudio}"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False">
                        <StackPanel>
                            <Border Background="{StaticResource GameCardBrush}"
                                    BorderBrush="{StaticResource GameDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20,18"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="경험치 (XP)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GameTextSecondaryBrush}">
                                            <Run Text="{Binding Xp, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding RequiredXp, Mode=OneWay}" /><Run Text=" XP" />
                                        </TextBlock>
                                    </DockPanel>
                                    <ProgressBar Height="10" Maximum="100" Value="{Binding XpPercent}" Foreground="{StaticResource GamePinkBrush}" Background="{StaticResource GameSubtleFillBrush}" />

                                    <UniformGrid Columns="4" Margin="0,16,0,0">
                                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="13" Padding="14,12" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="키보드 입력" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding TotalKeystrokes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="13" Padding="14,12" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="마우스 클릭" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding TotalMouseClicks}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="13" Padding="14,12" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="함께한 시간(분)" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding TotalUptimeMinutes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource GameSubtleFillBrush}" CornerRadius="13" Padding="14,12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="완료 뽀모도로" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding CompletedPomodoros}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GameTextPrimaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource GameCardBrush}"
                                    BorderBrush="{StaticResource GameDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20,18">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="시스템 오디오 반응 (WASAPI 루프백)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GameTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding AudioStatusText}" DockPanel.Dock="Right" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                                    </DockPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource GameTextSecondaryBrush}" Margin="0,0,0,14">
                                        <Run Text="활성 재생 장치: " /><Run Text="{Binding AudioDeviceName, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Text="저음 (Bass)" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                    <ProgressBar Height="8" Margin="0,4,0,10" Maximum="100" Value="{Binding BassPercent}" Foreground="{StaticResource GamePinkBrush}" Background="{StaticResource GameSubtleFillBrush}" />

                                    <TextBlock Text="중음 (Mid)" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                    <ProgressBar Height="8" Margin="0,4,0,10" Maximum="100" Value="{Binding MidPercent}" Foreground="#FF60A5FA" Background="{StaticResource GameSubtleFillBrush}" />

                                    <TextBlock Text="고음 (Treble)" FontSize="11.5" Foreground="{StaticResource GameTextSecondaryBrush}" />
                                    <ProgressBar Height="8" Margin="0,4,0,0" Maximum="100" Value="{Binding TreblePercent}" Foreground="#FFA78BFA" Background="{StaticResource GameSubtleFillBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2) 뽀모도로 타이머 -->
                    <Border Visibility="{Binding ActiveSection, Converter={StaticResource EnumToVis}, ConverterParameter=Pomodoro}"
                            Background="{StaticResource GameCardBrush}"
                            BorderBrush="{StaticResource GameDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                            <Grid Width="212" Height="212" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Ellipse Stroke="{StaticResource GameSubtleFillBrush}" StrokeThickness="10" />
                                <Ellipse Stroke="{StaticResource GamePinkBrush}"
                                         StrokeThickness="10"
                                         StrokeStartLineCap="Round"
                                         StrokeEndLineCap="Round"
                                         StrokeDashArray="56.55 56.55"
                                         StrokeDashOffset="{Binding PomodoroRingDashOffset}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="{StaticResource GamePinkSoftBrush}" CornerRadius="9" Padding="11,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PomodoroPhaseText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GamePinkBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding PomodoroTimeText}"
                                               HorizontalAlignment="Center"
                                               FontSize="48"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GameTextPrimaryBrush}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="15분" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="15" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="25분 (기본)" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="25" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GameSecondaryButtonStyle}" Content="50분" Command="{Binding SetPomodoroPresetCommand}" CommandParameter="50" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Button Content="{Binding PomodoroToggleText}"
                                        Command="{Binding TogglePomodoroCommand}"
                                        Style="{StaticResource GamePrimaryButtonStyle}"
                                        Width="148"
                                        Height="44"
                                        Margin="0,0,10,0" />
                                <Button Content="초기화"
                                        Style="{StaticResource GameSecondaryButtonStyle}"
                                        Command="{Binding ResetPomodoroCommand}"
                                        Width="104"
                                        Height="44" />
                            </StackPanel>

                            <TextBlock Text="집중 세션 완료 시 보너스 +100 XP · +50 코인이 지급됩니다."
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource GameTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 3) 게임 허브 (카드 대시보드 + 단일 게임 전용 화면) -->
                    <games:GamesHubView Visibility="{Binding ActiveSection, Converter={StaticResource EnumToVis}, ConverterParameter=Games}"
                                        DataContext="{Binding Games}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 투명 창 리사이즈용 8방향 Thumb -->
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="7" Cursor="SizeWE" Opacity="0" Tag="Left" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="7" Cursor="SizeWE" Opacity="0" Tag="Right" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="7" Cursor="SizeNS" Opacity="0" Tag="Top" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="7" Cursor="SizeNS" Opacity="0" Tag="Bottom" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" Cursor="SizeNWSE" Opacity="0" Tag="TopLeft" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" Cursor="SizeNESW" Opacity="0" Tag="TopRight" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="SizeNESW" Opacity="0" Tag="BottomLeft" DragDelta="ResizeThumb_DragDelta" />
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="SizeNWSE" Opacity="0" Tag="BottomRight" DragDelta="ResizeThumb_DragDelta" />
    </Grid>
</Window>
