<Window x:Class="LabPet.Client.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabPet · 새 버전 업데이트"
        Style="{StaticResource ModernDialogWindowStyle}"
        Width="420"
        Height="236"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Margin="14"
            Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BrandPinkBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="20"
            Effect="{StaticResource SoftCardShadow}">
        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 상단 헤더 -->
            <DockPanel Grid.Row="0" LastChildFill="False" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrandPinkSoftBrush}" CornerRadius="9" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="✨ NEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandPinkBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleVersionText"
                               Text="새 버전 업데이트"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Click="LaterButton_Click" />
            </DockPanel>

            <!-- 안내 본문 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,12">
                <TextBlock x:Name="MessageBodyText"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="펫 프로필과 친구 데이터는 안전하게 그대로 유지됩니다."
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 하단 버튼 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="나중에"
                        Click="LaterButton_Click"
                        Width="88"
                        Height="38"
                        Margin="0,0,8,0" />
                <Button Content="지금 업데이트"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="UpdateNowButton_Click"
                        Width="128"
                        Height="38" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
