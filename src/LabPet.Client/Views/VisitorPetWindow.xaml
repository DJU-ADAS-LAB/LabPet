<Window x:Class="LabPet.Client.Views.VisitorPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LabPet.Client.Views"
        Title="LabPet · 놀러 온 친구"
        Width="214"
        Height="252"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="VisitorDismissButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#EBFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD8DEE9" />
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Effect="{StaticResource SoftCardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFF5D8F" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFF43F78" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="VisitorNameplateRow" Height="28" />
        </Grid.RowDefinitions>

        <!-- 방문 펫 상단 꼬리 말풍선 전용 Popup (창 크기를 바꾸지 않아 말풍선 높이 변화로 펫이 튀지 않음) -->
        <Popup x:Name="VisitorBubblePopup"
               PlacementTarget="{Binding ElementName=VisitorViewport}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None"
               IsOpen="False">
            <Border Padding="10,10,10,4" IsHitTestVisible="False">
            <StackPanel x:Name="VisitorBubbleContent"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        SizeChanged="VisitorBubbleContent_SizeChanged">
                <!-- 친구 채팅 메시지 스택 (최대 5개, 오래된 순 위 → 최신 아래, 개별 만료) -->
                <ItemsControl x:Name="VisitorChatItemsControl"
                              Visibility="Collapsed"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4"
                                    Padding="10,5"
                                    CornerRadius="12"
                                    Background="#FFFFFAFC"
                                    BorderBrush="#FFF1BCD3"
                                    BorderThickness="1.2"
                                    HorizontalAlignment="Center"
                                    Effect="{StaticResource SoftCardShadow}">
                                <TextBlock Text="{Binding Text}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="#FF2E3440"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap"
                                           MaxWidth="196" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 쓰다듬기·노래 따라하기 등 시스템 알림 (채팅 메시지와 별도 표시되어 서로 덮어쓰지 않음) -->
                <Border x:Name="VisitorStatusBubble"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,2"
                        Padding="9,4"
                        CornerRadius="11"
                        Background="#F5FFFFFF"
                        BorderBrush="#FFFFC2D4"
                        BorderThickness="1.2"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Effect="{StaticResource SoftCardShadow}">
                    <TextBlock x:Name="VisitorStatusBubbleText"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#FF2E3440"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="196" />
                </Border>

                <!-- 말풍선 하단 꼬리 -->
                <Polygon x:Name="VisitorBubbleTail"
                         Points="0,0 10,0 5,6"
                         Fill="#FFFFFAFC"
                         Stroke="#FFF1BCD3"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         Margin="0,-2,0,0">
                    <Polygon.RenderTransform>
                        <TranslateTransform x:Name="VisitorBubbleTailOffset" />
                    </Polygon.RenderTransform>
                </Polygon>
            </StackPanel>
            </Border>
        </Popup>

        <!-- 방문 펫 클릭 시 표시되는 빠른 채팅 입력 팝업 (메시지 말풍선과 분리되어 서로 겹치지 않음) -->
        <Popup x:Name="VisitorChatComposerPopup"
               PlacementTarget="{Binding ElementName=VisitorViewport}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None"
               IsOpen="False">
            <Border x:Name="VisitorChatComposerCard"
                    Width="226"
                    Margin="8"
                    Padding="8,6"
                    CornerRadius="12"
                    Background="#F7FFFFFF"
                    BorderBrush="#FFDDE3EE"
                    BorderThickness="1"
                    Effect="{StaticResource SoftCardShadow}"
                    MouseEnter="VisitorChatComposerCard_MouseEnter"
                    MouseLeave="VisitorChatComposerCard_MouseLeave"
                    LostMouseCapture="VisitorChatComposerCard_MouseLeave"
                    LostKeyboardFocus="VisitorChatComposerCard_LostKeyboardFocus"
                    SizeChanged="VisitorChatComposerCard_SizeChanged">
                <DockPanel Background="Transparent">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            ToolTip="닫기"
                            Focusable="False"
                            Width="22"
                            Height="28"
                            Padding="0"
                            FontSize="10.5"
                            Margin="4,0,0,0"
                            Click="CloseVisitorChatButton_Click" />
                    <Button x:Name="SendVisitorChatButton"
                            DockPanel.Dock="Right"
                            Content="전송"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Focusable="False"
                            Padding="9,4"
                            FontSize="11"
                            Height="28"
                            Margin="5,0,0,0"
                            Click="SendVisitorChatButton_Click" />
                    <TextBox x:Name="VisitorChatInput"
                             MaxLength="100"
                             Height="28"
                             FontSize="11.5"
                             Padding="7,3"
                             TextChanged="VisitorChatInput_TextChanged"
                             PreviewMouseDown="VisitorChatInput_PreviewMouseDown"
                             KeyDown="VisitorChatInput_KeyDown" />
                </DockPanel>
            </Border>
        </Popup>

        <!-- 친구 3D 펫 뷰포트 (내 펫과 동일한 뷰포트 크기·카메라 투영 유지) -->
        <Viewport3D x:Name="VisitorViewport"
                    Grid.Row="0"
                    Width="214"
                    Height="224"
                    HorizontalAlignment="Center"
                    ClipToBounds="False"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    MouseEnter="VisitorSurface_MouseEnter"
                    MouseLeave="VisitorSurface_MouseLeave"
                    MouseLeftButtonDown="VisitorViewport_MouseLeftButtonDown"
                    MouseMove="VisitorViewport_MouseMove"
                    MouseLeftButtonUp="VisitorViewport_MouseLeftButtonUp">
            <Viewport3D.CacheMode>
                <BitmapCache RenderAtScale="1.5" />
            </Viewport3D.CacheMode>
            <Viewport3D.ContextMenu>
                <ContextMenu Opened="VisitorContextMenu_Opened">
                    <MenuItem Header="👋  쓰다듬기 보내기" Click="PetFriendMenu_Click" />
                    <MenuItem x:Name="MusicFollowMenuItem" Header="🎵  노래 따라하기" Click="ToggleMusicFollowMenu_Click" />
                    <Separator />
                    <MenuItem Header="✕  친구 돌려보내기" Click="DismissMenu_Click" />
                </ContextMenu>
            </Viewport3D.ContextMenu>

            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0.30,6.65"
                                   LookDirection="0,-0.02,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="36" />
            </Viewport3D.Camera>

            <ModelVisual3D x:Name="LightsVisual" />
            <ModelVisual3D x:Name="VisitorPetVisual" />
        </Viewport3D>

        <!-- 내 펫과 같은 우상단 수면 방울을 뷰포트 배율에 맞춰 배치한다. -->
        <Viewbox x:Name="VisitorSleepBadge" Grid.Row="0" Width="{Binding Width, ElementName=VisitorViewport}"
                 HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                 Visibility="Collapsed">
            <Grid Width="214" Height="90">
                <views:SleepZzzOverlay Style="{StaticResource PetSleepBadgeStyle}" />
            </Grid>
        </Viewbox>

        <!-- 마우스 오버레이 시 우측 상단에 나타나는 돌려보내기(✕) 버튼 -->
        <Button x:Name="DismissButton"
                Grid.Row="0"
                Content="✕"
                ToolTip="친구 돌려보내기"
                Style="{StaticResource VisitorDismissButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,8,0"
                Opacity="0"
                IsHitTestVisible="False"
                MouseEnter="VisitorSurface_MouseEnter"
                MouseLeave="VisitorSurface_MouseLeave"
                Click="DismissMenu_Click" />

        <!-- 하단 글래스 이름표 (내 펫과 동일 위치·스타일) -->
        <Border x:Name="VisitorNameplate"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="10,2"
                CornerRadius="10"
                Background="#DCFFFFFF"
                BorderBrush="#FFE8ECF4"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="VisitorNameplateOffset" />
            </Border.RenderTransform>
            <TextBlock x:Name="VisitorNameText"
                       FontSize="10.5"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#FF4B5563" />
        </Border>
    </Grid>
</Window>
