<Window x:Class="LabPet.Client.Views.VisitorPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabPet · 놀러 온 친구"
        Width="176"
        Height="226"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="VisitorDismissButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#EBFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD8DEE9" />
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Effect="{StaticResource SoftCardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFF5D8F" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFF43F78" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- 상단 미니 말풍선 -->
        <Border x:Name="VisitorBubble"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Padding="9,4"
                CornerRadius="11"
                Background="#F5FFFFFF"
                BorderBrush="#FFFFC2D4"
                BorderThickness="1.2"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Effect="{StaticResource SoftCardShadow}">
            <TextBlock x:Name="VisitorBubbleText"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#FF2E3440"
                       TextAlignment="Center" />
        </Border>

        <!-- 친구 3D 펫 뷰포트 -->
        <Viewport3D x:Name="VisitorViewport"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    ClipToBounds="False"
                    MouseEnter="VisitorSurface_MouseEnter"
                    MouseLeave="VisitorSurface_MouseLeave"
                    MouseLeftButtonDown="VisitorViewport_MouseLeftButtonDown"
                    MouseMove="VisitorViewport_MouseMove"
                    MouseLeftButtonUp="VisitorViewport_MouseLeftButtonUp">
            <Viewport3D.ContextMenu>
                <ContextMenu Opened="VisitorContextMenu_Opened">
                    <MenuItem Header="👋  쓰다듬기 보내기" Click="PetFriendMenu_Click" />
                    <MenuItem x:Name="MusicFollowMenuItem" Header="🎵  노래 따라하기" Click="ToggleMusicFollowMenu_Click" />
                    <Separator />
                    <MenuItem Header="✕  친구 돌려보내기" Click="DismissMenu_Click" />
                </ContextMenu>
            </Viewport3D.ContextMenu>

            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0.34,6.15"
                                   LookDirection="0,-0.06,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="36" />
            </Viewport3D.Camera>

            <ModelVisual3D x:Name="LightsVisual" />
            <ModelVisual3D x:Name="VisitorPetVisual" />
        </Viewport3D>

        <!-- 마우스 오버레이 시 우측 상단에 나타나는 돌려보내기(✕) 버튼 -->
        <Button x:Name="DismissButton"
                Grid.Row="1"
                Content="✕"
                ToolTip="친구 돌려보내기"
                Style="{StaticResource VisitorDismissButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,8,0"
                Opacity="0"
                IsHitTestVisible="False"
                MouseEnter="VisitorSurface_MouseEnter"
                MouseLeave="VisitorSurface_MouseLeave"
                Click="DismissMenu_Click" />

        <!-- 하단 글래스 이름표 -->
        <Border x:Name="VisitorNameplate"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="9,2"
                CornerRadius="10"
                Background="#DCFFFFFF"
                BorderBrush="#FFE8ECF4"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="VisitorNameText"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#FF4B5563" />
        </Border>
    </Grid>
</Window>
