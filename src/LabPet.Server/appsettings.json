{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LabPetServer": {
    "ListenUrl": "http://127.0.0.1:5000",
    "MaxTotalConnections": 500,
    "MaxConnectionsPerPet": 2,
    "MaxControlPacketBytes": 16384,
    "ControlRateLimitPerSecond": 20,
    "MusicFrameRateLimitPerSecond": 18,
    "MaxSearchRequestsPerMinute": 20
  }
}
